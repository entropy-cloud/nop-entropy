<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <steps>
        <selector name="sel">
            <steps>
                <suspend name="wait" executor="myExecutor"/>
                <xpl name="fallback">
                    <source>return 'fallback'</source>
                </xpl>
            </steps>
        </selector>
    </steps>
    <output name="RESULT">
        <source>return RESULT</source>
    </output>
</task>
