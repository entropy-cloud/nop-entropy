<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <steps>
        <graph name="g" enterSteps="a" exitSteps="exit">
            <steps>
                <xpl name="a" next="wait">
                    <source>return 1</source>
                </xpl>
                <suspend name="wait" next="exit"/>
                <xpl name="exit">
                    <source>return 'graph-done'</source>
                </xpl>
            </steps>
        </graph>
    </steps>
    <output name="RESULT">
        <source>return RESULT</source>
    </output>
</task>
