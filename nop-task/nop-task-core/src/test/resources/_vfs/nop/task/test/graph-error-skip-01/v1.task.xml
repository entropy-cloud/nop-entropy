<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <steps>
        <graph name="g" enterSteps="x" exitSteps="exit">
            <steps>
                <xpl name="x" nextOnError="handler">
                    <source>return 1</source>
                </xpl>
                <xpl name="handler" next="exit">
                    <source>return 'handled'</source>
                </xpl>
                <xpl name="exit">
                    <input name="r">
                        <source>STEP_RESULTS.x.outputs.RESULT</source>
                    </input>
                    <source>return r</source>
                </xpl>
            </steps>
        </graph>
    </steps>
    <output name="RESULT">
        <source>return RESULT == 1 ? 'OK' : 'FAIL'</source>
    </output>
</task>
