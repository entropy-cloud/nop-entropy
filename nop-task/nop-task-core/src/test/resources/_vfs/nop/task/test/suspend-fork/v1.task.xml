<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <steps>
        <fork name="test" varName="data">
            <producer>return [1,2]</producer>
            <steps>
                <suspend name="wait"/>
            </steps>
        </fork>
        <xpl name="after">
            <source>return 'completed'</source>
        </xpl>
    </steps>
    <output name="RESULT">
        <source>return RESULT</source>
    </output>
</task>
