<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <!-- CRA 8.48 R4-08 W-04（MA-11 裁定 A）/C10-002 红④ 腿1：显式共享 keyExpr 递归嵌套——
         外层 sequential 持有 global key 'r408-k'，内层 entry 同 key 嵌套获取即重入硬失败 -->
    <steps>
        <sequential name="outer">
            <throttle global="true" maxConcurrency="2" maxWait="100" keyExpr="'r408-k'"/>
            <steps>
                <xpl name="inner">
                    <throttle global="true" maxConcurrency="2" maxWait="100" keyExpr="'r408-k'"/>
                    <source>
                        return "NESTED-OK";
                    </source>
                </xpl>
            </steps>
        </sequential>
    </steps>
    <output name="RESULT">
        <source>
            return RESULT
        </source>
    </output>
</task>
