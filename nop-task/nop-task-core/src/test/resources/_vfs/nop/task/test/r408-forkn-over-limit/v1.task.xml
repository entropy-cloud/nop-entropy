<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <!-- CRA 8.48 R4-08 W-10（MA-18 裁定 D）红⑩：forkN count 超上界运行期拒绝
         （测试经 AppConfig 动态通道将 nop.task.step.max-fork-count 设为 5） -->
    <steps>
        <fork-n name="test" countExpr="6">
            <steps>
                <xpl name="branchStep">
                    <source>
                        return "BRANCH";
                    </source>
                </xpl>
            </steps>
            <aggregator>
                return 'OK'
            </aggregator>
        </fork-n>
    </steps>
    <output name="RESULT">
        <source>
            return RESULT
        </source>
    </output>
</task>
