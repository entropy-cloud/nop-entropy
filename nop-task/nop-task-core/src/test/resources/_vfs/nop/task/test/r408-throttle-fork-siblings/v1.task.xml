<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <!-- CRA 8.48 R4-08 W-04（MA-11 裁定 A）/C10-002 红④ 合法并发兄弟腿：fork 两分支并发
         同 key 均成功获取——held 集分支隔离的结构性证明（重入检测不得误报合法并发） -->
    <steps>
        <fork-n name="test" countExpr="2">
            <steps>
                <xpl name="branchStep">
                    <throttle global="true" maxConcurrency="2" maxWait="2000" keyExpr="'r408-sib'"/>
                    <source>
                        return "BRANCH";
                    </source>
                </xpl>
            </steps>
            <aggregator>
                return aggResults.size() == 2 ? 'OK' : 'FAIL'
            </aggregator>
        </fork-n>
    </steps>
    <output name="RESULT">
        <source>
            return RESULT
        </source>
    </output>
</task>
