<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-tools</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-ib</artifactId>
    <name>42-nop-ib</name>

    <description>
        Incremental build engine for AI-assisted development: replaces the daily mvn build / mvn test
        feedback loop with nop-javac file compilation + bytecode dependency closure (compile) and
        module coarse filter + class graph fine selection (test). Cold path delegates to mvnw/PATH mvn
        (configurable via nop.ib.maven). Packaged as a shaded single-jar CLI (nop-cli parity, wave 11).
        Design authority: ai-dev/design/nop-incremental-build/05-nop-ib-engine-design.md;
        roadmap: ai-dev/backlog/nop-ib-roadmap.md.

        Adjudicated invariants (IB-G1/IB-G5): no -api module; no nop-code-service dependency; never on a
        release module's runtime classpath. Concurrency is controlled in-process (wave 11: no file lock).
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-javac</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-bytecode</artifactId>
        </dependency>

        <!-- platform reuse (analysis 2026-11-22-nop-ib-nop-git-platform-reuse):
             XNode/XNodeParser for effective-pom parsing, JsonTool for state documents -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- compile scope: the fork-side runner (io.nop.ib.junit.IbJUnitRunner) is
             compiled against the Launcher API; at test runtime the fork uses the
             module's own platform jars + the version-matched launcher jar -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-engine</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- single-jar CLI (nop-cli parity: uber-jar, java -jar directly) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <finalName>nop-ib</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.nop.ib.NopIbMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
