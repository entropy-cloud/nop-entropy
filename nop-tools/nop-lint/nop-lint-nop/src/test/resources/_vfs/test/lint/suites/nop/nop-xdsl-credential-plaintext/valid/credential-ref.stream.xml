<stream xmlns:x="/nop/schema/xdsl.xdef" x:schema="/nop/schema/stream/stream.xdef" name="cred-ok" version="1">
    <transforms>
        <source id="src" name="kafka-in" bean="kafkaSource">
            <params>
                <param name="password" defaultValue="credential:kafka-cred#password"/>
            </params>
        </source>
        <sink id="out" name="jdbc-out" bean="jdbcSink"/>
    </transforms>
    <edges>
        <edge id="e1" from="src" to="out"/>
    </edges>
</stream>
