<stream xmlns:x="/nop/schema/xdsl.xdef" x:schema="/nop/schema/stream/stream.xdef" name="naming-ok" version="1">
    <transforms>
        <source id="trade-source" name="kafka-trades" bean="srcBean"/>
        <map id="normalize" bean="normalizeFn">
            <source>return event;</source>
        </map>
        <sink id="alert-sink" name="alert-queue" bean="sinkBean"/>
    </transforms>
    <edges>
        <edge id="e1" from="trade-source" to="normalize"/>
        <edge id="e2" from="normalize" to="alert-sink"/>
    </edges>
</stream>
