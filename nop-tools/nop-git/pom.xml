<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-tools</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-git-parent</artifactId>
    <packaging>pom</packaging>
    <name>43-nop-git</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- nop-git 运行基线 JDK 21（design 00-vision §五）。根 pom 设 maven.compiler.release=25，
             maven-compiler-plugin 的 release 参数直接绑定该属性并压倒 source/target，必须在此覆写 release。 -->
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <!--
        nop-git 运行基线 JDK 21（JGit 7.x 要求 17+，模块启动校验 feature() >= 21）。
        子模块通过 JDK 激活 profile 挂入 reactor（同 nop-rg java22-modules 模式），
        JDK < 21 的构建环境自动跳过 nop-git 模块，不阻断全局构建。
    -->
    <profiles>
        <profile>
            <id>java21-modules</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <modules>
                <module>nop-git-bom</module>
                <module>nop-git-core</module>
                <module>nop-git-cli</module>
                <module>nop-git-server</module>
                <module>nop-git-ioc</module>
            </modules>
        </profile>
    </profiles>
</project>
