<c:script>
import io.nop.web.page.WebPageExporter;

const exporter = new WebPageExporter();
const options = {
   moduleId: moduleId,
   renderMode: $scope.containsValue("renderMode") ? renderMode : null,
   resolveI18n: true,
   useResolver: true
};

exporter.exportPages(options, outputDir);
</c:script>
