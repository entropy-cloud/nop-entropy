{
  "id": "save-btn",
  "label": "Save",
  "onClick": {
    "action": "ajax",
    "args": {
      "url": "/test/save",
      "method": "POST",
      "includeScope": "*"
    },
    "messages": {
      "success": "Saved",
      "failed": "Save failed"
    },
    "then": [
      {
        "action": "refreshNearest"
      }
    ]
  }
}