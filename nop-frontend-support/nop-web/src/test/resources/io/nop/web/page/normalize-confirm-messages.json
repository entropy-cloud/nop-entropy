{
  "id": "del-btn",
  "label": "Delete",
  "onClick": {
    "action": "ajax",
    "args": {
      "url": "/test/delete",
      "includeScope": "*"
    },
    "confirmText": "Are you sure?",
    "messages": {
      "success": "Deleted",
      "failed": "Delete failed"
    },
    "then": [
      {
        "action": "refreshNearest"
      }
    ]
  }
}