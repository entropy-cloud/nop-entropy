    <artifactId>nop-lint</artifactId>
    <packaging>pom</packaging>
    <name>35-nop-lint</name>

    <description>
        YAML-driven AST lint system on the pure-Java tree-sitter runtime (nop-treesitter).
        ast-grep-style source pattern matching, XLang xscript dynamic checks, and a
        Nop-specific rule library. Execution status is tracked in
        ai-dev/backlog/nop-lint-roadmap.md; design authority is ai-dev/design/nop-lint/.
    </description>

    <modules>
        <module>nop-lint-core</module>
        <module>nop-lint-java</module>
        <module>nop-lint-js</module>
        <module>nop-lint-nop</module>
        <module>nop-lint-maven-plugin</module>
        <module>nop-lint-graphql</module>
    </modules>
</project>
