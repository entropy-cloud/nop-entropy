<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rule DSL metamodel for lint rules.
  Design: ai-dev/design/nop-lint/10-xdef-metamodel.md section 2.
  Matcher uniqueness (rule container XOR, nested matcher XOR, any/all
  atLeastOne, stopBy/stopByRule/field pairing), the recursive composite
  surface (any/all/not/matches legal at every matcher-object position,
  roadmap item 24), and the util reference graph (unknown references and
  cycles rejected) are enforced at runtime by
  io.nop.lint.core.rule.RuleDslParser (fail-closed). The xdef:check-mutex
  declarations below record the same intent declaratively; the platform
  constraint validator inspects attribute values only, so the atLeastOne
  flag is deliberately left off to avoid false positives on element-form
  matchers. The two xdef:define fragments are mutually recursive (the same
  mechanism beans.xdef uses):

  - LintMatcherBody  — the flattened matcher surface (YAML map keys become
    child elements): the form of the rule container, of a util value, and of
    a 'not' inner.
  - LintMatcherUnit  — the object form <matcher> (YAML list items of
    any/all): flat attributes pattern/kind/regex plus the nested composite
    children. Structural YAML depth is finite; cycle detection over the
    reference graph is the parser's job.
-->
<lint-rule x:schema="/nop/schema/xdef.xdef" xmlns:x="/nop/schema/xdsl.xdef"
           xmlns:xdef="/nop/schema/xdef.xdef"
           xdef:name="LintRule"
           xdef:parser-class="io.nop.lint.core.rule.RuleDslParser"
           id="!string"
           language="enum:Java|TypeScript|TSX|XML"
           severity="enum:hint|info|warning|error|off"
           xscriptTimeoutMs="int=100">

    <xdef:check-mutex id="one-matcher" select="/lint-rule/rule"
                      props="pattern,kind,regex,any,all,not,matches,inside,has,follows,precedes"/>
    <xdef:check-mutex id="any-child-matcher" select="/lint-rule/rule/any"
                      props="pattern,kind,regex,any,all,not,matches,inside,has,follows,precedes"/>

    <message xdef:mandatory="true">!string</message>

    <!-- shared util rules (roadmap item 24, design 01 §3.4): id → one
         matcher object with the container's surface; referenced by
         'matches' matchers and stopBy=rule horizons. Existence and cycle
         freedom of the reference graph are enforced by RuleDslParser. -->
    <utils xdef:body-type="map" xdef:key-attr="name">
        <util name="!string" xdef:ref="LintMatcherBody"/>
    </utils>

    <!-- matcher container: exactly one of
         pattern|kind|regex|any|all|not|matches|inside|has|follows|precedes
         (RuleDslParser XOR) -->
    <rule xdef:ref="LintMatcherBody"/>

    <!-- flattened matcher surface: the rule container, a util value, and a
         'not' inner all declare exactly one of these keys (XOR at every
         level is the parser's runtime authority). -->
    <xdef:define xdef:name="LintMatcherBody">
        <pattern>!string</pattern>
        <kind>!string</kind>
        <regex>!string</regex>
        <any xdef:body-type="list">
            <matcher xdef:ref="LintMatcherUnit"/>
        </any>
        <all xdef:body-type="list">
            <matcher xdef:ref="LintMatcherUnit"/>
        </all>
        <not xdef:ref="LintMatcherBody"/>
        <matches>!string</matches>

        <!-- relational matchers (design 04 §5): stopBy three modes, stopByRule
             mandatory iff stopBy=rule, field only on inside/has; the inner
             shape is pattern XOR context+selector (contextual patterns,
             design 01 §1 — RuleDslParser enforces both directions) -->
        <inside pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string" field="string"
                context="string" selector="string"/>
        <has pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string" field="string"
             context="string" selector="string"/>
        <follows pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string"
                 context="string" selector="string"/>
        <precedes pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string"
                  context="string" selector="string"/>
    </xdef:define>

    <!-- object-form matcher unit (roadmap item 24): the list items of
         any/all. Flat attributes keep the backward-compatible branch
         conjunction (pattern+kind on one branch); the nested children carry
         the composite surface. -->
    <xdef:define xdef:name="LintMatcherUnit" pattern="string" kind="string" regex="string">
        <any xdef:body-type="list">
            <matcher xdef:ref="LintMatcherUnit"/>
        </any>
        <all xdef:body-type="list">
            <matcher xdef:ref="LintMatcherUnit"/>
        </all>
        <not xdef:ref="LintMatcherBody"/>
        <matches>string</matches>
        <inside pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string" field="string"
                context="string" selector="string"/>
        <has pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string" field="string"
             context="string" selector="string"/>
        <follows pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string"
                 context="string" selector="string"/>
        <precedes pattern="string" stopBy="enum:neighbor|end|rule=end" stopByRule="string"
                  context="string" selector="string"/>
    </xdef:define>

    <!-- per-match value constraints (design 01 §3.2/§3.3, roadmap item 22):
         top-level field, one constraint key (camelCase, same as the YAML key)
         per list element. Element XOR, required sub-fields, captures size and
         name shape, withinDepth range, and the typeOf->requires:L2 gate are
         all enforced fail-closed by io.nop.lint.core.rule.RuleDslParser (the
         runtime authority, as for matcher uniqueness). Constraints are value
         predicates over the match's captures: a match is reported only when
         every constraint holds; filtered matches are counted
         (constraintFilteredMatches), never dropped silently. -->
    <constraints xdef:body-type="list">
        <constraint>
            <sameText captures="csv-set"/>
            <differentText captures="csv-set"/>
            <regex capture="string" pattern="string"/>
            <inList capture="string" values="csv-set"/>
            <typeOf capture="string" is="string"/>
            <notExists pattern="string" message="string"/>
            <withinDepth max="int"/>
        </constraint>
    </constraints>

    <!-- xpl fragment text carried verbatim; XPL compilation belongs to RuleCompiler
         (roadmap item 14). This plan only guarantees text round-trip. -->
    <xscript>string</xscript>

    <!-- analyzer dependency levels, e.g. L1,L2 (csv-set) -->
    <requires>csv-set</requires>

    <metadata category="!string" severity="enum:hint|info|warning|error|off"
              autoFixable="boolean=false" version="string=1.0" source="csv-set"/>

    <options xdef:body-type="map" xdef:key-attr="key">
        <option key="!var-name" value="!string"/>
    </options>
    <!-- shared environment config injected by the ruleset layer (Phase 2) -->
    <settings xdef:body-type="map" xdef:key-attr="key">
        <setting key="!var-name" value="!string"/>
    </settings>

    <files include="csv-set" exclude="csv-set"/>
</lint-rule>
