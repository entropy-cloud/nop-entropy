<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:ioc="ioc"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <!-- N5.2: Spring entry-point pattern provider externalized from FlowDetector's private
         inner class; collected by consumers via ioc:collect-beans by-type. -->
    <bean id="nopCodeSpringEntryPointPatternProvider"
          class="io.nop.code.flow.SpringEntryPointPatternProvider"
          ioc:default="true" ioc:sort-order="100"/>
</beans>
