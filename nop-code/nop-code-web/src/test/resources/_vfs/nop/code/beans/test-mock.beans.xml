<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns:ioc="ioc">

    <!-- WI12 (plan 2304): the nop-code-web test classpath has no
         nopRawHttpClient implementation, so the conditional default bean
         nopHttpClient (on-bean nopRawHttpClient) never activates and the
         auto-assembled ai-defaults graph fails at startup when building
         nopChatService.httpClient (not-find-bean-with-type IHttpClient).
         Register a test stub that satisfies the by-type injection; it fails
         loudly if any test path actually issues HTTP (page validation never
         does). -->
    <bean id="testStubHttpClient" class="io.nop.code.web.mock.StubHttpClient"
          ioc:type="io.nop.http.api.client.IHttpClient" primary="true"/>

</beans>
