<?xml version="1.0" encoding="UTF-8" ?>
<workflow x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c">

    <start startStepName="wf-start"/>

    <end/>

    <steps>
        <step displayName="启动" name="wf-start">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="sh"/>
            </ref-actions>
        </step>
        <step displayName="自动执行步骤" name="auto-step">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <source>
                <c:script><![CDATA[
                    import io.nop.wf.service.TestWorkflowEngineRegression;
                    TestWorkflowEngineRegression.incSourceRunCount();
                ]]></c:script>
            </source>
            <!-- appState永远不满足，步骤停留在EXECUTED等待状态，用于验证source不被重复执行 -->
            <transition onAppStates="go">
                <to-end/>
            </transition>
        </step>
    </steps>

    <actions>
        <action displayName="提交" name="sh">
            <transition>
                <to-step stepName="auto-step"/>
            </transition>
        </action>
    </actions>
</workflow>
