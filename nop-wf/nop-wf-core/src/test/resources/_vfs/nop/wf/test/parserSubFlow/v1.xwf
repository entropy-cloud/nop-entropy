<?xml version="1.0" encoding="UTF-8" ?>
<workflow x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <start startStepName="wf-start"/>

    <actions>
        <action displayName="进入子流程" name="go">
            <transition>
                <to-step stepName="sub"/>
            </transition>
        </action>
    </actions>

    <steps>
        <step displayName="开始步骤" name="wf-start">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="go"/>
            </ref-actions>
        </step>
        <flow name="sub" displayName="子流程">
            <start wfName="test/subwf" wfVersion="1">
                <arg name="bizId" displayName="业务主键"/>
                <return var="subResult" output="result"/>
            </start>
            <transition>
                <to-end/>
            </transition>
        </flow>
    </steps>
</workflow>
