<?xml version="1.0" encoding="UTF-8" ?>
<workflow bizEntityStateProp="state" x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <start startStepName="wf-start"/>

    <actions>
        <action displayName="审核" name="sh">
            <transition>
                <to-step stepName="ysh"/>
            </transition>
        </action>
        <action displayName="审批" name="sp">
            <transition>
                <to-end/>
            </transition>
        </action>
        <action displayName="退回" common="true" forReject="true" name="_rejectAction"/>
        <action displayName="撤回" common="true" forWithdraw="true" name="_withdrawAction"/>
    </actions>

    <steps>
        <step displayName="开始步骤" allowWithdraw="true" name="wf-start">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="sh"/>
            </ref-actions>
        </step>
        <step displayName="已审核" allowReject="true" name="ysh">
            <assignment>
                <actors>
                    <actor actorId="2" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="sp"/>
            </ref-actions>
        </step>
    </steps>
</workflow>
