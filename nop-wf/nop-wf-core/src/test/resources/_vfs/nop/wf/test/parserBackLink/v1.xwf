<?xml version="1.0" encoding="UTF-8" ?>
<workflow x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <start startStepName="a"/>

    <actions>
        <action name="next" displayName="推进">
            <transition>
                <to-step stepName="b"/>
            </transition>
        </action>
        <action name="finishA" displayName="a结束">
            <transition>
                <to-end/>
            </transition>
        </action>
        <action name="back" displayName="回退到a">
            <transition>
                <to-step stepName="a" backLink="true"/>
            </transition>
        </action>
        <action name="finishB" displayName="b结束">
            <transition>
                <to-end/>
            </transition>
        </action>
    </actions>

    <steps>
        <step displayName="步骤a" name="a">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="next"/>
                <ref-action name="finishA"/>
            </ref-actions>
        </step>
        <step displayName="步骤b" name="b">
            <assignment>
                <actors>
                    <actor actorId="2" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="back"/>
                <ref-action name="finishB"/>
            </ref-actions>
        </step>
    </steps>
</workflow>
