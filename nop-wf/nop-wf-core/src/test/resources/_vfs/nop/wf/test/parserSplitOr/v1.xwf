<?xml version="1.0" encoding="UTF-8" ?>
<workflow x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <start startStepName="wf-start"/>

    <actions>
        <action name="route" displayName="路由">
            <transition splitType="or">
                <to-step stepName="big" order="1">
                    <when>
                        <c:script><![CDATA[false]]></c:script>
                    </when>
                </to-step>
                <to-step stepName="small" order="2"/>
            </transition>
        </action>
    </actions>

    <steps>
        <step displayName="开始步骤" name="wf-start">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="route"/>
            </ref-actions>
        </step>
        <step displayName="大额分支" name="big">
            <assignment>
                <actors>
                    <actor actorId="2" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <transition>
                <to-end/>
            </transition>
        </step>
        <step displayName="小额分支" name="small">
            <assignment>
                <actors>
                    <actor actorId="3" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <transition>
                <to-end/>
            </transition>
        </step>
    </steps>
</workflow>
