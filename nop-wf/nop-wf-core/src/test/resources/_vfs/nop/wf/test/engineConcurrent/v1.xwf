<?xml version="1.0" encoding="UTF-8" ?>
<workflow bizEntityStateProp="state" x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <!-- plan 2514 红②（C10-003/004）测试模型：and 执行组双人提交 → 组迁移 → 末步终结 -->

    <start startStepName="wf-start"/>

    <actions>
        <action displayName="发起" name="go">
            <transition>
                <to-step stepName="g1"/>
            </transition>
        </action>
        <action displayName="会签通过" name="ok">
            <transition>
                <to-step stepName="fin"/>
            </transition>
        </action>
        <action displayName="审批" name="sp">
            <transition>
                <to-end/>
            </transition>
        </action>
    </actions>

    <steps>
        <step displayName="开始步骤" name="wf-start">
            <assignment>
                <actors>
                    <actor actorId="0" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="go"/>
            </ref-actions>
        </step>
        <step displayName="会签组步骤" execGroupType="and-group" name="g1">
            <assignment>
                <actors>
                    <actor actorId="1" actorType="user" actorModelId="actor1"/>
                    <actor actorId="2" actorType="user" actorModelId="actor2"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="ok"/>
            </ref-actions>
        </step>
        <step displayName="末步" name="fin">
            <assignment>
                <actors>
                    <actor actorId="3" actorType="user" actorModelId="actor1"/>
                </actors>
            </assignment>
            <ref-actions>
                <ref-action name="sp"/>
            </ref-actions>
        </step>
    </steps>
</workflow>
