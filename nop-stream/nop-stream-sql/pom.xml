<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-stream</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-stream-sql</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-flow</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-orm-eql</artifactId>
        </dependency>
        <!-- WI17: test-scope only — the compiled TUMBLE product executes the windowed
             aggregate path at env.execute(), which needs the runtime window operator
             factory. Production code keeps the flow-only dependency direction (D13). -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- flow carries nop-ioc as test scope only; the auto-assembly proof test
             needs the IoC runtime (module app-beans discovery) on the test classpath -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ioc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- the auto-assembly proof test starts the full app container; the
             dao-defaults Hikari datasource then needs a real driver — H2 in-memory
             per the D15 default -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
