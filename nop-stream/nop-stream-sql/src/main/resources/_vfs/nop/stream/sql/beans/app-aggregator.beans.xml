<?xml version="1.0" encoding="UTF-8" ?>
<!--
  WI8c: registers the aggregate-resolution SPI provider so <aggregate aggregatorRef>
  works in any application with nop-stream-sql on the classpath. Loaded by the Nop
  IoC module-app-beans mechanism (module marker at _vfs/nop/stream-sql/_module,
  app-*.beans.xml naming convention).
-->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <bean id="nopStreamAggregatorFunctionResolver"
          class="io.nop.stream.sql.eval.StreamAggregatorFunctionResolver"/>

</beans>
