<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-stream</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-stream-fraud-example</artifactId>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- CEP Pattern API (engine-direct teaching demo, FraudDetectionDemo) -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-cep</artifactId>
        </dependency>

        <!-- Composite scenarios (S1/S2, roadmap item 13): XDSL front door + connectors +
             runtime execution/checkpoint + RocksDB backend switching. Dependency set per
             composite-scenario-design.md §3.4.8 (D8): all edges are example -> framework,
             single direction. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-flow</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector-debezium</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-rocksdb</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Item 14 (composite-scenario distributed): multi-JVM launch harness
             (MiniStreamCluster + JobCoordinatorMain/TaskManagerMain + PollingJdbcMessageService
             + ClusterPipelineFactory) lives in nop-stream-runtime's test sources.
             Test-jar dependency keeps the direction one-way (example-test -> runtime-test);
             a reverse runtime-test -> fraud-example dependency would be a forbidden cycle
             since fraud-example already depends on runtime main. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-runtime</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Scenario E2E tests execute keyed-state pipelines through the RocksDB
         backend, which ships no aarch64-windows dll: on Windows ARM64 they all
         fail (UnsatisfiedLinkError -> checkpoint abort). Skip tests on that
         platform only. -->
    <profiles>
        <profile>
            <id>skip-tests-windows-arm64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <skipTests>true</skipTests>
            </properties>
        </profile>
    </profiles>
</project>