<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-stream</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-stream-connector-jdbc</artifactId>

    <!--
        Stage 52: Transactional JDBC sink (two-phase commit).

        Depends on nop-stream-core (TwoPhaseCommitSinkFunction base class) and
        nop-dao (IJdbcTemplate / IDialect for multi-DB JDBC access).

        Does NOT depend on nop-batch-core — the transactional JDBC sink manages
        its own epoch-bound transactions and does not use IBatchConsumer/IBatchLoader.
        Separate module from nop-stream-connector-batch per connector-design.md §5.3.3 D2.
    -->

    <dependencies>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-dao</artifactId>
        </dependency>

        <!--
            cdc-design.md §3.5: dmlMode UPSERT/UPSERT_DELETE consume the nop ChangeEvent
            envelope (operation c/u/d/r + key + after) natively; INSERT consumes plain
            record rows. provided+optional: jobs that feed ChangeEvent records already
            carry this module at runtime.

            WI4 plan 2413: the sink gates all four CDC branches behind a classpath
            capability probe (JdbcTwoPhaseCommitSink.CDC_PRESENT → CdcEventOps), so a
            pure INSERT deployment that does NOT carry this jar runs zero-linked —
            guarded by the surefire execution insert-no-debezium (regression pin:
            TestJdbcTwoPhaseCommitSinkInsertNoDebezium). Earlier comment claimed INSERT
            "never touches these types" via direct instanceof: that was false — JVM
            instanceof resolves the referenced class, first INSERT record hit
            NoClassDefFoundError. Renaming/moving ChangeEvent silently disables the
            envelope paths: keep the probe string, CdcEventOps and this dependency in
            sync.
        -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-message-debezium</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- WI4 plan 2413 防回归门禁：INSERT 全路径在无 nop-message-debezium
                             的运行时 classpath 下必须可用。includes 限定单测试类——无 includes
                             时本 execution 会套默认 include 跑全部测试类，TestJdbcTwoPhaseCommitSinkDml
                             构造 ChangeEvent 必红（防回归配置误伤）。default-test 照常先行运行。 -->
                        <id>insert-no-debezium</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>io.github.entropy-cloud:nop-message-debezium</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <includes>
                                <include>TestJdbcTwoPhaseCommitSinkInsertNoDebezium</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
