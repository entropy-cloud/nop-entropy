<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connector SPI factory beans for the nop-batch bridge connector family (item 19 / P-REQ-28).
    Loaded only by explicit container assembly (StreamConnectorCatalog / BeanContainerBuilder);
    the file name does not match the `app-*.beans.xml` pattern, so these beans never leak
    into the global app container.
-->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:ioc="ioc">

    <bean id="streamConnectorBatchLoaderSourceFactory"
          class="io.nop.stream.connector.batch.BatchLoaderSourceConnectorFactory"/>

    <bean id="streamConnectorBatchConsumerSinkFactory"
          class="io.nop.stream.connector.batch.BatchConsumerSinkConnectorFactory"/>

</beans>
