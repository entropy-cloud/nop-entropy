<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Test beans for the WI13 equi-join pipeline end-to-end test.
  Provides:
    * joinLeftSource — emits [k1:a, k2:b]
    * joinRightSource — emits [k2:x, k1:y]
    * joinCollectingSink — collects JoinMatch outputs
-->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <bean id="joinLeftSource"
          class="io.nop.stream.flow.testing.LeftJoinSourceFunction"/>

    <bean id="joinRightSource"
          class="io.nop.stream.flow.testing.RightJoinSourceFunction"/>

    <bean id="joinCollectingSink"
          class="io.nop.stream.flow.testing.CollectingSinkFunction"/>

</beans>
