<!--
  Base pipeline for the _delta/default/ layered override test.
  Simple: source -> sink (no map). The layered delta in
  _delta/default/nop/stream/test/test-delta-layered.stream.xml adds a
  <map> transform (deltaLayerMap) between source and sink, so the merged
  pipeline becomes source -> map(toUpperCase) -> sink.

  Because the _delta/default/ layer is auto-activated, loading this path
  always returns the merged result. The delta-unique assertion (transform
  "deltaLayerMap" present + uppercase output) proves the delta was applied
  rather than the base being silently loaded.
-->
<stream x:schema="/nop/schema/stream/stream.xdef"
        name="test-delta-layered" version="1" parallelism="1">

    <transforms>
        <source id="src" name="TestSource"
                bean="testSourceFunction"
                parallelism="1"/>

        <sink id="out" name="CollectingSink"
              bean="collectingSinkFunction"
              parallelism="1"/>
    </transforms>

    <edges>
        <edge id="e0" from="src" to="out" partition="FORWARD"/>
    </edges>
</stream>
