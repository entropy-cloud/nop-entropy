<!--
  Base pipeline with explicit checkpoint config, used to prove that a
  config-only delta (one that changes only checkpoint interval / parallelism,
  leaving the transform DAG untouched) does NOT change the StreamModel
  fingerprint. See test-delta-config-extends.stream.xml for the delta.
-->
<stream x:schema="/nop/schema/stream/stream.xdef"
        name="test-delta-config-base" version="1" parallelism="2">

    <checkpoint enabled="true" interval="60000"/>

    <transforms>
        <source id="src" name="TestSource"
                bean="testSourceFunction"
                parallelism="1"/>

        <map id="upper" name="ToUpperCase">
            <source>return event.toString().toUpperCase();</source>
        </map>

        <sink id="out" name="CollectingSink"
              bean="collectingSinkFunction"
              parallelism="1"/>
    </transforms>

    <edges>
        <edge id="e0" from="src" to="upper" partition="FORWARD"/>
        <edge id="e1" from="upper" to="out" partition="FORWARD"/>
    </edges>
</stream>
