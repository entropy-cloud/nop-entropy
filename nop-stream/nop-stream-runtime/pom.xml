<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-stream</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-stream-runtime</artifactId>

    <dependencyManagement>
        <dependencies>
            <!-- WI3 (plan 2335): real-broker kafka E2E (gated assume-skip), versions via
                 the testcontainers-bom single point — same precedent as connector-debezium -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- CEP and connector integration is planned for future releases.
         Currently runtime depends on nop-stream-core plus nop-stream-flow. -->
    <dependencies>
        <!-- WI13 (plan 2339): S3-compatible checkpoint storage backend (storageType=s3);
             version single-point in nop-dependencies, same as nop-integration-oss -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-java-sdk-s3</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-core</artifactId>
        </dependency>

        <!-- Item 20 (P-REQ-13/14, pre-submit-validation-design.md D1): conf-validate /
             dry-run entry lives in the maintenance entry family (this module) while the
             validation core lives in nop-stream-flow (model parse + bean resolution owner).
             First stream-module compile dependency of runtime beyond core. This compile
             dependency and the RemotePipelineResolver ServiceLoader indirection coexist
             on purpose: the compile dependency serves the maintenance tooling, while the
             SPI keeps the TM-side deployment path (io.nop.stream.runtime.rpc.
             RemotePipelineResolver) decoupled from the XDSL declaration syntax owned by
             flow / scenario modules. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-flow</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- nop-cluster-core: platform discovery (INamingService / AutoRegistration) for node registration (G51) -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-cluster-core</artifactId>
        </dependency>

        <!-- Stage 39 Phase 2: control-plane cross-JVM RPC over IMessageService
             (MessageRpcServer / MessageRpcClient / ReflectiveRpcService / RpcServiceProxyFactoryBean) -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-rpc-core</artifactId>
        </dependency>

        <!-- nop-message-core: LocalMessageService transport. Compile-scope because the
             control-plane RPC wiring (Stage 39 Phase 2) and RemoteResultPartition/RemoteInputChannel
             rely on an IMessageService backend at runtime; production deployments inject
             SysDaoMessageService/PulsarMessageService. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-message-core</artifactId>
        </dependency>

        <!-- nop-ioc: NopIoC container, used by the Stage 39 Phase 2 RPC beans.xml bootstrap
             test (production deployment wiring). Test-scope so the IocCoreInitializer does
             not alter other module tests' CoreInitialization behaviour. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ioc</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AR-2 test-scope exception register (WI5 plan 2415 — authoritative record;
             the per-dependency inline comments below are historical pointers).
             The engine main sources depend on NO connector (AR-2 intent, connector
             pom :13-30, holds on the compile face). The TEST face reintroduces the
             full connector family on purpose: engine-level E2E (checkpoint restore,
             backfill, kill-recover, 2PC) must be driven through real connector
             source/sinks, so this fan-in is inherent to E2E coverage. Adjudication
             (plan 2415): registered exception, minimal set = all six test deps kept.
             Dropped/门控 alternatives were rejected on evidence:
             - connector-debezium has NO direct import consumer, but the aggregate
               registry discovery acceptance record (P-REQ-28,
               TestStreamConnectorRegistryDiscovery) hard-asserts the full set:
               connector-debezium.beans.xml in discovered files, debezium-cdc in
               source types, exactly 10 connectors total. Removing or gating the dep
               would break/weaken that acceptance out of the default verification face.
             - rocksdb has 9 real consumer files (8 direct imports + 1 inline FQN).
             The surefire init cap (nop.core.initialize.max-initialize-level, see
             build section below) keeps the connectors' initializers inert while
             their jars are on the test classpath. F-26 correction record: the
             earlier "already main deps" wording was wrong — these are test scopes.

             Direct consumer census (WI5 plan 2415; 9 files with imports + 1 FQN):
             - connector-jdbc  ← TestE2EJdbcTwoPhaseCommitSink,
               TestCheckpointInheritedTwoPhaseCommitRestore, TestRecalculateBackfillE2E
             - connector-batch ← TestBatchLoaderSourceE2E, TestRecalculateBackfillE2E
               (+ TestWi19BoundedReplayDeclarationE2E references
               BatchLoaderSourceFunction by FQN)
             - connector (file sink) ← TestFileSourceE2E, TestSourceApiRestoreE2E
             - connector (root: message) ← TestMessageSourceE2E, TestRateLimitValidationFace
             - connector-kafka ← TestKafkaConnectorExactlyOnceE2E (gated real broker)
             - connector-debezium ← no direct import; P-REQ-28 discovery assertions above
             - rocksdb ← 9 files (8 direct imports + 1 inline FQN):
               TestE2EWindowAggregateRestore, TestCheckpointCoordinatorIncrementalIntegration,
               TestCheckpointCoordinatorJdbcRetainedManifests, TestStateMigrationEndToEnd,
               TestCheckpointCoordinatorIncrementalPersistRollback,
               TestCheckpointInheritedSegmentRefCount, TestKeyGroupRoutingE2E,
               TestRocksDBStateBackendE2E (+ inline FQN in TestE2EWindowAggregateRestore)
        -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector-debezium</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector-batch</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

            <!-- WI3 (plan 2335): native kafka connector E2E (gated real-broker kill-recover) -->
            <dependency>
                <groupId>io.github.entropy-cloud</groupId>
                <artifactId>nop-stream-connector-kafka</artifactId>
                <scope>test</scope>
            </dependency>

        <!-- F-12 closure (plan 2328): compile scope. The runtime main sources hard-require
             the nop-dao JDBC face at run time (JdbcClusterRegistry / JdbcCheckpointStorage /
             JdbcLeaderElector and, since WI1, the main-scope launch entry points
             JobCoordinatorMain / TaskManagerMain via SharedJdbcInfrastructure). The former
             provided scope made standalone cluster launches fail with NoClassDefFoundError
             unless the deployer knew to add nop-dao manually. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-dao</artifactId>
        </dependency>

        <!-- WI1 (plan 2328): compile scope — SharedJdbcInfrastructure (launch entry
             support, main sources) builds its Hikari pool directly. Version resolved
             through the BOM chain (nop-dependencies imports). -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-rocksdb</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WI3 (plan 2335): real-broker kafka kill-recover E2E (gated) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Stage 40: Pulsar data-plane backend integration test. Test scope only —
             production deps remain clean; backend selection is a deployment choice
             (see stream-data-plane.beans.xml). The SysDao (DB) E2E lives in
             nop-sys-dao/src/test (mirrors the Stage 38 elector smoke check pattern),
             avoiding a cyclic test-scope reactor dependency. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-message-pulsar</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Stage 48: Kafka data-plane backend integration test. Test scope only —
             production deps remain clean; backend selection is a deployment choice
             (see stream-data-plane.beans.xml). Mirrors the nop-message-pulsar test-scope
             pattern. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-message-kafka</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Stage 49: FLIP-27 style split-based source reference implementation
             (FileSource) is in nop-stream-connector. Test scope only — production code
             that uses the new Source API only needs nop-stream-core. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Stage 52: Transactional JDBC sink (two-phase commit) E2E test.
             Test scope only — production code that uses the JDBC 2PC sink
             only needs nop-stream-core + nop-dao. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-stream-connector-jdbc</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Stage 39 Phase 2: nop-ioc is now a test-scope dependency (for the RPC
                         beans.xml bootstrap test). Its IocCoreInitializer would otherwise load
                         nop-dao's dao-defaults beans during CoreInitialization in the JDBC tests
                         (which use their own manual HikariDataSource and don't need the global
                         IoC container). Cap initialization below IOC to preserve prior behaviour;
                         TestStreamControlRpcBootstrap builds its own standalone container. -->
                    <systemPropertyVariables>
                        <nop.core.initialize.max-initialize-level>4500</nop.core.initialize.max-initialize-level>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Item 14 (composite-scenario distributed): export the multi-JVM launch
                 harness as a test-jar so the scenario module's gated tests can spawn real
                 cluster JVMs. WI1 (plan 2328) moved the production entry points
                 (JobCoordinatorMain / TaskManagerMain / SharedJdbcInfrastructure /
                 PollingJdbcMessageService) to main sources — they ship in the runtime jar
                 and no longer need the test-jar. What remains test-only is the harness
                 itself (MiniStreamCluster + multijvm tests) plus ClusterLaunchConfig /
                 ClusterPipelineFactory consumers in scenario tests. Decision (plan Current
                 Baseline, path ①): fraud-example depends on runtime main, so runtime test
                 -> fraud-example would be a forbidden reverse test dependency; test-jar
                 export keeps the direction one-way. Mirrors the nop-stream-core test-jar
                 pattern. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The incremental-checkpoint integration tests load the RocksDB native
         library (via nop-stream-rocksdb), which ships no aarch64-windows dll:
         on Windows ARM64 they all die with UnsatisfiedLinkError. Skip tests on
         that platform only. -->
    <profiles>
        <profile>
            <id>skip-tests-windows-arm64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <skipTests>true</skipTests>
            </properties>
        </profile>
    </profiles>
</project>