<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-entropy</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-treesitter</artifactId>
    <name>33-nop-treesitter</name>

    <description>
        Pure-Java runtime for the Tree-sitter parsing ecosystem. Replaces the C runtime
        with a Java implementation so that Nop applications can use 200+ Tree-sitter
        grammars without JNI / FFM native dependencies. Inspired by gotreesitter (Go).

        Module layout (initial — may split into api/core/loader submodules as size grows):
        - io.nop.treesitter  public API: TSLanguage, TSParser, TSTree, TSNode, TSQuery,
          TSQueryCursor, TSTreeCursor
        - io.nop.treesitter.lexer  lexer state machine + keyword recognition
        - io.nop.treesitter.parser  LR/GLR parser + graph-structured stack
        - io.nop.treesitter.subtree  Subtree arena (compact int32 index, slot reuse)
        - io.nop.treesitter.query  S-expression query compiler + executor
        - io.nop.treesitter.scanner  external scanner bytecode VM
        - io.nop.treesitter.language  parse-table binary blob loader
        - io.nop.treesitter.cursor  tree cursor
        - io.nop.treesitter.util  interning, UTF-8 utilities
    </description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Nop common utilities -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-graphql-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ioc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Migration verification: the legacy JNI embedded tree-sitter used by
             nop-code-lang-* (test scope only, never shipped by this module) -->
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter</artifactId>
            <version>0.25.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-typescript</artifactId>
            <version>0.23.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.33</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.33</version>
            <scope>test</scope>
        </dependency>

        <!-- Logging facade used across nop-* modules -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test scope -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
        <!-- shadow 'argLine' so the TS/TSX corpus tests get a larger heap than
             the parent default; the parent's jacoco line is preserved -->
      <profiles>
    <profile>
            <id>corpus-heap</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>1.33</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>
                                ${jacocoArgLine}
                                -Xmx2G
                                -Xms256m
                                -XX:MaxMetaspaceSize=256m
                                -XX:+UseG1GC
                                -XX:+UseStringDeduplication
                            </argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
  </profiles>
</project>
