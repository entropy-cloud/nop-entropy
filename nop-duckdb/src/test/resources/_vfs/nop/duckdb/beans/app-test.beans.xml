<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd"
>

    <!-- test-only flaky wrapper for retry decorator verification -->
    <bean id="testFlakyDuckDbStep" class="io.nop.duckdb.TestFlakyDuckDbStep">
        <property name="engine" ref="nopDuckDbEngine"/>
    </bean>

    <!-- test-only wrapper throwing the permanent file-locked error on first attempt -->
    <bean id="testFileLockedStep" class="io.nop.duckdb.TestFileLockedStep">
        <property name="engine" ref="nopDuckDbEngine"/>
    </bean>

    <!-- step wired to an engine whose native boundary always fails -->
    <bean id="testBrokenNativeStep" class="io.nop.duckdb.DuckDbSqlTaskStep">
        <property name="engine">
            <bean class="io.nop.duckdb.TestBrokenNativeEngine"/>
        </property>
    </bean>

    <!-- step wired to an engine with a tight budget and an unwritable spill directory -->
    <bean id="testSpillStep" class="io.nop.duckdb.DuckDbSqlTaskStep">
        <property name="engine">
            <bean class="io.nop.duckdb.TestSpillEngine"/>
        </property>
    </bean>

    <!-- WI6 deep-spill scenario: 128MB budget, writable pollable spill directory -->
    <bean id="testSpillTaskEngine" class="io.nop.duckdb.TestSpillTaskEngine"/>
    <bean id="testDeepSpillStep" class="io.nop.duckdb.DuckDbSqlTaskStep">
        <property name="engine" ref="testSpillTaskEngine"/>
    </bean>
</beans>
