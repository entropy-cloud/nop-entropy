            <schema domain="remark" type="java.lang.String" precision="200"/>
        </prop>
        <prop name="reportTask" displayName="报告任务" i18n-en:displayName="Report Task" tagSet="pub,ref-pub"
              ext:kind="to-one" internal="true" queryable="true" ext:joinLeftProp="reportTaskId"
              ext:joinRightProp="reportTaskId" ext:joinRightDisplayProp="displayName" insertable="false"
              updatable="false" mandatory="true" lazy="true">
            <schema bizObjName="NopDatavReportTask"/>
        </prop>
        <prop name="reportTask.displayName" displayName="报告任务" i18n-en:displayName="Report Task" internal="true"
