<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="activity" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="告警状态" i18n-en:displayName="Alert State" xmlns:ui="ui"
      xmlns:orm="orm">

    <entityName>io.nop.datav.dao.entity.NopDatavAlertState</entityName>

    <primaryKey>alertStateId</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys>
        <key name="UK_NOP_DATAV_ALERT_STATE_RULE" props="alertRuleId"/>
    </keys>

    <props>
        <prop name="alertStateId" displayName="状态ID" propId="1" i18n-en:displayName="Alert State Id" tagSet="seq"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="alertRuleId" displayName="告警规则ID" propId="2" i18n-en:displayName="Alert Rule Id" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true" ext:relation="alertRule">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="state" displayName="告警状态" propId="3" i18n-en:displayName="State" mandatory="true" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20" dict="datav/alert-state"/>
        </prop>
        <prop name="lastEvalTime" displayName="最后评估时间" propId="4" i18n-en:displayName="Last Eval Time" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="lastTriggeredTime" displayName="最后触发时间" propId="5" i18n-en:displayName="Last Triggered Time"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="lastResolvedTime" displayName="最后恢复时间" propId="6" i18n-en:displayName="Last Resolved Time"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="lastNotifiedTime" displayName="最后通知时间" propId="7" i18n-en:displayName="Last Notified Time"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="consecutiveEvalCount" displayName="连续评估满足次数" propId="8" i18n-en:displayName="Consecutive Eval Count"
              queryable="true" sortable="true" insertable="true" updatable="true" defaultValue="0">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="errorMsg" displayName="错误信息" propId="9" i18n-en:displayName="Error Msg" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="1000"/>
        </prop>
        <prop name="delFlag" displayName="删除标记" propId="10" i18n-en:displayName="Del Flag" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema stdDomain="boolFlag" domain="delFlag" type="java.lang.Byte"/>
        </prop>
        <prop name="version" displayName="数据版本" propId="11" i18n-en:displayName="Version" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true">
            <schema domain="version" type="java.lang.Long"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="12" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="13" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="修改人" propId="14" i18n-en:displayName="Updated By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="修改时间" propId="15" i18n-en:displayName="Update Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="remark" displayName="备注" propId="16" i18n-en:displayName="Remark" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema domain="remark" type="java.lang.String" precision="200"/>
        </prop>
        <prop name="alertRule" displayName="告警规则" i18n-en:displayName="Alert Rule" tagSet="pub,ref-pub"
              ext:kind="to-one" internal="true" queryable="true" ext:joinLeftProp="alertRuleId"
              ext:joinRightProp="alertRuleId" ext:joinRightDisplayProp="displayName" insertable="false"
              updatable="false" mandatory="true" lazy="true">
            <schema bizObjName="NopDatavAlertRule"/>
        </prop>
        <prop name="alertRule.displayName" displayName="告警规则" i18n-en:displayName="Alert Rule" internal="true"
              queryable="true" sortable="true" lazy="true">
            <schema type="String"/>
        </prop>
