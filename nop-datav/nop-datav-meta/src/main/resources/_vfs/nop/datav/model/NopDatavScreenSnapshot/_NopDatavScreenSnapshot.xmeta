<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="git-commit-horizontal" ext:web-renderer="" xmlns:c="c"
      xmlns:graphql="graphql" xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="大屏快照"
      i18n-en:displayName="Screen Snapshot" xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.datav.dao.entity.NopDatavScreenSnapshot</entityName>

    <primaryKey>snapshotId</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys>
        <key name="UK_NOP_DATAV_SCREEN_SNAPSHOT_SCREEN_VER" props="screenId,snapshotVersion"/>
    </keys>

    <props>
        <prop name="snapshotId" displayName="快照ID" propId="1" i18n-en:displayName="Snapshot Id" tagSet="seq"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="screenId" displayName="大屏ID" propId="2" i18n-en:displayName="Screen Id" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true" ext:relation="screen">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="snapshotVersion" displayName="快照版本" propId="3" i18n-en:displayName="Snapshot Version"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Long"/>
        </prop>
        <prop name="snapshotContent" displayName="快照内容" propId="4" i18n-en:displayName="Snapshot Content"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true"
              graphql:jsonComponentProp="snapshotContentComponent">
            <schema stdDomain="json" domain="clobJson" type="java.lang.String"/>
        </prop>
        <prop name="publishedBy" displayName="发布人" propId="5" i18n-en:displayName="Published By" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="publishedTime" displayName="发布时间" propId="6" i18n-en:displayName="Published Time" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="delFlag" displayName="删除标记" propId="7" i18n-en:displayName="Del Flag" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema stdDomain="boolFlag" domain="delFlag" type="java.lang.Byte"/>
        </prop>
        <prop name="version" displayName="数据版本" propId="8" i18n-en:displayName="Version" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true">
            <schema domain="version" type="java.lang.Long"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="9" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="10" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="修改人" propId="11" i18n-en:displayName="Updated By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="修改时间" propId="12" i18n-en:displayName="Update Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="remark" displayName="备注" propId="13" i18n-en:displayName="Remark" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema domain="remark" type="java.lang.String" precision="200"/>
        </prop>
        <prop name="screen" displayName="大屏" i18n-en:displayName="Screen" tagSet="pub,ref-pub" ext:kind="to-one"
              internal="true" queryable="true" ext:joinLeftProp="screenId" ext:joinRightProp="screenId"
              ext:joinRightDisplayProp="displayName" insertable="false" updatable="false" mandatory="true" lazy="true">
            <schema bizObjName="NopDatavScreen"/>
        </prop>
        <prop name="screen.displayName" displayName="大屏" i18n-en:displayName="Screen" internal="true" queryable="true"
              sortable="true" lazy="true">
            <schema type="String"/>
        </prop>
        <prop name="snapshotContentComponent" tagSet="json,pub,edit" ext:kind="component" internal="true"
              insertable="true" updatable="true" mandatory="true" lazy="true">
            <schema type="io.nop.orm.component.JsonOrmComponent"/>
        </prop>
    </props>
</meta>