    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="widgetId" displayName="组件ID" propId="1" i18n-en:displayName="Widget Id" tagSet="seq"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="screenId" displayName="大屏ID" propId="2" i18n-en:displayName="Screen Id" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true" ext:relation="screen">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="widgetName" displayName="组件名" propId="3" i18n-en:displayName="Widget Name" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="displayName" displayName="显示名" propId="4" i18n-en:displayName="Display Name" tagSet="disp"
