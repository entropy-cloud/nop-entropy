            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="y" displayName="Y坐标" propId="8" i18n-en:displayName="Y" mandatory="true" queryable="true"
              sortable="true" insertable="true" updatable="true" defaultValue="0">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="w" displayName="宽度" propId="9" i18n-en:displayName="Width" mandatory="true" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="h" displayName="高度" propId="10" i18n-en:displayName="Height" mandatory="true" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="z" displayName="层级" propId="11" i18n-en:displayName="Z-Index" queryable="true" sortable="true"
