            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="widgetConfig" displayName="组件配置" propId="12" i18n-en:displayName="Widget Config" queryable="true"
              sortable="true" insertable="true" updatable="true" graphql:jsonComponentProp="widgetConfigComponent">
            <schema stdDomain="json" domain="json-4000" type="java.lang.String" precision="4000"/>
        </prop>
        <prop name="delFlag" displayName="删除标记" propId="13" i18n-en:displayName="Del Flag" queryable="true"
