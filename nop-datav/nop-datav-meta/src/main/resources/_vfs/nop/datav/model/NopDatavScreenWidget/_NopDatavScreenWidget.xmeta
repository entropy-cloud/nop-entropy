            <schema type="java.lang.String" precision="200"/>
        </prop>
        <prop name="componentType" displayName="组件类型" propId="5" i18n-en:displayName="Component Type" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="datasetRefId" displayName="数据集引用ID" propId="6" i18n-en:displayName="Dataset Ref Id" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="x" displayName="X坐标" propId="7" i18n-en:displayName="X" mandatory="true" queryable="true"
