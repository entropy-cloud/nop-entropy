<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="message-square" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="ChatBI会话消息" i18n-en:displayName="ChatBI Session Message"
      xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.datav.dao.entity.NopDatavChatMessage</entityName>

    <primaryKey>messageId</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys>
        <key name="UK_NOP_DATAV_CHAT_MSG_SESSION_SEQ" props="sessionId,seq"/>
    </keys>

    <props>
        <prop name="messageId" displayName="消息ID" propId="1" i18n-en:displayName="Message Id" tagSet="seq"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="sessionId" displayName="会话ID" propId="2" i18n-en:displayName="Session Id" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true" ext:relation="session">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="seq" displayName="消息序号" propId="3" i18n-en:displayName="Seq" mandatory="true" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="role" displayName="消息角色" propId="4" i18n-en:displayName="Role" mandatory="true" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20" dict="datav/chat-msg-role"/>
        </prop>
        <prop name="content" displayName="消息内容" propId="5" i18n-en:displayName="Content" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String"/>
        </prop>
        <prop name="resultJson" displayName="结构化结果JSON" propId="6" i18n-en:displayName="Result Json" queryable="true"
              sortable="true" insertable="true" updatable="true" graphql:jsonComponentProp="resultJsonComponent">
            <schema stdDomain="json" domain="clobJson" type="java.lang.String"/>
        </prop>
        <prop name="delFlag" displayName="删除标记" propId="7" i18n-en:displayName="Del Flag" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema stdDomain="boolFlag" domain="delFlag" type="java.lang.Byte"/>
        </prop>
        <prop name="version" displayName="数据版本" propId="8" i18n-en:displayName="Version" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true">
            <schema domain="version" type="java.lang.Long"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="9" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="10" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="修改人" propId="11" i18n-en:displayName="Updated By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="修改时间" propId="12" i18n-en:displayName="Update Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="remark" displayName="备注" propId="13" i18n-en:displayName="Remark" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema domain="remark" type="java.lang.String" precision="200"/>
        </prop>
        <prop name="session" displayName="会话" i18n-en:displayName="Session" tagSet="pub,ref-pub" ext:kind="to-one"
              internal="true" queryable="true" ext:joinLeftProp="sessionId" ext:joinRightProp="sessionId"
              insertable="false" updatable="false" mandatory="true" lazy="true">
            <schema bizObjName="NopDatavChatSession"/>
        </prop>
        <prop name="resultJsonComponent" tagSet="json,pub,edit" ext:kind="component" internal="true" insertable="true"
              updatable="true" lazy="true">
            <schema type="io.nop.orm.component.JsonOrmComponent"/>
        </prop>
    </props>
</meta>