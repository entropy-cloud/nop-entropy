<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="bell" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="告警规则" i18n-en:displayName="Alert Rule" xmlns:ui="ui"
      xmlns:orm="orm">

    <entityName>io.nop.datav.dao.entity.NopDatavAlertRule</entityName>

    <primaryKey>alertRuleId</primaryKey>

    <displayProp>displayName</displayProp>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="alertRuleId" displayName="告警规则ID" propId="1" i18n-en:displayName="Alert Rule Id" tagSet="seq"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="ruleName" displayName="规则名" propId="2" i18n-en:displayName="Rule Name" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="displayName" displayName="显示名" propId="3" i18n-en:displayName="Display Name" tagSet="disp"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="200"/>
        </prop>
        <prop name="panelId" displayName="面板ID" propId="4" i18n-en:displayName="Panel Id" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true" ext:relation="panel">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="valueField" displayName="取值字段" propId="5" i18n-en:displayName="Value Field" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="aggregation" displayName="聚合方式" propId="6" i18n-en:displayName="Aggregation" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20" dict="datav/alert-aggregation"/>
        </prop>
        <prop name="operator" displayName="比较运算符" propId="7" i18n-en:displayName="Operator" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20" dict="datav/alert-operator"/>
        </prop>
        <prop name="thresholdValue" displayName="阈值" propId="8" i18n-en:displayName="Threshold Value" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.math.BigDecimal" precision="20" scale="4"/>
        </prop>
        <prop name="thresholdValue2" displayName="阈值上限" propId="9" i18n-en:displayName="Threshold Value2"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.math.BigDecimal" precision="20" scale="4"/>
        </prop>
        <prop name="rearmSeconds" displayName="冷静期秒数" propId="10" i18n-en:displayName="Rearm Seconds" queryable="true"
              sortable="true" insertable="true" updatable="true" defaultValue="0">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="notifyChannels" displayName="通知渠道" propId="11" i18n-en:displayName="Notify Channels"
              queryable="true" sortable="true" insertable="true" updatable="true"
              graphql:jsonComponentProp="notifyChannelsComponent">
            <schema stdDomain="json" domain="clobJson" type="java.lang.String"/>
        </prop>
        <prop name="recipients" displayName="收件人" propId="12" i18n-en:displayName="Recipients" queryable="true"
              sortable="true" insertable="true" updatable="true" graphql:jsonComponentProp="recipientsComponent">
            <schema stdDomain="json" domain="clobJson" type="java.lang.String"/>
        </prop>
        <prop name="cronExpr" displayName="cron表达式" propId="13" i18n-en:displayName="Cron Expr" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="params" displayName="查询参数" propId="14" i18n-en:displayName="Params" queryable="true" sortable="true"
              insertable="true" updatable="true" graphql:jsonComponentProp="paramsComponent">
            <schema stdDomain="json" domain="clobJson" type="java.lang.String"/>
        </prop>
        <prop name="templateKey" displayName="模板键" propId="15" i18n-en:displayName="Template Key" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="status" displayName="规则状态" propId="16" i18n-en:displayName="Status" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.Integer" dict="datav/report-task-status"/>
        </prop>
        <prop name="delFlag" displayName="删除标记" propId="17" i18n-en:displayName="Del Flag" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema stdDomain="boolFlag" domain="delFlag" type="java.lang.Byte"/>
        </prop>
        <prop name="version" displayName="数据版本" propId="18" i18n-en:displayName="Version" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true">
            <schema domain="version" type="java.lang.Long"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="19" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="20" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="修改人" propId="21" i18n-en:displayName="Updated By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="修改时间" propId="22" i18n-en:displayName="Update Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="remark" displayName="备注" propId="23" i18n-en:displayName="Remark" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema domain="remark" type="java.lang.String" precision="200"/>
        </prop>
        <prop name="panel" displayName="面板" i18n-en:displayName="Panel" tagSet="pub,ref-pub" ext:kind="to-one"
              internal="true" queryable="true" ext:joinLeftProp="panelId" ext:joinRightProp="panelId"
              ext:joinRightDisplayProp="displayName" insertable="false" updatable="false" mandatory="true" lazy="true">
            <schema bizObjName="NopDatavPanel"/>
        </prop>
        <prop name="panel.displayName" displayName="面板" i18n-en:displayName="Panel" internal="true" queryable="true"
