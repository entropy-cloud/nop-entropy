<?xml version="1.0" encoding="UTF-8" ?>
<orm ext:registerShortName="true" ext:appName="nop-datav" ext:icon="layout-dashboard"
     ext:entityPackageName="io.nop.datav.dao.entity" ext:basePackageName="io.nop.datav"
     ext:mavenGroupId="io.github.entropy-cloud" ext:mavenArtifactId="nop-datav"
     ext:mavenVersion="2.0.0-SNAPSHOT" ext:platformVersion="2.0.0-SNAPSHOT"
     ext:dialect="mysql,oracle,postgresql" ext:useCoreModule="true"
     x:schema="/nop/schema/orm/orm.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <dicts>
        <dict label="看板类型" name="datav/dashboard-type" valueType="int" i18n-en:label="Dashboard Type">
            <option code="DASHBOARD" label="看板" value="0" i18n-en:label="Dashboard"/>
            <option code="REPORT" label="报表" value="10" i18n-en:label="Report"/>
        </dict>
        <dict label="发布状态" name="datav/publish-status" valueType="int" i18n-en:label="Publish Status">
            <option code="DRAFT" label="草稿" value="0" i18n-en:label="Draft"/>
            <option code="PUBLISHED" label="已发布" value="10" i18n-en:label="Published"/>
        </dict>
        <dict label="面板类型" name="datav/panel-type" valueType="int" i18n-en:label="Panel Type">
            <option code="CHART" label="图表" value="0" i18n-en:label="Chart"/>
            <option code="TABLE" label="表格" value="10" i18n-en:label="Table"/>
            <option code="METRIC" label="指标" value="20" i18n-en:label="Metric"/>
            <option code="TEXT" label="文本" value="30" i18n-en:label="Text"/>
            <option code="CONTAINER" label="容器" value="40" i18n-en:label="Container"/>
            <option code="PIVOT_TABLE" label="透视表" value="50" i18n-en:label="Pivot Table"/>
            <option code="MAP" label="地图" value="60" i18n-en:label="Map"/>
            <option code="IFRAME" label="内嵌页面" value="70" i18n-en:label="IFrame"/>
        </dict>
    </dicts>

    <domains>
        <domain name="boolFlag" stdSqlType="TINYINT"/>
        <domain name="json-1000" precision="1000" stdDomain="json" stdSqlType="VARCHAR"/>
        <domain name="json-4000" precision="4000" stdDomain="json" stdSqlType="VARCHAR"/>
        <domain name="remark" precision="1000" stdSqlType="VARCHAR"/>
        <domain name="version" stdSqlType="BIGINT"/>
        <domain name="createTime" stdSqlType="TIMESTAMP"/>
        <domain name="createdBy" precision="50" stdSqlType="VARCHAR"/>
        <domain name="updateTime" stdSqlType="TIMESTAMP"/>
        <domain name="updatedBy" precision="50" stdSqlType="VARCHAR"/>
        <domain name="delFlag" stdDomain="boolFlag" stdSqlType="TINYINT"/>
        <domain name="clobJson" stdDomain="json" stdSqlType="CLOB"/>
    </domains>

    <entities>
        <!-- =====================================================
             NopDatavDashboard: 看板主表（控制面聚合根）
             管理权限/元数据/发布状态，编辑内容通过快照表发布
             ===================================================== -->
        <entity className="io.nop.datav.dao.entity.NopDatavDashboard" createTimeProp="createTime"
                createrProp="createdBy" displayName="看板" name="io.nop.datav.dao.entity.NopDatavDashboard"
                registerShortName="true" tableName="nop_datav_dashboard" updateTimeProp="updateTime"
                updaterProp="updatedBy" versionProp="version" ext:icon="layout-dashboard"
                i18n-en:displayName="Dashboard">
            <columns>
                <column code="DASHBOARD_ID" displayName="看板ID" mandatory="true" name="dashboardId" precision="32"
                        primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="seq"
                        i18n-en:displayName="Dashboard Id"/>
                <column code="DASHBOARD_NAME" displayName="看板名" mandatory="true" name="dashboardName" precision="100"
                        propId="2" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Dashboard Name"/>
                <column code="DISPLAY_NAME" displayName="显示名" mandatory="true" name="displayName" precision="200"
                        propId="3" stdDataType="string" stdSqlType="VARCHAR" tagSet="disp"
                        i18n-en:displayName="Display Name"/>
                <column code="DESCRIPTION" displayName="描述" name="description" precision="4000" propId="4"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Description"/>
                <column code="DASHBOARD_TYPE" displayName="看板类型" name="dashboardType" propId="5"
                        stdDataType="int" stdSqlType="INTEGER" i18n-en:displayName="Dashboard Type"
                        ext:dict="datav/dashboard-type"/>
                <column code="PUBLISH_STATUS" displayName="发布状态" name="publishStatus" propId="6"
                        stdDataType="int" stdSqlType="INTEGER" i18n-en:displayName="Publish Status"
                        ext:dict="datav/publish-status"/>
                <column code="PUBLISHED_VERSION" displayName="已发布版本" name="publishedVersion" propId="7"
                        stdDataType="long" stdSqlType="BIGINT" i18n-en:displayName="Published Version"/>
                <column code="PUBLISHED_BY" displayName="发布人" name="publishedBy" precision="50" propId="8"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Published By"/>
                <column code="PUBLISHED_TIME" displayName="发布时间" name="publishedTime" propId="9"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Published Time"/>
                <column code="LAYOUT_CONFIG" displayName="布局配置" domain="json-4000" name="layoutConfig"
                        precision="4000" propId="10" stdDataType="string" stdDomain="json" stdSqlType="VARCHAR"
                        i18n-en:displayName="Layout Config"/>
                <column code="PARAM_CONFIG" displayName="参数定义" domain="clobJson" name="paramConfig"
                        propId="18" stdDataType="string" stdDomain="json" stdSqlType="CLOB"
                        i18n-en:displayName="Param Config"/>
                <column code="DEL_FLAG" displayName="删除标记" domain="delFlag" name="delFlag" propId="11"
                        stdDataType="byte" stdSqlType="TINYINT" i18n-en:displayName="Del Flag"/>
                <column code="VERSION" displayName="数据版本" domain="version" mandatory="true" name="version"
                        propId="12" stdDataType="long" stdSqlType="BIGINT" i18n-en:displayName="Version"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="13" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true"
                        name="createTime" propId="14" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Create Time"/>
                <column code="UPDATED_BY" displayName="修改人" domain="updatedBy" mandatory="true" name="updatedBy"
                        precision="50" propId="15" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Updated By"/>
                <column code="UPDATE_TIME" displayName="修改时间" domain="updateTime" mandatory="true"
                        name="updateTime" propId="16" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Update Time"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="17"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Remark"/>
            </columns>
            <unique-keys>
                <unique-key name="UK_NOP_DATAV_DASHBOARD_NAME" columns="dashboardName"
                            i18n-en:displayName="Unique Dashboard Name"/>
            </unique-keys>
        </entity>

        <!-- =====================================================
             NopDatavPanel: 面板（归属于看板）
             ===================================================== -->
        <entity className="io.nop.datav.dao.entity.NopDatavPanel" createTimeProp="createTime"
                createrProp="createdBy" displayName="面板" name="io.nop.datav.dao.entity.NopDatavPanel"
                registerShortName="true" tableName="nop_datav_panel" updateTimeProp="updateTime"
                updaterProp="updatedBy" versionProp="version" ext:icon="panels-top-left"
                i18n-en:displayName="Panel">
            <columns>
                <column code="PANEL_ID" displayName="面板ID" mandatory="true" name="panelId" precision="32"
                        primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="seq"
                        i18n-en:displayName="Panel Id"/>
                <column code="DASHBOARD_ID" displayName="看板ID" mandatory="true" name="dashboardId"
                        precision="32" propId="2" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Dashboard Id"/>
                <column code="PANEL_NAME" displayName="面板名" mandatory="true" name="panelName" precision="100"
                        propId="3" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Panel Name"/>
                <column code="DISPLAY_NAME" displayName="显示名" name="displayName" precision="200"
                        propId="4" stdDataType="string" stdSqlType="VARCHAR" tagSet="disp"
                        i18n-en:displayName="Display Name"/>
                <column code="PANEL_TYPE" displayName="面板类型" name="panelType" propId="5"
                        stdDataType="int" stdSqlType="INTEGER" i18n-en:displayName="Panel Type"
                        ext:dict="datav/panel-type"/>
                <column code="DATASET_REF_ID" displayName="数据集引用ID" name="datasetRefId" precision="32"
                        propId="6" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Dataset Ref Id"/>
                <column code="TAB_ID" displayName="页签ID" name="tabId" precision="32" propId="7"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Tab Id"/>
                <column code="SORT_ORDER" defaultValue="0" displayName="排序" name="sortOrder" propId="8"
                        stdDataType="int" stdSqlType="INTEGER" i18n-en:displayName="Sort Order"/>
                <column code="PANEL_CONFIG" displayName="面板配置" domain="json-4000" name="panelConfig"
                        precision="4000" propId="9" stdDataType="string" stdDomain="json" stdSqlType="VARCHAR"
                        i18n-en:displayName="Panel Config"/>
                <column code="DEL_FLAG" displayName="删除标记" domain="delFlag" name="delFlag" propId="10"
                        stdDataType="byte" stdSqlType="TINYINT" i18n-en:displayName="Del Flag"/>
                <column code="VERSION" displayName="数据版本" domain="version" mandatory="true" name="version"
                        propId="11" stdDataType="long" stdSqlType="BIGINT" i18n-en:displayName="Version"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="12" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true"
                        name="createTime" propId="13" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Create Time"/>
                <column code="UPDATED_BY" displayName="修改人" domain="updatedBy" mandatory="true" name="updatedBy"
                        precision="50" propId="14" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Updated By"/>
                <column code="UPDATE_TIME" displayName="修改时间" domain="updateTime" mandatory="true"
                        name="updateTime" propId="15" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Update Time"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="16"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Remark"/>
            </columns>
            <relations>
                <to-one displayName="看板" name="dashboard"
                        refEntityName="io.nop.datav.dao.entity.NopDatavDashboard" tagSet="pub,ref-pub"
                        i18n-en:displayName="Dashboard">
                    <join>
                        <on leftProp="dashboardId" rightProp="dashboardId"/>
                    </join>
                </to-one>
            </relations>
            <indexes>
                <index name="IX_NOP_DATAV_PANEL_DASHBOARD" unique="false">
                    <column name="dashboardId"/>
                </index>
            </indexes>
        </entity>

        <!-- =====================================================
             NopDatavDashboardTab: 页签（归属于看板）
             ===================================================== -->
        <entity className="io.nop.datav.dao.entity.NopDatavDashboardTab" createTimeProp="createTime"
                createrProp="createdBy" displayName="页签" name="io.nop.datav.dao.entity.NopDatavDashboardTab"
                registerShortName="true" tableName="nop_datav_tab" updateTimeProp="updateTime"
                updaterProp="updatedBy" versionProp="version" ext:icon="tabs"
                i18n-en:displayName="Dashboard Tab">
            <columns>
                <column code="TAB_ID" displayName="页签ID" mandatory="true" name="tabId" precision="32"
                        primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="seq"
                        i18n-en:displayName="Tab Id"/>
                <column code="DASHBOARD_ID" displayName="看板ID" mandatory="true" name="dashboardId"
                        precision="32" propId="2" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Dashboard Id"/>
                <column code="TAB_NAME" displayName="页签名" mandatory="true" name="tabName" precision="100"
                        propId="3" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Tab Name"/>
                <column code="DISPLAY_NAME" displayName="显示名" name="displayName" precision="200"
                        propId="4" stdDataType="string" stdSqlType="VARCHAR" tagSet="disp"
                        i18n-en:displayName="Display Name"/>
                <column code="SORT_ORDER" defaultValue="0" displayName="排序" name="sortOrder" propId="5"
                        stdDataType="int" stdSqlType="INTEGER" i18n-en:displayName="Sort Order"/>
                <column code="TAB_CONFIG" displayName="页签配置" domain="json-4000" name="tabConfig"
                        precision="4000" propId="6" stdDataType="string" stdDomain="json" stdSqlType="VARCHAR"
                        i18n-en:displayName="Tab Config"/>
                <column code="DEL_FLAG" displayName="删除标记" domain="delFlag" name="delFlag" propId="7"
                        stdDataType="byte" stdSqlType="TINYINT" i18n-en:displayName="Del Flag"/>
                <column code="VERSION" displayName="数据版本" domain="version" mandatory="true" name="version"
                        propId="8" stdDataType="long" stdSqlType="BIGINT" i18n-en:displayName="Version"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="9" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true"
                        name="createTime" propId="10" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Create Time"/>
                <column code="UPDATED_BY" displayName="修改人" domain="updatedBy" mandatory="true" name="updatedBy"
                        precision="50" propId="11" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Updated By"/>
                <column code="UPDATE_TIME" displayName="修改时间" domain="updateTime" mandatory="true"
                        name="updateTime" propId="12" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Update Time"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="13"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Remark"/>
            </columns>
            <relations>
                <to-one displayName="看板" name="dashboard"
                        refEntityName="io.nop.datav.dao.entity.NopDatavDashboard" tagSet="pub,ref-pub"
                        i18n-en:displayName="Dashboard">
                    <join>
                        <on leftProp="dashboardId" rightProp="dashboardId"/>
                    </join>
                </to-one>
            </relations>
            <indexes>
                <index name="IX_NOP_DATAV_TAB_DASHBOARD" unique="false">
                    <column name="dashboardId"/>
                </index>
            </indexes>
        </entity>

        <!-- =====================================================
             NopDatavDatasetRef: 数据集引用（归属于看板）
             仅存储所引用的 nop-report 数据集标识 + 参数映射，不在此实现运行时查询委托
             ===================================================== -->
        <entity className="io.nop.datav.dao.entity.NopDatavDatasetRef" createTimeProp="createTime"
                createrProp="createdBy" displayName="数据集引用" name="io.nop.datav.dao.entity.NopDatavDatasetRef"
                registerShortName="true" tableName="nop_datav_dataset_ref" updateTimeProp="updateTime"
                updaterProp="updatedBy" versionProp="version" ext:icon="database"
                i18n-en:displayName="Dataset Ref">
            <columns>
                <column code="DATASET_REF_ID" displayName="数据集引用ID" mandatory="true" name="datasetRefId"
                        precision="32" primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR"
                        tagSet="seq" i18n-en:displayName="Dataset Ref Id"/>
                <column code="DASHBOARD_ID" displayName="看板ID" mandatory="true" name="dashboardId"
                        precision="32" propId="2" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Dashboard Id"/>
                <column code="REF_DATASET_ID" displayName="引用数据集ID" mandatory="true" name="refDatasetId"
                        precision="100" propId="3" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Ref Dataset Id"/>
                <column code="REF_DATASET_NAME" displayName="引用数据集名" name="refDatasetName" precision="200"
                        propId="4" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Ref Dataset Name"/>
                <column code="PARAM_MAPPING" displayName="参数映射" domain="json-4000" name="paramMapping"
                        precision="4000" propId="5" stdDataType="string" stdDomain="json" stdSqlType="VARCHAR"
                        i18n-en:displayName="Param Mapping"/>
                <column code="DEL_FLAG" displayName="删除标记" domain="delFlag" name="delFlag" propId="6"
                        stdDataType="byte" stdSqlType="TINYINT" i18n-en:displayName="Del Flag"/>
                <column code="VERSION" displayName="数据版本" domain="version" mandatory="true" name="version"
                        propId="7" stdDataType="long" stdSqlType="BIGINT" i18n-en:displayName="Version"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="8" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true"
                        name="createTime" propId="9" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Create Time"/>
                <column code="UPDATED_BY" displayName="修改人" domain="updatedBy" mandatory="true" name="updatedBy"
                        precision="50" propId="10" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Updated By"/>
                <column code="UPDATE_TIME" displayName="修改时间" domain="updateTime" mandatory="true"
                        name="updateTime" propId="11" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Update Time"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="12"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Remark"/>
            </columns>
            <relations>
                <to-one displayName="看板" name="dashboard"
                        refEntityName="io.nop.datav.dao.entity.NopDatavDashboard" tagSet="pub,ref-pub"
                        i18n-en:displayName="Dashboard">
                    <join>
                        <on leftProp="dashboardId" rightProp="dashboardId"/>
                    </join>
                </to-one>
            </relations>
            <indexes>
                <index name="IX_NOP_DATAV_DATASET_REF_DASHBOARD" unique="false">
                    <column name="dashboardId"/>
                </index>
            </indexes>
        </entity>

        <!-- =====================================================
             NopDatavDashboardSnapshot: 发布快照（独立表，管已发布内容）
             发布时将看板编辑内容序列化为快照写入此表
             ===================================================== -->
        <entity className="io.nop.datav.dao.entity.NopDatavDashboardSnapshot" createTimeProp="createTime"
                createrProp="createdBy" displayName="发布快照"
                name="io.nop.datav.dao.entity.NopDatavDashboardSnapshot"
                registerShortName="true" tableName="nop_datav_snapshot" updateTimeProp="updateTime"
                updaterProp="updatedBy" versionProp="version" ext:icon="git-commit-horizontal"
                i18n-en:displayName="Dashboard Snapshot">
            <columns>
                <column code="SNAPSHOT_ID" displayName="快照ID" mandatory="true" name="snapshotId" precision="32"
                        primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="seq"
                        i18n-en:displayName="Snapshot Id"/>
                <column code="DASHBOARD_ID" displayName="看板ID" mandatory="true" name="dashboardId"
                        precision="32" propId="2" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Dashboard Id"/>
                <column code="SNAPSHOT_VERSION" displayName="快照版本" mandatory="true" name="snapshotVersion"
                        propId="3" stdDataType="long" stdSqlType="BIGINT"
                        i18n-en:displayName="Snapshot Version"/>
                <column code="SNAPSHOT_CONTENT" displayName="快照内容" domain="clobJson" name="snapshotContent"
                        propId="4" stdDataType="string" stdDomain="json" stdSqlType="CLOB"
                        i18n-en:displayName="Snapshot Content"/>
                <column code="PUBLISHED_BY" displayName="发布人" name="publishedBy" precision="50" propId="5"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Published By"/>
                <column code="PUBLISHED_TIME" displayName="发布时间" name="publishedTime" propId="6"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Published Time"/>
                <column code="DEL_FLAG" displayName="删除标记" domain="delFlag" name="delFlag" propId="7"
                        stdDataType="byte" stdSqlType="TINYINT" i18n-en:displayName="Del Flag"/>
                <column code="VERSION" displayName="数据版本" domain="version" mandatory="true" name="version"
                        propId="8" stdDataType="long" stdSqlType="BIGINT" i18n-en:displayName="Version"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="9" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true"
                        name="createTime" propId="10" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Create Time"/>
                <column code="UPDATED_BY" displayName="修改人" domain="updatedBy" mandatory="true" name="updatedBy"
                        precision="50" propId="11" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Updated By"/>
                <column code="UPDATE_TIME" displayName="修改时间" domain="updateTime" mandatory="true"
                        name="updateTime" propId="12" stdDataType="timestamp" stdSqlType="TIMESTAMP"
                        i18n-en:displayName="Update Time"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="13"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Remark"/>
            </columns>
            <relations>
                <to-one displayName="看板" name="dashboard"
                        refEntityName="io.nop.datav.dao.entity.NopDatavDashboard" tagSet="pub,ref-pub"
                        i18n-en:displayName="Dashboard">
                    <join>
                        <on leftProp="dashboardId" rightProp="dashboardId"/>
                    </join>
                </to-one>
            </relations>
            <unique-keys>
                <unique-key name="UK_NOP_DATAV_SNAPSHOT_DASH_VER" columns="dashboardId,snapshotVersion"
                            i18n-en:displayName="Unique Snapshot Per Dashboard Version"/>
            </unique-keys>
            <indexes>
                <index name="IX_NOP_DATAV_SNAPSHOT_DASHBOARD" unique="false">
                    <column name="dashboardId"/>
                </index>
            </indexes>
        </entity>

        <!-- =====================================================
             NopDatavFilterState: 看板筛选/联动状态（per userName + dashboardId）
             保存用户在某看板上的当前筛选值 + 联动选择，支持按用户+看板恢复
             ===================================================== -->
        <entity className="io.nop.datav.dao.entity.NopDatavFilterState" createTimeProp="createTime"
