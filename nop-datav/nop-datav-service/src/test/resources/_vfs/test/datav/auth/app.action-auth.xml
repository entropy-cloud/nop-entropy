<?xml version="1.0" encoding="UTF-8" ?>
<!-- Test-specific action-auth.xml for nop-datav-service auth integration tests.
     Self-contained (does not extend the generated _nop-datav.action-auth.xml which lives in nop-datav-web).
     Declares FNPT permission-point resources with static role bindings (roles attribute). -->
<auth x:schema="/nop/schema/action-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <site id="main">
        <resource id="test-orm-nop-datav" displayName="测试nop-datav" resourceType="TOPM" orderNo="10000">
            <children>
                <resource id="NopDatavDashboard-main" displayName="看板" resourceType="SUBM" orderNo="10001">
                    <children>
                        <resource id="FNPT:NopDatavDashboard:query" displayName="查询看板" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavDashboard:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboard:mutation" displayName="修改看板" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavDashboard:mutation</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboard:publishDashboard" displayName="发布看板" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavDashboard:publishDashboard</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboard:getPublishedDashboard" displayName="查看已发布看板"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavDashboard:getPublishedDashboard</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboard:rollbackDashboard" displayName="回滚看板" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavDashboard:rollbackDashboard</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboard:resolveFilterValues" displayName="解析筛选值"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavDashboard:resolveFilterValues</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboard:parseFilterFromUrl" displayName="URL筛选解析"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavDashboard:parseFilterFromUrl</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopDatavPanel-main" displayName="面板" resourceType="SUBM" orderNo="10002">
                    <children>
                        <resource id="FNPT:NopDatavPanel:query" displayName="查询面板" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavPanel:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavPanel:mutation" displayName="修改面板" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavPanel:mutation</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavPanel:getPanelData" displayName="查询面板数据" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavPanel:getPanelData</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavPanel:refreshPanel" displayName="刷新面板数据" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavPanel:refreshPanel</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavPanel:resolveLinkage" displayName="图表联动" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavPanel:resolveLinkage</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavPanel:resolveJump" displayName="图表跳转" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavPanel:resolveJump</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopDatavFilterState-main" displayName="筛选状态" resourceType="SUBM" orderNo="10003">
                    <children>
                        <resource id="FNPT:NopDatavFilterState:query" displayName="查询筛选状态" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavFilterState:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavFilterState:mutation" displayName="修改筛选状态" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavFilterState:mutation</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavFilterState:saveFilterState" displayName="保存筛选状态"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavFilterState:saveFilterState</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavFilterState:getFilterState" displayName="获取筛选状态" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavFilterState:getFilterState</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopDatavDashboardSnapshot-main" displayName="发布快照" resourceType="SUBM" orderNo="10004">
                    <children>
                        <resource id="FNPT:NopDatavDashboardSnapshot:query" displayName="查询发布快照" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavDashboardSnapshot:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboardSnapshot:mutation" displayName="修改发布快照" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavDashboardSnapshot:mutation</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopDatavExportTask-main" displayName="导出任务" resourceType="SUBM" orderNo="10005">
                    <children>
                        <!-- plan {1} D1 偏离裁定：CRUD query/mutation 仅绑 admin（不绑 user），
                             与 NopDatavDashboardShare 对称。production nop-datav.action-auth.xml 同。 -->
                        <resource id="FNPT:NopDatavExportTask:query" displayName="查询导出任务" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavExportTask:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavExportTask:mutation" displayName="修改导出任务" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavExportTask:mutation</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavExportTask:createExportTask" displayName="发起导出" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavExportTask:createExportTask</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavExportTask:getExportTask" displayName="查询导出任务状态"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavExportTask:getExportTask</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavExportTask:cancelExportTask" displayName="取消导出任务" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavExportTask:cancelExportTask</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavExportTask:downloadExportFile" displayName="下载导出文件"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavExportTask:downloadExportFile</permissions>
                        </resource>
                    </children>
                </resource>
                <!-- plan {1}：NopDatavDashboardShare-main 与 production nop-datav.action-auth.xml 对称 -->
                <resource id="NopDatavDashboardShare-main" displayName="看板分享" resourceType="SUBM" orderNo="10007">
                    <children>
                        <!-- D1 偏离裁定：CRUD query/mutation 仅绑 admin（不绑 user），与 ExportTask 对称 -->
                        <resource id="FNPT:NopDatavDashboardShare:query" displayName="查询看板分享" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavDashboardShare:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboardShare:mutation" displayName="修改看板分享" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavDashboardShare:mutation</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboardShare:createShare" displayName="创建分享" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavDashboardShare:createShare</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboardShare:listShares" displayName="查询分享列表"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavDashboardShare:listShares</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboardShare:revokeShare" displayName="吊销分享" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavDashboardShare:revokeShare</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavDashboardShare:toggleShare" displayName="切换分享启用"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavDashboardShare:toggleShare</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopDatavScreen-main" displayName="大屏" resourceType="SUBM" orderNo="10006">
                    <children>
                        <resource id="FNPT:NopDatavScreen:query" displayName="查询大屏" resourceType="FNPT"
                                  roles="admin,user">
                            <permissions>NopDatavScreen:query</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavScreen:mutation" displayName="修改大屏" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavScreen:mutation</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavScreen:publishScreen" displayName="发布大屏" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavScreen:publishScreen</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavScreen:getPublishedScreen" displayName="查看已发布大屏"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavScreen:getPublishedScreen</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavScreen:rollbackScreen" displayName="回滚大屏" resourceType="FNPT"
                                  roles="admin">
                            <permissions>NopDatavScreen:rollbackScreen</permissions>
                        </resource>
                        <resource id="FNPT:NopDatavScreen:getScreenLayout" displayName="获取大屏布局"
                                  resourceType="FNPT" roles="admin,user">
                            <permissions>NopDatavScreen:getScreenLayout</permissions>
                        </resource>
                    </children>
                </resource>
            </children>
        </resource>
    </site>
</auth>
