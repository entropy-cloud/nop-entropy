<?xml version="1.0" encoding="UTF-8" ?>
<data-auth x:schema="/nop/schema/data-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <objs>
        <obj name="NopDatavDashboard">
            <role-auths>
                <role-auth id="admin" roleIds="admin">
                </role-auth>
                <role-auth id="user" roleIds="user">
                    <filter>
                        <or>
                            <eq name="createdBy" value="${$context.userName}"/>
                            <eq name="publishStatus" value="10"/>
                        </or>
                    </filter>
                </role-auth>
            </role-auths>
        </obj>
        <obj name="NopDatavScreen">
            <role-auths>
                <role-auth id="admin" roleIds="admin">
                </role-auth>
                <role-auth id="user" roleIds="user">
                    <filter>
                        <or>
                            <eq name="createdBy" value="${$context.userName}"/>
                            <eq name="publishStatus" value="10"/>
                        </or>
                    </filter>
                </role-auth>
            </role-auths>
        </obj>
    </objs>
</data-auth>
