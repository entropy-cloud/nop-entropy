    <bean id="io.nop.datav.service.entity.NopDatavDatasetRefBizModel" ioc:type="@bean:id" ioc:default="true"/>

    <bean id="biz_NopDatavDatasetRef" class="io.nop.biz.proxy.BizProxyFactoryBean"
          ioc:type="io.nop.datav.biz.INopDatavDatasetRefBiz" ioc:force-lazy-property="true" lazy-init="true"
          primary="true">
        <property name="bizObjName" value="NopDatavDatasetRef"/>
    </bean>

    <bean id="io.nop.datav.service.entity.NopDatavDashboardSnapshotBizModel" ioc:type="@bean:id" ioc:default="true"/>

