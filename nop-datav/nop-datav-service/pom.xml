<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <artifactId>nop-datav</artifactId>
        <groupId>io.github.entropy-cloud</groupId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>nop-datav-service</artifactId>

    <dependencies>
        <dependency>
            <artifactId>nop-datav-dao</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
        </dependency>

        <dependency>
            <artifactId>nop-datav-meta</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
        </dependency>

        <!-- 引入 nop-report-dao 以读取 NopReportDataset 配置（dsType/dsText）。
             仅依赖 -dao 层，不引入 nop-report-core/nop-report-service，避免拉入 XPT 引擎和渲染器。 -->
        <dependency>
            <artifactId>nop-report-dao</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-biz</artifactId>
        </dependency>
        <!-- nop-biz-auth-core: 提供 IPasswordEncoder (bean nopPasswordEncoder = CompositePasswordEncoder:
             SHA256 预哈希 + BCrypt 外层) 用于分享密码哈希存储。分享密码绕过 nopPasswordPolicy。 -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-biz-auth-core</artifactId>
        </dependency>
        <!-- nop-file-dao: 拉入 nopFileStore bean（DaoResourceFileStore，ioc:default=true）、
             NopFileRecord 实体、传递 nop-biz-file-core 的 IFileStore/IFileRecord/UploadRequestBean。
             用于 D3-3 数据导出文件落盘与下载。 -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-file-dao</artifactId>
        </dependency>
        <!-- nop-excel: ExcelWorkbook/ExcelSheet/ExcelRow/ExcelCell 模型（D3-3 xlsx 导出构造工作簿） -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-excel</artifactId>
        </dependency>
        <!-- nop-ooxml-xlsx: ExcelHelper.saveExcel(IResource, ExcelWorkbook) 写出 .xlsx（D3-3 xlsx 导出） -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ooxml-xlsx</artifactId>
        </dependency>
        <!-- nop-sys-dao: NopSysNoticeTemplate 实体访问（D5-1 定时报告通知模板渲染）。
             通知走 nop-integration(IEmailSender) + nop-sys(NopSysNoticeTemplate)，
             非 nop-message（pub-sub 总线，与用户通知语义不符）——见 schedule-report-design.md §1。 -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-sys-dao</artifactId>
        </dependency>
        <!-- nop-job-api: IJobScheduler / JobSpec / TriggerSpec 接口（D5-1 定时报告 cron 调度）。
             Runtime impl 由宿主 app 经 app-local-scheduler.beans.xml 提供（可空注入，scheduler==null 时禁用调度）。
             镜像 MetaQualityCheckpointScheduler（nop-metadata-service）的集成范式——见 schedule-report-design.md §3。 -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-job-api</artifactId>
        </dependency>
        <!-- nop-ai-api: 新非废弃 ChatBI API（IChatService/ChatRequest/ChatResponse/ChatToolDefinition/ChatToolCall）。
             D6-1 ChatBI 经 IChatService.call 实现 LLM tool-calling 循环。拒 @Deprecated 的 IAiChatService。 -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ai-api</artifactId>
        </dependency>
        <!-- nop-ai-toolkit: 工具发现与执行（IToolManager/IToolExecutor/IToolExecuteContext/AiToolCall/AiToolCallResult/AiToolModel）。
             ChatBI 3 个 datav-* 工具经 IToolExecutor 实现注册，被 nopToolExecutorProvider 自动收集。
             不引入 nop-ai-agent（类型转换逻辑参考 AgentToolDispatcher/ToolSchemaConverter 但内联复制）。 -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ai-toolkit</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ioc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-rpc-cluster</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Auth beans (nopActionAuthChecker / nopDataAuthChecker / nopGraphQLLogger / nopAuditService)
             needed for enableActionAuth / enableDataAuth / enable-audit integration tests -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-auth-service</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- nop-job-local (test scope): LocalJobScheduler / BeanMethodJobInvoker beans for e2e AutoTest
             (D5-1 定时报告 cron 调度端到端测试). Production runtime supplies the scheduler via host app. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-job-local</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-autotest-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
