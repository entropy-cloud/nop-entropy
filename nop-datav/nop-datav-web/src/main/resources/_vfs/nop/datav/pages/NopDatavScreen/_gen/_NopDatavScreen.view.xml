<?xml version="1.0" encoding="UTF-8" ?>
<view x:schema="/nop/schema/xui/xview.xdef" bizObjName="NopDatavScreen" xmlns:i18n-en="i18n-en"
      xmlns:x="/nop/schema/xdsl.xdef" xmlns:j="j" xmlns:c="c" xmlns:gql="gql" xmlns:view-gen="view-gen" xmlns:xpl="xpl">

    <objMeta>/nop/datav/model/NopDatavScreen/NopDatavScreen.xmeta</objMeta>

    <controlLib>/nop/web/xlib/control.xlib</controlLib>

    <x:gen-extends>
        <view-gen:DefaultViewGenExtends xpl:lib="/nop/web/xlib/view-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <view-gen:DefaultViewPostExtends xpl:lib="/nop/web/xlib/view-gen.xlib"/>
    </x:post-extends>

    <grids>
        <grid id="list" x:abstract="true">
            <cols>

                <!--大屏ID-->
                <col id="screenId" mandatory="true" sortable="true"/>

                <!--大屏名-->
                <col id="screenName" mandatory="true" sortable="true"/>

                <!--显示名-->
                <col id="displayName" mandatory="true" sortable="true"/>

                <!--描述-->
                <col id="description" sortable="true"/>

                <!--画布宽度-->
                <col id="screenWidth" mandatory="true" ui:number="true" sortable="true"/>

                <!--画布高度-->
                <col id="screenHeight" mandatory="true" ui:number="true" sortable="true"/>

                <!--适配模式-->
                <col id="adaptorMode" ui:number="true" sortable="true"/>

                <!--背景配置-->
                <col id="backgroundConfig" sortable="true"/>

                <!--发布状态-->
                <col id="publishStatus" ui:number="true" sortable="true"/>

                <!--已发布版本-->
                <col id="publishedVersion" ui:number="true" sortable="true"/>

                <!--发布人-->
                <col id="publishedBy" sortable="true"/>

                <!--发布时间-->
                <col id="publishedTime" sortable="true"/>

                <!--删除标记-->
                <col id="delFlag" sortable="true"/>

                <!--创建人-->
                <col id="createdBy" mandatory="true" sortable="true"/>

                <!--创建时间-->
                <col id="createTime" mandatory="true" sortable="true"/>

                <!--修改人-->
                <col id="updatedBy" mandatory="true" sortable="true"/>

                <!--修改时间-->
                <col id="updateTime" mandatory="true" sortable="true"/>

                <!--备注-->
                <col id="remark" sortable="true"/>
            </cols>
        </grid>
        <grid id="pick-list" x:prototype="list" x:abstract="true"/>
    </grids>

    <forms>
        <form id="view" editMode="view" title="查看-大屏" i18n-en:title="View Screen">
            <layout>
 screenId[大屏ID] screenName[大屏名]
 displayName[显示名] description[描述]
 screenWidth[画布宽度] screenHeight[画布高度]
 adaptorMode[适配模式] backgroundConfig[背景配置]
 publishStatus[发布状态] publishedVersion[已发布版本]
 publishedBy[发布人] publishedTime[发布时间]
 delFlag[删除标记] createdBy[创建人]
 createTime[创建时间] updatedBy[修改人]
 updateTime[修改时间] remark[备注]
</layout>
        </form>
        <form id="add" editMode="add" title="新增-大屏" i18n-en:title="Add Screen" x:prototype="edit"/>
        <form id="edit" editMode="edit" title="编辑-大屏" i18n-en:title="Edit Screen">
            <layout>
 screenId[大屏ID] screenName[大屏名]
 displayName[显示名] description[描述]
 screenWidth[画布宽度] screenHeight[画布高度]
 adaptorMode[适配模式] backgroundConfig[背景配置]
 publishStatus[发布状态] publishedVersion[已发布版本]
 publishedBy[发布人] publishedTime[发布时间]
 delFlag[删除标记] remark[备注]
</layout>
        </form>
        <form id="query" editMode="query" title="查询条件" i18n-en:title="Query Condition" x:abstract="true"/>
        <form id="asideFilter" editMode="query" x:abstract="true" submitOnChange="true"/>
        <form id="batchUpdate" editMode="edit" x:abstract="true" title="修改-大屏" i18n-en:title="Update Screen"/>
    </forms>

    <pages>
        <crud name="view-list" grid="list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table autoFillHeight="true">
                <api url="@query:NopDatavScreen__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </crud>
        <crud name="main" grid="list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table autoFillHeight="true">
                <api url="@query:NopDatavScreen__findPage" gql:selection="{@pageSelection}"/>
            </table>
            <listActions>
                <action id="batch-delete-button" label="@i18n:common.batchDelete" batch="true">
                    <api url="@mutation:NopDatavScreen__batchDelete?ids=${ids}"/>
                    <confirmText>@i18n:common.confirmBatchDelete</confirmText>
                </action>
                <action id="add-button" level="primary" label="@i18n:common.add" icon="fa fa-plus pull-left">
                    <dialog page="add"/>
                </action>
            </listActions>
            <rowActions>
                <action id="row-view-button" level="primary" label="@i18n:common.view">
                    <dialog page="view"/>
                </action>
                <action id="row-update-button" level="primary" label="@i18n:common.edit" x:abstract="true">
                    <dialog page="update"/>
                </action>
                <action id="row-delete-button" level="danger" label="@i18n:common.delete" x:abstract="true">
                    <api url="@mutation:NopDatavScreen__delete?id=${id}"/>
                    <confirmText>@i18n:common.confirmDelete</confirmText>
                </action>
                <actionGroup id="row-more-button" label="@i18n:common.more" level="primary">
                    <action id="row-update-button" label="@i18n:common.edit">
                        <dialog page="update"/>
                    </action>
                    <action id="row-delete-button" label="@i18n:common.delete">
                        <api url="@mutation:NopDatavScreen__delete?id=${id}"/>
                        <confirmText>@i18n:common.confirmDelete</confirmText>
                    </action>
                </actionGroup>
            </rowActions>
        </crud>
        <picker name="picker" grid="pick-list" asideFilterForm="asideFilter" filterForm="query" x:abstract="true">
            <table noOperations="true">
                <api url="@query:NopDatavScreen__findPage" gql:selection="{@pageSelection}"/>
            </table>
        </picker>
        <simple name="add" form="add">
            <api url="@mutation:NopDatavScreen__save/id"/>
        </simple>
        <simple name="view" form="view">
            <initApi url="@query:NopDatavScreen__get?id=${id}" gql:selection="{@formSelection}"/>
        </simple>
        <simple name="update" form="edit">
            <initApi url="@query:NopDatavScreen__get?id=${id}" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopDatavScreen__update/id?id=${id}" withFormData="true"/>
        </simple>
    </pages>
</view>