<!--
            @scale 放大百分比
            @paperSize 为ooxml中定义的标准页面大小。如果设置了paperWidth和paperHeight时，以这两个值为准
            @paperWidth 单位为pt
            @repeatTitleRows 重复标题行范围（1-based 闭区间，如 "1:2"），来自 Print_Titles definedNames
            @repeatTitleCols 重复标题列范围（1-based 闭区间，如 "A:B"），来自 Print_Titles definedNames
            @fitToWidth 缩放到 N 页宽（目标页数，0或缺省=该维不约束）
            @fitToHeight 缩放到 M 页高（目标页数，0或缺省=该维不约束）
            @differentFirst 首页使用不同的页眉页脚（OOXML headerFooter@differentFirst 的模型级映射）
            @differentOddEven 奇偶页使用不同的页眉页脚（OOXML headerFooter@differentOddEven 的模型级映射）
            -->
<pageSetup x:schema="/nop/schema/xdef.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
           xdef:name="ExcelPageSetup" xdef:bean-package="io.nop.excel.model"
           orientationHorizontal="boolean"
           horizontalCentered="boolean" verticalCentered="boolean"
           paperSize="int" paperWidth="float" paperHeight="float" scale="int"
           fitToHeight="int" fitToWidth="int" gridLines="boolean"
           firstPageNumber="int" blackAndWhite="boolean"
           repeatTitleRows="string" repeatTitleCols="string"
           differentFirst="boolean" differentOddEven="boolean">
    <header xdef:name="ExcelHeaderFooter" imageName="string">
        <!--
        @imageName &G 图片（logo）引用的 sheet 具名图片（sheet/images/name）；空缺省取第一张
        -->
        <left>string</left>
        <center>string</center>
        <right>string</right>
        <leftExpr>xpl</leftExpr>
        <centerExpr>xpl</centerExpr>
        <rightExpr>xpl</rightExpr>
        <style xdef:ref="style.xdef"/>
    </header>

    <footer xdef:ref="ExcelHeaderFooter"/>

    <firstHeader xdef:ref="ExcelHeaderFooter"/>
    <firstFooter xdef:ref="ExcelHeaderFooter"/>
    <evenHeader xdef:ref="ExcelHeaderFooter"/>
    <evenFooter xdef:ref="ExcelHeaderFooter"/>
</pageSetup>