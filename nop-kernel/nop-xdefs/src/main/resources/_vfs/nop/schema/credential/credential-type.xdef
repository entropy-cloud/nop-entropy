<?xml version="1.0" encoding="UTF-8" ?>
<!--
    凭证类型元模型定义。用于校验和编辑器支持。

    注意：本 xdef 不声明 xdef:bean-package —— CredentialType 模型在 nop-credential-api 中手写，
    以保持 api 模块轻量（无 codegen 依赖）。本 schema 仅用于结构校验和编辑器辅助。

    根元素 credential-type 描述一种凭证类型（如 openai-api-key、generic-secret），
    其 fields/field 子元素声明该类型凭证的字段集合（用于动态表单渲染与脱敏判定）。
-->
<credential-type x:schema="/nop/schema/xdef.xdef" xmlns:x="/nop/schema/xdsl.xdef"
                 xdef:name="CredentialTypeModel"
                 name="!string" version="string" displayName="string"
                 authType="string" testUrl="string" testAuth="string">

    <!--
    字段集合。每个 field 描述凭证的一个字段（如 apiKey、orgId、secret）。
    @type 枚举：string | password | number | select | boolean | textarea
    @sensitive 为 true 的字段在 mask() 时以 **** 替换，不可见于明文边界之外
    -->
    <fields xdef:body-type="list" xdef:key-attr="name">
        <field name="!string" label="string" type="string" sensitive="boolean"
               defaultValue="string" required="boolean"
               xdef:name="CredentialFieldModel" xdef:unique-attr="name"/>
    </fields>

</credential-type>
