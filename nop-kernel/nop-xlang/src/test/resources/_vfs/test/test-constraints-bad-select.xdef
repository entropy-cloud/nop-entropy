                 xmlns:xdef="/nop/schema/xdef.xdef">

    <xdef:check-unique id="badSelect" select="//items/[[[" prop="name"/>

    <items xdef:body-type="list">
        <item name="!xml-name"/>
    </items>
</constraint-test>
