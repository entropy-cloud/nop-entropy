<?xml version="1.0" encoding="UTF-8" ?>
<ref-test x:schema="/nop/schema/xdef.xdef" xmlns:x="/nop/schema/xdsl.xdef"
          xmlns:xdef="/nop/schema/xdef.xdef">

    <xdef:check-unique id="uniqueStepName" select="/ref-test/steps/step" prop="name"/>
    <xdef:check-ref id="dependsRef" select="/ref-test/steps/step" prop="depends" targetProp="name"
                    disallowSelf="true"/>

    <steps xdef:body-type="list" xdef:key-attr="name">
        <step name="!xml-name" depends="csv-list"/>
    </steps>
</ref-test>
