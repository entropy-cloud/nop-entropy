<?xml version="1.0" encoding="UTF-8" ?>
<constraint-test x:schema="/nop/schema/xdef.xdef" xmlns:x="/nop/schema/xdsl.xdef"
                 xmlns:xdef="/nop/schema/xdef.xdef">

    <xdef:check-unique id="dupRule" select="//items/item" prop="name"/>
    <xdef:check-mutex id="dupRule" select="//items/item" props="a,b"/>

    <items xdef:body-type="list">
        <item name="!xml-name" a="string" b="string"/>
    </items>
</constraint-test>
