<transform x:schema="/nop/schema/xt.xdef"
           xmlns:x="/nop/schema/xdsl.xdef"
           xmlns:xt="/nop/schema/xt.xdef">
    <main>
        <result>
            <xt:choose>
                <when id="a" test="${@type=='A'}">
                    <typeA/>
                </when>
                <when id="b" test="${@type=='B'}">
                    <typeB/>
                </when>
                <otherwise>
                    <unknown/>
                </otherwise>
            </xt:choose>
        </result>
    </main>
</transform>
