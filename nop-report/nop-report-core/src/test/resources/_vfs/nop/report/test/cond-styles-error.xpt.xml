<?xml version="1.0" encoding="UTF-8" ?>
<workbook x:schema="/nop/schema/excel/workbook.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <sheets>
        <sheet name="s1">
            <table>
                <rows>
                    <row>
                        <cells>
                            <cell name="A2" type="string">
                                <value>x</value>
                                <model expandType="r" field="amount">
                                    <expandExpr>list</expandExpr>
                                    <condStyles>
                                        <condStyle styleId="s">
                                            <expr>int(&quot;abc&quot;) &gt; 1</expr>
                                        </condStyle>
                                    </condStyles>
                                </model>
                            </cell>
                        </cells>
                    </row>
                </rows>
            </table>
        </sheet>
    </sheets>
</workbook>
