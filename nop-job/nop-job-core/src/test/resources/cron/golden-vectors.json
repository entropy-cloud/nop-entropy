    "consumers": {
      "java": "nop-entropy nop-job-core src/test/resources/cron/golden-vectors.json（本文件副本，C2 落地；C7 哈希对账）",
      "ts": "@nop-chaos/flux-renderers-form src/cron（相对路径直接 import 本文件，C4 落地）"
    },
    "conventions": {
      "timezone": "全部 nextRun/repeat/range 用例固定 UTC；ISO-8601 形如 YYYY-MM-DDTHH:mm:ssZ",
      "expectNext": "自 after 起迭代 nextRun/getTimeAfter 恰好 expectNext.length 次，结果必须逐条相等且严格递增；种子命中时引擎取严格晚于种子的下一时刻（+1s 语义）",
      "exhausted": "向量节可选 expectExhaustedAfter：自该时刻再迭代一次必须返回终止（Java -1 / TS null）；expectNext 为空数组 = 种子后立即终止",
      "countEpoch": "range.count 计数窗口自 range.start 起算（绝对语义，不随 after 重置）；start 缺省回退引擎纪元 1970-01-01T00:00:00Z",
      "repeatAnchor": "repeat 过滤以引擎时区日历日计：fire 当地日期 >= anchor 且 (day 单位：整日差 mod every == 0；week 单位：floor(整日差/7) mod every == 0)；anchor 缺省回退 range.start",
      "wRule": "W 就近工作日不跨月回退/前进（8 月 1 日周六 → 8 月 3 日周一）；周位单独 L = 周六（Quartz 语义）",
      "asymmetry": "tsCode=impossible 且 javaValid=true 的条目：Java 构造期 BitSet 解析通过、运行期 runaway 异常；编辑器前置拦截（design §2.1），Java 端行为不变",
      "fieldCountRule": "5 段输入主判码 fieldCount（5 段 Unix 方言整体不支持，见 design §2.1「不支持」节）"
    }
  },
