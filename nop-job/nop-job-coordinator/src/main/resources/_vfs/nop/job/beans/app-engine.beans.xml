<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <import resource="_engine.beans.xml"/>

    <bean id="io.nop.job.api.retry.IJobRetryBridge"
          class="io.nop.job.coordinator.retry.NoOpJobRetryBridge"/>

    <bean id="io.nop.job.api.alarm.IJobAlarmHandler"
          class="io.nop.job.coordinator.alarm.LoggingJobAlarmHandler"/>

    <bean id="io.nop.job.coordinator.engine.IJobPlannerScanner"
          class="io.nop.job.coordinator.engine.JobPlannerScannerImpl">
        <property name="plannerMetrics">
            <bean class="io.nop.job.coordinator.metrics.JobPlannerMetricsImpl"/>
        </property>
        <property name="partitionResolver" ref="nopJobPartitionResolver"/>
    </bean>

    <!-- plan 339: dispatchMode 是 coordinator 侧唯一路由键。key = 去前缀 bean id（single/partition/broadcast/bestFit），
         由 dispatcher 的 taskBuilders 属性经 collect-beans 收集；executorKind 不再参与 coordinator 路由。 -->
    <bean id="nopJobTaskBuilder_single" class="io.nop.job.coordinator.engine.DefaultJobTaskBuilder"/>
    <bean id="nopJobTaskBuilder_broadcast" class="io.nop.job.coordinator.engine.RpcBroadcastTaskBuilder"/>
    <bean id="nopJobTaskBuilder_partition" class="io.nop.job.coordinator.engine.PartitionTaskBuilder"/>

    <bean id="nopWorkerLoadProvider" class="io.nop.job.coordinator.engine.DefaultWorkerLoadProvider"/>
    <bean id="nopWorkerAssignmentStrategy" class="io.nop.job.coordinator.engine.LeastLoadedStrategy"/>
    <bean id="nopJobTaskBuilder_bestFit" class="io.nop.job.coordinator.engine.AdaptiveJobTaskBuilder">
        <property name="loadProvider" ref="nopWorkerLoadProvider"/>
        <property name="strategy" ref="nopWorkerAssignmentStrategy"/>
    </bean>

    <bean id="io.nop.job.coordinator.engine.IJobDispatcherScanner"
          class="io.nop.job.coordinator.engine.JobDispatcherScannerImpl">
        <property name="taskBuilders">
            <ioc:collect-beans as-map="true" name-prefix="nopJobTaskBuilder_"
                               by-type="io.nop.job.coordinator.engine.IJobTaskBuilder"/>
        </property>
        <property name="partitionResolver" ref="nopJobPartitionResolver"/>
        <!-- AR-96: 共用 workerLoadProvider 实例，使 scanOnce 的 beginScan/endScan 控制
             AdaptiveJobTaskBuilder（ref 同一 bean）的 per-scan 缓存生命周期 -->
        <property name="workerLoadProvider" ref="nopWorkerLoadProvider"/>
    </bean>

    <bean id="io.nop.job.coordinator.engine.IJobCancelHandler"
          class="io.nop.job.coordinator.engine.DefaultJobCancelHandler"/>

    <bean id="io.nop.job.coordinator.engine.IJobCompletionProcessor"
          class="io.nop.job.coordinator.engine.JobCompletionProcessorImpl">
        <property name="partitionResolver" ref="nopJobPartitionResolver"/>
        <property name="retryBridge" ref="io.nop.job.api.retry.IJobRetryBridge"/>
        <property name="alarmHandler" ref="io.nop.job.api.alarm.IJobAlarmHandler"/>
    </bean>

    <bean id="io.nop.job.coordinator.engine.IJobTimeoutChecker"
          class="io.nop.job.coordinator.engine.JobTimeoutCheckerImpl">
        <property name="partitionResolver" ref="nopJobPartitionResolver"/>
        <property name="alarmHandler" ref="io.nop.job.api.alarm.IJobAlarmHandler"/>
    </bean>

    <!-- plan 340 §2.5 (P2-4): 周期对账 activeFireCount，收敛 @SingleSession 路径的计数漂移。
         刻意 non-@SingleSession（见类 javadoc），复用 planner 的 scan-interval-ms 节拍。 -->
    <bean id="io.nop.job.coordinator.engine.JobScheduleCounterReconciler"
          class="io.nop.job.coordinator.engine.JobScheduleCounterReconciler"/>

    <bean id="io.nop.job.coordinator.engine.JobCoordinator"
          class="io.nop.job.coordinator.engine.JobCoordinator">
        <!-- plan 2254: coordinator 内嵌 worker 执行链（可选装配——不配置则 coordinator 不启动
             worker 扫描，行为与现状一致） -->
        <property name="workerScanner" ref="io.nop.job.worker.engine.IJobWorkerScanner"/>
    </bean>

    <!-- plan 2254: 三段式远程执行（executorKind=rpcPoll）——coordinator 复用 worker 执行链：
         JobWorkerScannerImpl 认领 WAITING task 后经 DefaultJobInvokerResolver 按 fire.executorKind
         解析 invoker；executorKind=rpcPoll → nopJobInvoker_rpcPoll（RemoteJobInvoker），经
         IRpcPollTaskClient（异步三方法）完成 start/cancel 两段 RPC，poll 段委托集中式
         nopRpcPollTaskManager（RpcPollTaskManager）定期批量 getJobStatus，对外就是一个普通 invoker。 -->
    <bean id="nopRpcPollTaskClient" class="io.nop.job.coordinator.engine.DefaultRpcPollTaskClient">
        <property name="rpcServiceInvoker" ref="nopRpcServiceInvoker"/>
    </bean>

    <!-- 集中式轮询管理器：单一注册表管理全部在途 rpcPoll call，定期发起 getJobStatus，
         自动过滤已取消/已超时/已终结条目；RemoteJobInvoker @Inject 按类型自动注入。 -->
    <bean id="nopRpcPollTaskManager" class="io.nop.job.coordinator.engine.RpcPollTaskManager"/>

    <bean id="nopJobInvoker_rpcPoll" class="io.nop.job.coordinator.engine.RemoteJobInvoker"/>

    <!-- coordinator 内嵌 worker 执行链组件（来自 nop-job-worker） -->
    <bean id="io.nop.job.worker.engine.IJobInvokerResolver"
          class="io.nop.job.worker.engine.DefaultJobInvokerResolver"/>
    <bean id="io.nop.job.worker.engine.IJobExecutionContextBuilder"
          class="io.nop.job.worker.engine.DefaultJobExecutionContextBuilder"/>
    <bean id="io.nop.job.worker.capacity.IWorkerCapacityProvider"
          class="io.nop.job.worker.capacity.MetadataWorkerCapacityProvider"/>
    <bean id="io.nop.job.worker.engine.IJobWorkerScanner"
          class="io.nop.job.worker.engine.JobWorkerScannerImpl"/>
</beans>
