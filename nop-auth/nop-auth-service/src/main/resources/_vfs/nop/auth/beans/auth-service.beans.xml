<?xml version="1.0" encoding="UTF-8" ?>

<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns:ioc="ioc" xmlns:feature="feature">

    <bean id="io.nop.auth.service.biz.LoginApiBizModel" ioc:type="@bean:id"/>

    <bean id="io.nop.auth.service.biz.SiteMapApiBizModel" ioc:type="@bean:id"/>

    <bean id="nopSiteMapProvider" class="io.nop.auth.service.sitemap.SiteMapProviderImpl">
        <property name="enableActionAuth" value="@cfg:nop.auth.enable-action-auth|false" />
    </bean>

    <bean id="nopActionAuthChecker" class="io.nop.auth.service.auth.DefaultActionAuthChecker" ioc:default="true"/>

    <bean id="nopDataAuthChecker" class="io.nop.auth.service.auth.DefaultDataAuthChecker" ioc:default="true" ioc:delay-method="lazyInit"/>

    <bean id="nopLoginService" class="io.nop.auth.service.login.LoginServiceImpl" ioc:default="true"
          ioc:delay-method="lazyInit"/>

    <!-- MFA 存储装配（设计 §3.3 / §3.7 nop.auth.mfa.store-type，默认 db）。声明式 collect-beans 装配。
         注意命名：config 与 active(factory) bean 的 id 不得落在 collect 前缀 nopMfaChallengeStore_/
         nopSmsCodeStore_ 之内，否则会被收集器误纳入 typed map 导致装配失败。 -->
    <bean id="nopMfaChallengeConfig" class="io.nop.auth.core.mfa.store.MfaChallengeStoreConfig">
        <property name="expireSeconds" value="@cfg:nop.auth.mfa.challenge-expire-seconds|300"/>
        <!-- 操作级票窗口（设计 §3.3）：三 store 实现共用同一配置 bean -->
        <property name="opTicketExpireSeconds" value="@cfg:nop.auth.operation-mfa.op-ticket-expire-seconds|60"/>
    </bean>
    <bean id="nopSmsCodeConfig" class="io.nop.auth.core.mfa.store.SmsCodeStoreConfig">
        <property name="expireSeconds" value="@cfg:nop.auth.sms-code.expire-seconds|300"/>
        <property name="maxAttempts" value="@cfg:nop.auth.sms-code.max-attempts|5"/>
    </bean>

    <bean id="nopMfaChallengeStore_local" class="io.nop.auth.core.mfa.store.LocalMfaChallengeStore"
          autowire-candidate="false" lazy-init="true">
        <constructor-arg index="0" ref="nopMfaChallengeConfig"/>
    </bean>
    <bean id="nopMfaChallengeStore_db" class="io.nop.auth.service.mfa.store.DbMfaChallengeStore"
          autowire-candidate="false" lazy-init="true">
        <property name="config" ref="nopMfaChallengeConfig"/>
    </bean>
    <bean id="nopMfaChallengeStore_redis" class="io.nop.auth.service.mfa.store.RedisMfaChallengeStore"
          autowire-candidate="false" lazy-init="true">
        <property name="config" ref="nopMfaChallengeConfig"/>
        <ioc:condition>
            <if-property name="nop.auth.mfa.store-type" value="redis"/>
            <on-class>io.nop.nosql.core.INosqlService</on-class>
        </ioc:condition>
    </bean>
    <bean id="nopSmsCodeStore_local" class="io.nop.auth.core.mfa.store.LocalSmsCodeStore"
          autowire-candidate="false" lazy-init="true">
        <constructor-arg index="0" ref="nopSmsCodeConfig"/>
    </bean>
    <bean id="nopSmsCodeStore_db" class="io.nop.auth.service.mfa.store.DbSmsCodeStore"
          autowire-candidate="false" lazy-init="true">
        <property name="config" ref="nopSmsCodeConfig"/>
    </bean>
    <bean id="nopSmsCodeStore_redis" class="io.nop.auth.service.mfa.store.RedisSmsCodeStore"
          autowire-candidate="false" lazy-init="true">
        <ioc:condition>
            <if-property name="nop.auth.mfa.store-type" value="redis"/>
            <on-class>io.nop.nosql.core.INosqlService</on-class>
        </ioc:condition>
    </bean>
    <!-- EmailCodeStore 三实现（W15-impl，设计 §5.3.3——复制 W8 装配模式；config bean id
         nopEmailCodeConfig 不落 collect 前缀 nopEmailCodeStore_ 之内，同 W8 命名教训）。 -->
    <bean id="nopEmailCodeConfig" class="io.nop.auth.core.mfa.store.EmailCodeStoreConfig">
        <property name="expireSeconds" value="@cfg:nop.auth.email-code.expire-seconds|300"/>
        <property name="maxAttempts" value="@cfg:nop.auth.email-code.max-attempts|5"/>
    </bean>
    <bean id="nopEmailCodeStore_local" class="io.nop.auth.core.mfa.store.LocalEmailCodeStore"
          autowire-candidate="false" lazy-init="true">
        <constructor-arg index="0" ref="nopEmailCodeConfig"/>
    </bean>
    <bean id="nopEmailCodeStore_db" class="io.nop.auth.service.mfa.store.DbEmailCodeStore"
          autowire-candidate="false" lazy-init="true">
        <property name="config" ref="nopEmailCodeConfig"/>
    </bean>
    <bean id="nopEmailCodeStore_redis" class="io.nop.auth.service.mfa.store.RedisEmailCodeStore"
          autowire-candidate="false" lazy-init="true">
        <ioc:condition>
            <if-property name="nop.auth.mfa.store-type" value="redis"/>
            <on-class>io.nop.nosql.core.INosqlService</on-class>
        </ioc:condition>
    </bean>

    <bean id="nopMfaStoreProvider" class="io.nop.auth.service.mfa.MfaStoreProvider">
        <property name="storeType" value="@cfg:nop.auth.mfa.store-type|db"/>
        <property name="challengeStores">
            <ioc:collect-beans name-prefix="nopMfaChallengeStore" as-map="true" ioc:ignore-depends="true"/>
        </property>
        <property name="smsCodeStores">
            <ioc:collect-beans name-prefix="nopSmsCodeStore" as-map="true" ioc:ignore-depends="true"/>
        </property>
        <property name="emailCodeStores">
            <ioc:collect-beans name-prefix="nopEmailCodeStore" as-map="true" ioc:ignore-depends="true"/>
        </property>
    </bean>

    <bean id="nopActiveMfaChallengeStore" ioc:type="io.nop.auth.core.mfa.store.MfaChallengeStore"
          factory-bean="nopMfaStoreProvider" factory-method="getMfaChallengeStore"/>

    <bean id="nopActiveSmsCodeStore" ioc:type="io.nop.auth.core.mfa.store.SmsCodeStore"
          factory-bean="nopMfaStoreProvider" factory-method="getSmsCodeStore"/>

    <bean id="nopActiveEmailCodeStore" ioc:type="io.nop.auth.core.mfa.store.EmailCodeStore"
          factory-bean="nopMfaStoreProvider" factory-method="getEmailCodeStore"/>

    <!-- 发码限流装配（design nop-auth §3.1，plan 2274 Phase 1）：collect-beans 同 MfaStoreProvider 模式，
         nop.auth.rate-limit.store-type（local|redis，默认 local）。config/active bean id 不得落在
         collect 前缀 nopAuthRateLimiter_ 之内（W8 命名教训）。 -->
    <bean id="nopAuthRateLimiter_local" class="io.nop.auth.service.ratelimit.LocalSendCodeRateLimiter"
          autowire-candidate="false" lazy-init="true"/>
    <bean id="nopAuthRateLimiter_redis" class="io.nop.auth.service.ratelimit.RedisSendCodeRateLimiter"
          autowire-candidate="false" lazy-init="true">
        <ioc:condition>
            <if-property name="nop.auth.rate-limit.store-type" value="redis"/>
            <on-class>io.nop.nosql.core.INosqlService</on-class>
        </ioc:condition>
    </bean>
    <bean id="nopSendCodeRateLimiterProvider" class="io.nop.auth.service.ratelimit.SendCodeRateLimiterProvider">
        <property name="storeType" value="@cfg:nop.auth.rate-limit.store-type|local"/>
        <property name="rateLimiters">
            <ioc:collect-beans name-prefix="nopAuthRateLimiter" as-map="true" ioc:ignore-depends="true"/>
        </property>
    </bean>
    <bean id="nopActiveSendCodeRateLimiter" ioc:type="io.nop.auth.service.ratelimit.ISendCodeRateLimiter"
          factory-bean="nopSendCodeRateLimiterProvider" factory-method="getRateLimiter"/>

    <!-- 登录失败计数装配（design nop-auth §3.2，plan 2274 Phase 2）：Local 注册于 auth-core-defaults，
         Redis 此处条件激活（class 无 nosql 不注册不加载，lessons/15）；
         nop.auth.login-attempt.store-type（local|redis，默认 local）选择，fail-closed。 -->
    <bean id="nopLoginAttemptStore_redis" class="io.nop.auth.service.login.RedisLoginAttemptStore"
          autowire-candidate="false" lazy-init="true">
        <ioc:condition>
            <if-property name="nop.auth.login-attempt.store-type" value="redis"/>
            <on-class>io.nop.nosql.core.INosqlService</on-class>
        </ioc:condition>
    </bean>
    <bean id="nopLoginAttemptSelector" class="io.nop.auth.service.login.LoginAttemptStoreProvider">
        <property name="storeType" value="@cfg:nop.auth.login-attempt.store-type|local"/>
        <property name="attemptStores">
            <ioc:collect-beans name-prefix="nopLoginAttemptStore" as-map="true" ioc:ignore-depends="true"/>
        </property>
    </bean>
    <bean id="nopActiveLoginAttemptStore" ioc:type="io.nop.auth.core.login.ILoginAttemptStore"
          factory-bean="nopLoginAttemptSelector" factory-method="getLoginAttemptStore"/>

    <!-- TOTP 验证器（W4）。skew 从配置读取，mfaVerify TOTP 分支调用。 -->
    <bean id="nopTotpAuthenticator" class="io.nop.auth.core.totp.TOTPAuthenticator">
        <property name="skew" value="@cfg:nop.auth.mfa.totp-window-skew|1"/>
    </bean>

    <!-- 共享因子校验组件（W12-impl 设计 §3.1 结论 5）：登录级/绑定级/操作级三处因子校验
         收敛；TOTP 防重放窗口统一推进内聚组件内。注入 LoginServiceImpl/NopAuthUserBizModel/
         LoginApiBizModel。 -->
    <bean id="nopMfaFactorVerifier" class="io.nop.auth.service.mfa.MfaFactorVerifier" ioc:default="true"/>

    <!-- WebAuthn/FIDO2 验证器组件（W14-impl 设计 §5.3.2）：封装 Yubico webauthn-server-core
         （依赖只进 nop-auth-service——nop-biz-auth-core 零第三方依赖不变式保持）。按类型注入
         MfaFactorVerifier（断言验证）/NopAuthUserBizModel（注册与解绑 ceremony、options 构造）/
         LoginApiBizModel（webauthnAuthOptions）。ioc:default 允许应用覆盖。 -->
    <bean id="nopWebAuthnAuthenticator" class="io.nop.auth.service.mfa.WebAuthnAuthenticator" ioc:default="true"/>

    <!-- 操作级 MFA 判定（W12-impl 设计 §3.3）：IOperationMfaChecker SPI 实现，经
          GraphQLEngine @Inject @Nullable setOperationMfaChecker 按类型注入（未部署
          nop-auth-service 的环境无此 bean → 引擎零介入）。ioc:default 允许应用覆盖。 -->
    <bean id="nopOperationMfaChecker" class="io.nop.auth.service.mfa.OperationMfaCheckerImpl"
          ioc:type="io.nop.auth.api.mfa.IOperationMfaChecker" ioc:default="true"/>

    <!-- 角色级 MFA 策略评估器（W13-impl 设计 §4.3）：checkMfaRequired 第三态 / confirmMfa
          策略校验 / OAuth 接入判定共用。注入 LoginServiceImpl / NopAuthUserBizModel /
          MfaLoginPolicyServiceImpl。ioc:default 允许应用覆盖。 -->
    <bean id="nopRoleMfaPolicyEvaluator" class="io.nop.auth.service.mfa.RoleMfaPolicyEvaluator" ioc:default="true"/>

    <!-- 外部身份（OAuth/SSO）MFA/策略判定（W13-impl 设计 §4.1 结论 10）：SPI 落
          nop-biz-auth-core（IMfaLoginPolicyService），本实现复用 checkMfaRequired 等价
          逻辑 + evaluator；OAuthLoginServiceImpl @Inject @Nullable 可选注入——未部署
          nop-auth-service 的环境无此 bean → 零介入（一期行为）。 -->
    <bean id="nopMfaLoginPolicyService" class="io.nop.auth.service.mfa.MfaLoginPolicyServiceImpl"
          ioc:type="io.nop.auth.core.mfa.IMfaLoginPolicyService" ioc:default="true"/>

    <!-- 可信设备共享组件（W15-impl，设计 §六）：指纹计算 + 豁免判定 + 登记 + 撤销矩阵统一
          落点。注入 LoginServiceImpl（豁免/登记）/ NopAuthUserBizModel（撤销/管理 API）。
          ioc:default 允许应用覆盖。 -->
    <bean id="nopMfaTrustedDeviceManager" class="io.nop.auth.service.mfa.MfaTrustedDeviceManager"
          ioc:default="true"/>

    <bean id="nopLoginSessionStore" class="io.nop.auth.service.login.DaoLoginSessionStore" ioc:default="true">

    </bean>

    <bean id="nopGraphQLLogger" class="io.nop.auth.service.audit.GraphQLAuditLogger" ioc:default="true">
        <ioc:condition>
            <if-property name="nop.auth.graphql.enable-audit" enableIfMissing="false"/>
        </ioc:condition>
    </bean>

    <bean id="nopUserContextCache" class="io.nop.auth.service.login.DaoUserContextCache">
        <ioc:condition>
            <if-property name="nop.auth.login.use-dao-user-context-cache"/>
        </ioc:condition>
    </bean>

    <bean id="nopAuditService" class="io.nop.auth.service.audit.AuditServiceImpl"/>

    <!-- UserChannelResolver (W2): resolves a platform userId to its bound
         external channels by reading NopAuthExtLogin. Used by the business
         message layer (IChannelMessageService in nop-ai-gateway) to route
         outbound messages. ioc:default=true so app deployments can override. -->
    <bean id="nopUserChannelResolver"
          class="io.nop.auth.service.channel.UserChannelResolverImpl"
          ioc:type="io.nop.integration.api.channel.UserChannelResolver"
          ioc:default="true"/>

    <!-- ChannelBindService (W3): business facade for scan-to-bind. Writes
         effective bindings (verified=true, delFlag=0) into NopAuthExtLogin,
         adjudicates the three rebind cases (idempotent / same-user after
         unbind / cross-user after unbind), and exposes findBinding for the
         W4 scan-login reverse lookup. Concrete IChannelBindProvider
         implementations (FeishuBindProvider etc.) arrive in W5-2 and are
         auto-collected here by type; with no providers deployed the
         collected list is empty and startBinding throws explicitly
         (no silent null). ioc:default=true so app deployments can override. -->
    <bean id="nopChannelBindService"
          class="io.nop.auth.service.channel.ChannelBindServiceImpl"
          ioc:type="io.nop.auth.api.bind.IChannelBindService"
          ioc:default="true">
        <property name="channelBindProviders">
            <ioc:collect-beans by-type="io.nop.integration.api.bind.IChannelBindProvider"
                               ioc:ignore-depends="true" only-concrete-classes="true"/>
        </property>
    </bean>

    <bean id="nopUserIdGenerator" class="io.nop.auth.dao.generator.DefaultUserIdGenerator"
          ioc:default="true"/>

    <bean id="nopAuthHttpServerFilter" class="io.nop.auth.core.filter.AuthHttpServerFilter" ioc:default="true">
        <ioc:condition>
            <if-property name="nop.auth.http-server-filter.enabled" enableIfMissing="true"/>
        </ioc:condition>
    </bean>

    <bean id="nopAuthFilterConfig" class="io.nop.auth.core.filter.AuthFilterConfig" ioc:default="true">
        <!-- 未指定的情况下都是公开页面，主要是js/css/image等 -->
        <property name="defaultPublic" value="true"/>

        <property name="publicPaths">
            <list>
                <value>/r/LoginApi_*</value>
                <value>/q/health*</value>
                <value>/q/metrics*</value>
                <value feature:on="nop.auth.quarkus-dev-public">/q/*</value>
                <value feature:on="nop.auth.download-file-public">/f/download/*</value>
            </list>
        </property>

        <property name="authPaths">
            <list>
                <value>/graphql*</value>
                <!-- REST请求 -->
                <value>/r/*</value>
                <!-- quarkus内置管理页面 -->
                <value feature:off="nop.auth.quarkus-dev-public">/q/*</value>
                <!-- 返回具有指定contentType的内容 -->
                <value>/p/*</value>
                <!-- 文件上传下载 -->
                <value>/f/*</value>
                <!-- jsonrpc调用 -->
                <value>/jsonrpc</value>

                <!-- 代理调用分布式服务 -->
                <value>/px/*</value>
            </list>
        </property>

        <property name="servicePaths">
            <list>
                <value>/graphql*</value>
                <!-- REST请求 -->
                <value>/r/*</value>
                <!-- 返回具有指定contentType的内容 -->
                <value>/p/*</value>
                <!-- 文件上传下载 -->
                <value>/f/*</value>

                <value>/jsonrpc</value>
                <value>/px/*</value>
            </list>
        </property>

        <!--
        单页应用总是跳转回首页，由首页中的js负责显示登录页面
        -->
        <property name="loginUrl" value="@cfg:nop.auth.login-url|/index.html#/login"/>
        <property name="logoutUrl" value="/r/LoginApi__logout"/>

        <property name="servicePublic" value="@cfg:nop.auth.service-public|false"/>
    </bean>
</beans>