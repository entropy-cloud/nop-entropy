<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <artifactId>nop-auth</artifactId>
        <groupId>io.github.entropy-cloud</groupId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>nop-auth-service</artifactId>

    <dependencies>
        <dependency>
            <artifactId>nop-auth-dao</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
        </dependency>

        <!-- ChannelBindServiceImpl implements IChannelBindService and returns
             BindStartResult / ChannelBindingInfo. nop-auth-api depends only
             on nop-api-core, so this edge introduces no cycle. -->
        <dependency>
            <artifactId>nop-auth-api</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-biz-auth-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-auth-meta</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-file-dao</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-biz</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-graphql-orm</artifactId>
        </dependency>

        <!-- UserChannelResolver implementation reads NopAuthExtLogin and maps
             loginType to channelType via ChannelTypeCodes. nop-integration-api
             depends only on nop-api-core, so this edge introduces no cycle. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-integration-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-config</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ioc</artifactId>
        </dependency>

        <!-- W4: Redis-backed MFA challenge / SMS code stores (store-type=redis).
             Optional: only required at runtime when nop.auth.mfa.store-type=redis;
             default is Local (in-JVM).nop-auth-service compiles against the
             INosqlService / INosqlKeyValueOperations / INosqlCounter primitives. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-nosql-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-core</artifactId>
        </dependency>

        <!-- W14: WebAuthn/FIDO2 protocol library (design §5.3.2 / §5.4: never
             roll our own protocol stack). Encapsulated exclusively inside
             WebAuthnAuthenticator; library types must not leak into method
             signatures. Only nop-auth-service carries this dependency —
             nop-biz-auth-core keeps its zero-third-party-dependency rule. -->
        <dependency>
            <groupId>com.yubico</groupId>
            <artifactId>webauthn-server-core</artifactId>
            <version>2.7.0</version>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-sys-service</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-autotest-junit</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- W6-2 E2E: bring ChannelLoginApiBizModel (nop-ai-gateway) and
             FeishuBindProvider (nop-integration-feishu) classes onto the test
             classpath so the scan-bind + scan-login full chain can run in a
             single JVM with the real auth-service beans. Test-scope only:
             no runtime dependency edge (gateway depends on nop-auth-api, not
             nop-auth-service, so there is no cycle). The modules'
             *-defaults.beans.xml are NOT auto-discovered by the container
             (only app*.beans.xml / autoconfig are); the E2E test loads the
             needed beans via a controlled test beans.xml (testBeansFile). -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ai-gateway</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <!-- Only ChannelLoginApiBizModel + ScanLoginResult are used. They
                 reference solely nop-auth-api / nop-biz-auth-core /
                 nop-integration-api / nop-api-core / nop-core types, so the
                 AI internals below are excluded: their *-defaults.beans.xml
                 are auto-loaded via /nop/autoconfig/ and require beans
                 (IHttpClient, agent engine, ai_dao schema) not present in the
                 auth-service test context. Excluding them keeps the test
                 classpath minimal and avoids dragging the AI context in. -->
            <exclusions>
                <exclusion>
                    <groupId>io.github.entropy-cloud</groupId>
                    <artifactId>nop-gateway</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.github.entropy-cloud</groupId>
                    <artifactId>nop-ai-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.github.entropy-cloud</groupId>
                    <artifactId>nop-ai-agent</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.github.entropy-cloud</groupId>
                    <artifactId>nop-ai-dao</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-integration-feishu</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- W16-impl-ext: Email MFA credentialId E2E (TestJavaEmailSenderMfaE2E) —
             the real email-code send chain consumes a credential-wired JavaEmailSender.
             Test-scope only: no runtime dependency edge. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-integration-email-java</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
