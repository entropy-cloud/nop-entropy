<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="laptop" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="MFA可信设备" i18n-en:displayName="MFA Trusted Device"
      tagSet="mapper,no-tenant" xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.auth.dao.entity.NopAuthMfaTrustedDevice</entityName>

    <primaryKey>sid</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys>
        <key name="userIdDeviceHashKey" props="userId,deviceHash"/>
    </keys>

    <props>
        <prop name="sid" displayName="主键" propId="1" i18n-en:displayName="SID" tagSet="seq" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="false" internal="true" ui:show="X">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="userId" displayName="用户ID" propId="2" i18n-en:displayName="User ID" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema domain="userId" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="deviceHash" displayName="设备指纹" propId="3" i18n-en:displayName="Device Hash" tagSet="var,not-pub"
              mandatory="true" published="false" queryable="true" sortable="true" insertable="true" updatable="true"
              internal="true" ui:show="X">
            <schema type="java.lang.String" precision="64"/>
        </prop>
        <prop name="deviceName" displayName="设备名称" propId="4" i18n-en:displayName="Device Name" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="expireAt" displayName="到期时间" propId="5" i18n-en:displayName="Expire At" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="lastUsedAt" displayName="最近使用时间" propId="6" i18n-en:displayName="Last Used At" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="tenantId" displayName="租户ID" propId="7" i18n-en:displayName="Tenant ID" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="8" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" ui:show="L">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="9" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" ui:show="L">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="修改人" propId="10" i18n-en:displayName="Updated By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" ui:show="L">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="修改时间" propId="11" i18n-en:displayName="Update Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" ui:show="L">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
    </props>
</meta>