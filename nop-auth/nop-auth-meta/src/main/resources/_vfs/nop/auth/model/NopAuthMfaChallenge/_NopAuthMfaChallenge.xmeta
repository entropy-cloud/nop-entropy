<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="key" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="MFA挑战码" i18n-en:displayName="MFA Challenge"
      tagSet="no-tenant" xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.auth.dao.entity.NopAuthMfaChallenge</entityName>

    <primaryKey>challengeToken</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="challengeToken" displayName="挑战令牌" propId="1" i18n-en:displayName="Challenge Token"
              tagSet="var,not-pub" mandatory="true" published="false" queryable="true" sortable="true" insertable="true"
              updatable="false" internal="true" ui:show="X">
            <schema type="java.lang.String" precision="64"/>
        </prop>
        <prop name="userId" displayName="用户ID" propId="2" i18n-en:displayName="User ID" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema domain="userId" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="mfaType" displayName="MFA类型" propId="3" i18n-en:displayName="MFA Type" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema type="java.lang.String" precision="10"/>
        </prop>
        <prop name="loginType" displayName="登录方式" propId="4" i18n-en:displayName="Login Type" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="tenantId" displayName="租户ID" propId="5" i18n-en:displayName="Tenant ID" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X">
            <schema type="java.lang.String" precision="32"/>
        </prop>
        <prop name="phone" displayName="手机号" propId="6" i18n-en:displayName="Phone" queryable="true" sortable="true"
              insertable="true" updatable="true" ui:show="L">
            <schema domain="phone" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="expireAt" displayName="过期时间" propId="7" i18n-en:displayName="Expire At" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X">
            <schema type="java.lang.Long"/>
        </prop>
        <prop name="failCount" displayName="失败计数" propId="8" i18n-en:displayName="Fail Count" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X" defaultValue="0">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="9" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="10" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="修改人" propId="11" i18n-en:displayName="Updated By" queryable="true"
              sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="修改时间" propId="12" i18n-en:displayName="Update Time" queryable="true"
              sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="scene" displayName="场景" propId="13" i18n-en:displayName="Scene" queryable="true" sortable="true"
              insertable="true" updatable="true" internal="true" ui:show="X">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="payload" displayName="场景数据" propId="14" i18n-en:displayName="Payload" tagSet="not-pub"
              published="false" queryable="true" sortable="true" insertable="true" updatable="true" internal="true"
              ui:show="X">
            <schema type="java.lang.String" precision="500"/>
        </prop>
        <prop name="verifiedAt" displayName="验证时间" propId="15" i18n-en:displayName="Verified At" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X">
            <schema type="java.lang.Long"/>
        </prop>
    </props>
</meta>