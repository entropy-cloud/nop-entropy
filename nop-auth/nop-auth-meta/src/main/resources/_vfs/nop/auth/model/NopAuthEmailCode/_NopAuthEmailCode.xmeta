            <schema type="java.lang.Long"/>
        </prop>
        <prop name="failCount" displayName="失败计数" propId="5" i18n-en:displayName="Fail Count" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X" defaultValue="0">
            <schema type="java.lang.Integer"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="6" i18n-en:displayName="Created By" mandatory="true"
