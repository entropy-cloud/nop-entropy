    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="codeKey" displayName="验证码Key" propId="1" i18n-en:displayName="Code Key" tagSet="var,not-pub"
              mandatory="true" published="false" queryable="true" sortable="true" insertable="true" updatable="false"
              internal="true" ui:show="X">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="email" displayName="邮箱" propId="2" i18n-en:displayName="Email" queryable="true" sortable="true"
              insertable="true" updatable="true" ui:show="L">
            <schema domain="email" type="java.lang.String" precision="100"/>
