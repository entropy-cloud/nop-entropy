    <entityName>io.nop.auth.dao.entity.NopAuthEmailCode</entityName>

    <primaryKey>codeKey</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
