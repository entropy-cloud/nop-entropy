<?xml version="1.0" encoding="UTF-8" ?>
<!-- A2-followup-1 写路径收口：管理页收敛为只读监控面（继承 mutation 已在 BizModel 层显式拒绝，
     见 MfaSensitiveTableBizModel）。移除全部 mutation 入口（新增/编辑/删除按钮与 add/update 提交页），
     页面不残存调用已禁用动作的入口。-->
<view x:extends="_gen/_NopAuthMfaSetting.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">

    <grids>
        <grid id="list"/>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view"/>
        <form id="add" x:override="remove"/>
        <form id="edit" x:override="remove"/>
    </forms>

    <pages>
        <crud name="main">
            <listActions x:override="remove"/>
            <rowActions x:override="remove"/>
        </crud>
        <picker name="picker"/>
        <simple name="add" x:override="remove"/>
        <simple name="update" x:override="remove"/>
    </pages>
</view>
