<!-- C7-011（plan 2516 裁定⑧）：补 saveState + taskKeyExpr 接线，使 (taskName,taskKey) 唯一键与启动闸门
     （含裁定① stale 接管）结构性覆盖 sys-event 触发链；固定常量 taskKey = 全部署单活跃键。
     allowStartIfComplete=true：cron 周期重复触发的已完成任务允许重入（否则首轮 COMPLETED 后永久拒启），
     并发重叠仍由启动闸门行级条件 UPDATE 裁决。 -->
<batch taskName="sys-event.non-broadcast-consumer"
       batchSize="100"
       saveState="true"
       allowStartIfComplete="true"
       transactionScope="process"
       x:schema="/nop/schema/task/batch.xdef"
       xmlns:x="/nop/schema/xdsl.xdef"
       xmlns:c="c">

    <taskKeyExpr><![CDATA['non-broadcast']]></taskKeyExpr>

    <loader>
        <orm-reader entityName="io.nop.sys.dao.entity.NopSysEvent" partitionIndexField="partitionIndex">
            <query>
                <filter>
                    <c:script>
                        import io.nop.sys.dao.NopSysDaoConstants;
                        const messageService = inject('nopSysDaoMessageService');
                        const endTime = messageService.getEstimatedNow();
                    </c:script>
                    <and>
                        <in name="eventTopic" value="${messageService.getNonBroadcastTopics()}"/>
                        <or>
                            <and>
                                <eq name="eventStatus" value="${NopSysDaoConstants.SYS_EVENT_STATUS_WAITING}"/>
                                <le name="scheduleTime" value="${endTime}"/>
                            </and>
                            <and>
                                <eq name="eventStatus" value="${NopSysDaoConstants.SYS_EVENT_STATUS_CLAIMED}"/>
                                <le name="leaseExpireTime" value="${endTime}"/>
                            </and>
                        </or>
                    </and>
                </filter>
            </query>
        </orm-reader>

        <afterLoad><![CDATA[
            if (!items || items.isEmpty()) return;
            const svc = inject('nopSysDaoMessageService');
            const claimed = svc.claimNonBroadcastEvents(items);
            items.clear();
            items.addAll(claimed);
        ]]></afterLoad>
    </loader>

    <processor name="process">
        <source><![CDATA[
            const svc = inject('nopSysDaoMessageService');
            svc.processClaimedNonBroadcastEvent(item);
        ]]></source>
    </processor>
</batch>
