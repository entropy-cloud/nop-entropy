<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef"
      x:extends="/nop/task/lib/common.task.xml,/nop/task/lib/batch-common.task.xml"
      xmlns:batch="/nop/batch/xlib/batch.xlib">

    <steps>
        <custom name="sync" customType="batch:Execute" useParentScope="true">
            <batch:task taskName="test.sync.csvToJdbc" batchSize="50" transactionScope="chunk">
                <loader>
                    <file-reader filePath="dev:/target/sync-test/csv-to-jdbc-input.csv"/>
                </loader>

                <processor name="transform">
                    <source>
                        consume({
                            id: item.id,
                            name: item.name + "-imported",
                            amount: item.amount
                        });
                    </source>
                </processor>

                <consumer name="all">
                    <jdbc-writer tableName="sync_csv_jdbc">
                        <fields>
                            <field name="id" stdSqlType="INTEGER"/>
                            <field name="name" stdSqlType="VARCHAR"/>
                            <field name="amount" stdSqlType="INTEGER"/>
                        </fields>
                    </jdbc-writer>
                </consumer>
            </batch:task>
        </custom>
    </steps>
</task>
