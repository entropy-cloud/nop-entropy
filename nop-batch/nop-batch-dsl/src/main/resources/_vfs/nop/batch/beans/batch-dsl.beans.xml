<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:ioc="ioc">

    <bean id="nopBatchTaskManager" class="io.nop.batch.dsl.manager.BatchTaskManagerImpl"/>

    <bean id="nopBatchTaskRunner" class="io.nop.batch.dsl.runner.BatchTaskRunner">
        <!-- 可选注入：无 job 模块的纯 batch 部署中 jobPartitionResolver bean 不存在，ioc:optional 使其注入 null -->
        <property name="partitionResolver">
            <ref bean="jobPartitionResolver" ioc:optional="true"/>
        </property>
    </bean>
</beans>
