<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="history" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="OAuth授权State绑定" i18n-en:displayName="OAuth State"
      tagSet="no-tenant" xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.credential.dao.entity.NopCredentialOauthState</entityName>

    <primaryKey>state</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="state" displayName="State令牌" propId="1" i18n-en:displayName="State Token" tagSet="var,not-pub"
              mandatory="true" published="false" queryable="true" sortable="true" insertable="true" updatable="false"
              internal="true" ui:show="X">
            <schema type="java.lang.String" precision="64"/>
        </prop>
        <prop name="credentialId" displayName="凭证ID" propId="2" i18n-en:displayName="Credential ID" tagSet="var"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="userId" displayName="发起人" propId="3" i18n-en:displayName="Initiator User ID" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="expireAt" displayName="过期时间" propId="4" i18n-en:displayName="Expire At" queryable="true"
              sortable="true" insertable="true" updatable="true" internal="true" ui:show="X">
            <schema type="java.lang.Long"/>
        </prop>
        <prop name="consumed" displayName="已消费" propId="5" i18n-en:displayName="Consumed" mandatory="true"
              queryable="true" sortable="true" insertable="true" updatable="true" internal="true" ui:show="X"
              defaultValue="0">
            <schema stdDomain="boolFlag" type="java.lang.Byte"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="6" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="7" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
    </props>
</meta>