<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="key" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="加密凭证" i18n-en:displayName="Credential" tagSet="audit"
      xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.credential.dao.entity.NopCredential</entityName>

    <primaryKey>credentialId</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys/>

    <props>
        <prop name="credentialId" displayName="凭证ID" propId="1" i18n-en:displayName="Credential ID" tagSet="var"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="name" displayName="凭证名" propId="2" i18n-en:displayName="Name" queryable="true" sortable="true"
              insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="typeName" displayName="凭证类型" propId="3" i18n-en:displayName="Type Name" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="100"/>
        </prop>
        <prop name="data" displayName="加密数据" propId="4" i18n-en:displayName="Encrypted Data" tagSet="var"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="4000"/>
        </prop>
        <prop name="status" displayName="状态" propId="5" i18n-en:displayName="Status" queryable="true" sortable="true"
              insertable="true" updatable="true" defaultValue="enabled">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="delFlag" displayName="删除标识" propId="6" i18n-en:displayName="Deleted" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="true" internal="true" ui:show="X">
            <schema stdDomain="boolFlag" domain="delFlag" type="java.lang.Byte"/>
        </prop>
        <prop name="usageScope" displayName="使用范围" propId="7" i18n-en:displayName="Usage Scope (deprecated)"
              queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="lastUsedAt" displayName="最后使用时间" propId="8" i18n-en:displayName="Last Used At" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="expireAt" displayName="过期时间" propId="9" i18n-en:displayName="Expire At" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.sql.Timestamp"/>
        </prop>
        <prop name="testResult" displayName="连通性测试结果" propId="10" i18n-en:displayName="Test Result" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema type="java.lang.String" precision="500"/>
        </prop>
        <prop name="version" displayName="版本" propId="11" i18n-en:displayName="Version" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false" internal="true" ui:show="X">
            <schema domain="version" type="java.lang.Integer"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="12" i18n-en:displayName="Create Time" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="createdBy" displayName="创建人" propId="13" i18n-en:displayName="Created By" mandatory="true"
              queryable="true" sortable="true" insertable="false" updatable="false">
            <schema domain="createdBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="updateTime" displayName="更新时间" propId="14" i18n-en:displayName="Update Time" queryable="true"
              sortable="true" insertable="true" updatable="true" ui:show="L">
            <schema domain="updateTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="updatedBy" displayName="更新人" propId="15" i18n-en:displayName="Updated By" queryable="true"
              sortable="true" insertable="false" updatable="false" ui:show="L">
            <schema domain="updatedBy" type="java.lang.String" precision="50"/>
        </prop>
        <prop name="remark" displayName="备注" propId="16" i18n-en:displayName="Remark" queryable="true" sortable="true"
              insertable="true" updatable="true" ui:show="L">
            <schema domain="remark" type="java.lang.String" precision="200"/>
        </prop>
        <prop name="scope" displayName="凭证归属" propId="17" i18n-en:displayName="Scope" tagSet="var" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="20"/>
        </prop>
        <prop name="ownerId" displayName="归属用户" propId="18" i18n-en:displayName="Owner ID" tagSet="var" queryable="true"
              sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="usages" displayName="凭证使用记录" i18n-en:displayName="Usages" tagSet="cascade-delete" ext:kind="to-many"
              internal="true" ext:joinLeftProp="credentialId" ext:joinRightProp="credentialId" insertable="false"
              updatable="false" lazy="true" published="false">
            <schema>
                <item bizObjName="NopCredentialUsage"/>
            </schema>
        </prop>
        <prop name="auths" displayName="凭证取用授权" i18n-en:displayName="Use Authorizations" tagSet="not-pub"
              ext:kind="to-many" internal="true" ext:joinLeftProp="credentialId" ext:joinRightProp="credentialId"
              insertable="false" updatable="false" lazy="true" published="false">
            <schema>
                <item bizObjName="NopCredentialAuth"/>
            </schema>
        </prop>
    </props>
</meta>