<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_NopCredential.xmeta">

    <props>
        <!-- data 列存储加密密文，结构性明文边界：永不发布到 GraphQL/REST schema -->
        <prop name="data" published="false"/>

        <!-- W11 归属字段：scope 下拉选项经字典 credential/scope 渲染（system=系统级/user=用户级）；
             ownerId 为 user 级归属用户 userId（system 级恒空）。归属创建后不可变更（BizModel 强制）。 -->
        <prop name="scope" displayName="凭证归属">
            <schema dict="credential/scope"/>
        </prop>
    </props>
</meta>
