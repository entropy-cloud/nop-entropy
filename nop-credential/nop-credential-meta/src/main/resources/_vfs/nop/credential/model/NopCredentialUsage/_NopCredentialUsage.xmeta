<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ext="ext"
      xmlns:xpl="xpl" ext:model="orm" ext:icon="link" ext:web-renderer="" xmlns:c="c" xmlns:graphql="graphql"
      xmlns:meta-gen="meta-gen" xmlns:biz="biz" displayName="凭证使用记录" i18n-en:displayName="Credential Usage"
      xmlns:ui="ui" xmlns:orm="orm">

    <entityName>io.nop.credential.dao.entity.NopCredentialUsage</entityName>

    <primaryKey>usageId</primaryKey>

    <x:gen-extends>
        <meta-gen:DefaultMetaGenExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:gen-extends>

    <x:post-extends>
        <meta-gen:DefaultMetaPostExtends xpl:lib="/nop/core/xlib/meta-gen.xlib"/>
    </x:post-extends>

    <keys>
        <key name="credentialConsumer" props="credentialId,consumerRef"/>
    </keys>

    <props>
        <prop name="usageId" displayName="使用记录ID" propId="1" i18n-en:displayName="Usage ID" tagSet="var"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="false">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="credentialId" displayName="凭证ID" propId="2" i18n-en:displayName="Credential ID" tagSet="var"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true"
              ext:relation="credential">
            <schema type="java.lang.String" precision="50"/>
        </prop>
        <prop name="consumerRef" displayName="消费者引用" propId="3" i18n-en:displayName="Consumer Ref" tagSet="var"
              mandatory="true" queryable="true" sortable="true" insertable="true" updatable="true">
            <schema type="java.lang.String" precision="200"/>
        </prop>
        <prop name="createTime" displayName="创建时间" propId="4" i18n-en:displayName="Create Time" queryable="true"
              sortable="true" insertable="false" updatable="false">
            <schema domain="createTime" type="java.sql.Timestamp"/>
        </prop>
        <prop name="credential" displayName="凭证" i18n-en:displayName="Credential" tagSet="pub,ref-pub" ext:kind="to-one"
              internal="true" queryable="true" ext:joinLeftProp="credentialId" ext:joinRightProp="credentialId"
              insertable="false" updatable="false" mandatory="true" lazy="true">
            <schema bizObjName="NopCredential"/>
        </prop>
    </props>
</meta>