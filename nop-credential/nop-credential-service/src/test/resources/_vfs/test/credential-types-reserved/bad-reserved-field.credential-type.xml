<?xml version="1.0" encoding="UTF-8" ?>
<!-- 非法类型文件（测试夹具）：fields 占用引擎保留字段名 accessToken，registry 加载必须拒绝 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="bad-reserved-field" version="1" displayName="Bad Reserved Field"
                 authType="apiKey">
    <fields>
        <field name="apiKey" label="API Key" type="password" sensitive="true" required="true"/>
        <field name="accessToken" label="Access Token" type="string" sensitive="true" required="false"/>
    </fields>
</credential-type>
