<?xml version="1.0" encoding="UTF-8" ?>
<!-- 非法类型文件（测试夹具）：非 oauth2 类型声明了 <oauth2> 元数据（配置错位），registry 加载必须拒绝 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="bad-non-oauth2-metadata" version="1" displayName="Bad Non OAuth2 Metadata"
                 authType="apiKey">
    <fields>
        <field name="apiKey" label="API Key" type="password" sensitive="true" required="true"/>
    </fields>
    <oauth2 authorizationEndpoint="https://auth.example.com/authorize"
            tokenEndpoint="https://auth.example.com/token"/>
</credential-type>
