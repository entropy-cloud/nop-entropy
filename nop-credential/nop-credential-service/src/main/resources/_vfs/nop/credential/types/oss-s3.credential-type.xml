<?xml version="1.0" encoding="UTF-8" ?>
<!-- S3 兼容对象存储身份对凭证（W16-impl-ext 设计 §4.3 类型清单）：accessKey/secretKey 必填
     （secretKey 敏感）；endpoint/region/bucket/pathStyle 留 OssConfig（连接拓扑）。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="oss-s3" version="1" displayName="OSS (S3-compatible)"
                 authType="none">
    <fields>
        <field name="accessKey" label="AccessKey" type="string" sensitive="false" required="true"/>
        <field name="secretKey" label="SecretKey" type="password" sensitive="true" required="true"/>
    </fields>
</credential-type>
