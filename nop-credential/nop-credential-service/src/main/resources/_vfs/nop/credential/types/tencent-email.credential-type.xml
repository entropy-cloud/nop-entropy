<?xml version="1.0" encoding="UTF-8" ?>
<!-- 腾讯邮件 SES 应用级参数凭证（W16-impl-ext 设计 §4.3 类型清单）：secretId/secretKey 必填
     （secretKey 敏感），region 随凭证必填（SesClient 构造必需、非机密）；endpoint 为代码常量不入凭证。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="tencent-email" version="1" displayName="Tencent Email (SES)"
                 authType="none">
    <fields>
        <field name="secretId" label="SecretId" type="string" sensitive="false" required="true"/>
        <field name="secretKey" label="SecretKey" type="password" sensitive="true" required="true"/>
        <field name="region" label="Region" type="string" sensitive="false" required="true"/>
    </fields>
</credential-type>
