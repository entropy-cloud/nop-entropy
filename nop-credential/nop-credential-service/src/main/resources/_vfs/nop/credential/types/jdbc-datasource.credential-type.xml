<?xml version="1.0" encoding="UTF-8" ?>
<!-- JDBC 数据源身份对凭证（W16-impl 设计 §4.3 类型清单）：username 必填、password 可空且敏感
     （必填性=消费方现状语义不收紧——requireNonBlank(username)/requireField(password) 的 H2 空
     密码现状）；jdbcUrl/driverClassName 留 connectionConfig JSON（拓扑 + AR-02 校验锚点）。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="jdbc-datasource" version="1" displayName="JDBC DataSource"
                 authType="none">
    <fields>
        <field name="username" label="Username" type="string" sensitive="false" required="true"/>
        <field name="password" label="Password" type="password" sensitive="true" required="false"/>
    </fields>
</credential-type>
