<?xml version="1.0" encoding="UTF-8" ?>
<!-- 飞书应用四元组凭证（W16-impl-ext 设计 §4.3 类型清单）：appId/appSecret 必填（appSecret 敏感），
     verificationToken/encryptKey 可空且敏感（预留字段——仓库内无消费方，随凭证整组治理）。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="feishu-app" version="1" displayName="Feishu App"
                 authType="none">
    <fields>
        <field name="appId" label="AppId" type="string" sensitive="false" required="true"/>
        <field name="appSecret" label="AppSecret" type="password" sensitive="true" required="true"/>
        <field name="verificationToken" label="VerificationToken" type="password" sensitive="true" required="false"/>
        <field name="encryptKey" label="EncryptKey" type="password" sensitive="true" required="false"/>
    </fields>
</credential-type>
