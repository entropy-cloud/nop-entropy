<?xml version="1.0" encoding="UTF-8" ?>
<!-- 通用密钥凭证类型示例。字段 secret 为敏感字段（密码型），无认证类型。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="generic-secret" version="1" displayName="Generic Secret"
                 authType="none">
    <fields>
        <field name="secret" label="Secret" type="password" sensitive="true" required="true"/>
    </fields>
</credential-type>
