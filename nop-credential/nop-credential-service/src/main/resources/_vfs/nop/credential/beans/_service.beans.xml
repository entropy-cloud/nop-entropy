<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:ioc="ioc"
       xmlns="http://www.springframework.org/schema/beans" x:extends="/nop/biz/defaults/service-base.beans.xml"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <bean id="io.nop.credential.service.entity.NopCredentialBizModel" ioc:type="@bean:id" ioc:default="true"/>

    <bean id="biz_NopCredential" class="io.nop.biz.proxy.BizProxyFactoryBean"
          ioc:type="io.nop.credential.biz.INopCredentialBiz" ioc:force-lazy-property="true" lazy-init="true"
          primary="true">
        <property name="bizObjName" value="NopCredential"/>
    </bean>

    <bean id="io.nop.credential.service.entity.NopCredentialOauthStateBizModel" ioc:type="@bean:id" ioc:default="true"/>

    <bean id="biz_NopCredentialOauthState" class="io.nop.biz.proxy.BizProxyFactoryBean"
          ioc:type="io.nop.credential.biz.INopCredentialOauthStateBiz" ioc:force-lazy-property="true" lazy-init="true"
          primary="true">
        <property name="bizObjName" value="NopCredentialOauthState"/>
    </bean>

    <bean id="io.nop.credential.service.entity.NopCredentialUsageBizModel" ioc:type="@bean:id" ioc:default="true"/>

    <bean id="biz_NopCredentialUsage" class="io.nop.biz.proxy.BizProxyFactoryBean"
          ioc:type="io.nop.credential.biz.INopCredentialUsageBiz" ioc:force-lazy-property="true" lazy-init="true"
          primary="true">
        <property name="bizObjName" value="NopCredentialUsage"/>
    </bean>
</beans>