<?xml version="1.0" encoding="UTF-8" ?>

<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <!--
        凭证库默认 bean 装配。@InjectValue/@Inject 注解由 NopIoC 自动处理：
        - NopCredentialKeyProvider 通过 @InjectValue 注入 nop.credential.master-keys，
          @PostConstruct 加载主密钥（fail-closed：配置缺失或非法时启动失败）。
        - NopCredentialCipher 通过 @Inject 注入 ICredentialKeyProvider（字段为 protected）。
    -->
    <bean id="nopCredentialKeyProvider" ioc:default="true"
          class="io.nop.credential.crypto.DefaultCredentialKeyProvider"/>

    <bean id="nopCredentialCipher" ioc:default="true"
          class="io.nop.credential.crypto.CredentialCipher"/>

    <!--
        凭证类型注册表。@PostConstruct 时枚举 _vfs/nop/credential/types/ 下的 *.credential-type.xml，
        经 ResourceComponentManager 加载（xdef 校验）并缓存。
    -->
    <bean id="nopCredentialTypeRegistry" ioc:default="true"
          class="io.nop.credential.service.registry.DefaultCredentialTypeRegistry"/>

    <!--
        凭证消费者 SPI 实现（平台唯一解密点）。注入 IDaoProvider、NopCredentialCipher、ICredentialTypeRegistry。
        字段为 protected 以兼容 NopIoC 字段注入。
    -->
    <bean id="nopCredentialProvider" ioc:default="true"
          class="io.nop.credential.service.CredentialProviderImpl"/>

    <!--
        W16-impl SPI 增量裁定 2：迁移支持 SPI 实现（按名反查 / 按 consumerRef 反查 / 创建凭证）。
        创建路径委托 NopCredentialBizModel.saveCredential（加密 + scope=system + 分级审计单点），
        消费方（nop-metadata 批量迁移等）经 nop-credential-api 以 api-only 依赖边访问。
    -->
    <bean id="nopCredentialMigrationSupport" ioc:default="true"
          class="io.nop.credential.service.CredentialMigrationSupportImpl"/>

    <!-- ==================== W9 OAuth 流程引擎 ==================== -->
    <!--
        令牌端点协议客户端。依赖 IHttpClient（nop-http-api 条件 bean nopHttpClient，
        部署时需引入 raw client 实现模块如 nop-http-client-jdk）。
    -->
    <bean id="nopCredentialOAuthTokenClient" ioc:default="true"
          class="io.nop.credential.service.oauth.OAuthTokenClient"/>

    <!--
        state 绑定 DB 存储（新 ORM 实体 nop_credential_oauth_state，一次性消费 + TTL + 惰性清理）。
    -->
    <bean id="nopCredentialOauthStateStore" ioc:default="true"
          class="io.nop.credential.service.oauth.NopCredentialOauthStateStore"/>

    <!--
        OAuth 流程引擎（发起/回调/token 回写）。唯一解密点不变式：clientSecret 读取与 token
        回写经 nopCredentialProvider 引擎内部通道。
    -->
    <bean id="nopCredentialOAuthFlowService" ioc:default="true"
          class="io.nop.credential.service.oauth.OAuthFlowService"/>

    <!--
        OAuth API 面（Api 型 BizModel，先例 auth-service.beans.xml 的 LoginApiBizModel——
        无聚合根 xmeta，经 REST /r/{operationName} 与 GraphQL 可达）。NopIoC 无注解扫描，
        必须显式注册；放在本手写 beans 文件（非 codegen 产物 _service.beans.xml，后者只
        按 ORM 实体生成且再生成时会覆盖手改）。
    -->
    <bean id="io.nop.credential.service.oauth.CredentialOAuthApiBizModel" ioc:type="@bean:id"/>

</beans>
