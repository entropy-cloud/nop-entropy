<?xml version="1.0" encoding="UTF-8" ?>

<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <!--
        凭证库默认 bean 装配。@InjectValue/@Inject 注解由 NopIoC 自动处理：
        - DefaultCredentialKeyProvider 通过 @InjectValue 注入 nop.credential.master-keys，
          @PostConstruct 加载主密钥（fail-closed：配置缺失或非法时启动失败）。
        - CredentialCipher 通过 @Inject 注入 ICredentialKeyProvider（字段为 protected）。
    -->
    <bean id="defaultCredentialKeyProvider" ioc:default="true"
          class="io.nop.credential.crypto.DefaultCredentialKeyProvider"/>

    <bean id="credentialCipher" ioc:default="true"
          class="io.nop.credential.crypto.CredentialCipher"/>

    <!--
        凭证类型注册表。@PostConstruct 时枚举 _vfs/nop/credential/types/ 下的 *.credential-type.xml，
        经 ResourceComponentManager 加载（xdef 校验）并缓存。
    -->
    <bean id="defaultCredentialTypeRegistry" ioc:default="true"
          class="io.nop.credential.service.registry.DefaultCredentialTypeRegistry"/>

    <!--
        凭证消费者 SPI 实现（平台唯一解密点）。注入 IDaoProvider、CredentialCipher、ICredentialTypeRegistry。
        字段为 protected 以兼容 NopIoC 字段注入。
    -->
    <bean id="credentialProvider" ioc:default="true"
          class="io.nop.credential.service.CredentialProviderImpl"/>

</beans>
