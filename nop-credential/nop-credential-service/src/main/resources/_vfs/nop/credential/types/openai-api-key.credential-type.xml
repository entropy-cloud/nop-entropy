<?xml version="1.0" encoding="UTF-8" ?>
<!-- OpenAI API Key 凭证类型示例。字段 apiKey 为敏感字段（密码型），orgId 为可选普通字段。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="openai-api-key" version="1" displayName="OpenAI API Key"
                 authType="apiKey">
    <fields>
        <field name="apiKey" label="API Key" type="password" sensitive="true" required="true"/>
        <field name="orgId" label="Organization ID" type="string" sensitive="false" required="false"/>
    </fields>
</credential-type>
