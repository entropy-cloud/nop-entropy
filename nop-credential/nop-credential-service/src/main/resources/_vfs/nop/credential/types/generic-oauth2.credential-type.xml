<?xml version="1.0" encoding="UTF-8" ?>
<!-- 通用 OAuth 2.0 凭证类型示例（出站客户端）。clientId/clientSecret 为人工字段（先经 saveCredential 录入），
     token 集（accessToken/refreshToken/expiresAt/tokenType/scope）为引擎保留字段，由授权码闭环/惰性刷新写入，
     本文件不得（也无法）声明它们。端点为示例值，实际使用时通过 delta 定制或新建类型覆盖。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="generic-oauth2" version="1" displayName="Generic OAuth2"
                 authType="oauth2">
    <fields>
        <field name="clientId" label="Client ID" type="string" sensitive="false" required="true"/>
        <field name="clientSecret" label="Client Secret" type="password" sensitive="true" required="true"/>
    </fields>
    <oauth2 authorizationEndpoint="https://auth.example.com/authorize"
            tokenEndpoint="https://auth.example.com/token"
            scopes="read write"
            refreshWindowSeconds="300"/>
</credential-type>
