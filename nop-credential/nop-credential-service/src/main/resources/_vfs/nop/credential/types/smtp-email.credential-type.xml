<?xml version="1.0" encoding="UTF-8" ?>
<!-- SMTP 邮件身份对凭证（W16-impl-ext 设计 §4.3 类型清单）：username/password 均可空（对齐
     JavaEmailSender 空=无认证语义），password 敏感；host/port/protocol/properties 留 MailConfig。
     "整凭证至少一字段非空"为跨字段约束（类型 schema 仅字段级无法表达）——实现通道为解析侧
     fail-closed 兜底：credentialId 路径下整组全空显式拒绝（W16-impl-ext plan Phase 1 裁定）。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="smtp-email" version="1" displayName="SMTP Email"
                 authType="none">
    <fields>
        <field name="username" label="Username" type="string" sensitive="false" required="false"/>
        <field name="password" label="Password" type="password" sensitive="true" required="false"/>
    </fields>
</credential-type>
