<?xml version="1.0" encoding="UTF-8" ?>
<!-- SFTP 身份凭证（W16-impl-ext 设计 §4.3 类型清单）：username/password/passphrase 三字段均可空
     （password/passphrase 敏感）——公钥无口令场景两者均空合法；host/port/keyPath 留 SftpConfig
     （keyPath 为文件路径拓扑）。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="sftp-ssh" version="1" displayName="SFTP (SSH)"
                 authType="none">
    <fields>
        <field name="username" label="Username" type="string" sensitive="false" required="false"/>
        <field name="password" label="Password" type="password" sensitive="true" required="false"/>
        <field name="passphrase" label="Passphrase" type="password" sensitive="true" required="false"/>
    </fields>
</credential-type>
