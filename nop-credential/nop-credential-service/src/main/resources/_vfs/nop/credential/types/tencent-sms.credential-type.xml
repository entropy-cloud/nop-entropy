<?xml version="1.0" encoding="UTF-8" ?>
<!-- 腾讯短信应用级参数凭证（W16-impl 设计 §4.3 类型清单）：appId/appKey 必填（appKey 敏感），
     sign 为应用级签名非机密、可空（发送侧现状直传允许 null）。 -->
<credential-type x:schema="/nop/schema/credential/credential-type.xdef"
                 xmlns:x="/nop/schema/xdsl.xdef"
                 name="tencent-sms" version="1" displayName="Tencent SMS"
                 authType="none">
    <fields>
        <field name="appId" label="AppId" type="string" sensitive="false" required="true"/>
        <field name="appKey" label="AppKey" type="password" sensitive="true" required="true"/>
        <field name="sign" label="Sign" type="string" sensitive="false" required="false"/>
    </fields>
</credential-type>
