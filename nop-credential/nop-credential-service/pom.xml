<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <artifactId>nop-credential</artifactId>
        <groupId>io.github.entropy-cloud</groupId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <artifactId>nop-credential-service</artifactId>

    <dependencies>
        <dependency>
            <artifactId>nop-credential-dao</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-credential-meta</artifactId>
        </dependency>

        <dependency>
            <artifactId>nop-credential-codegen</artifactId>
            <groupId>io.github.entropy-cloud</groupId>
            <version>2.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ioc</artifactId>
        </dependency>

        <!-- C1b 操作级 MFA 标注：@MfaRequired 注解载体（nop-biz-auth-api 仅依赖 nop-api-core，
             API-only 边——经 nop-biz → nop-graphql-core 传递本已 compile 可达，此处按 Maven
             依赖卫生显式声明直接依赖；版本走 nop-bom dependencyManagement） -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-biz-auth-api</artifactId>
        </dependency>

        <!-- W9 OAuth 引擎：IHttpClient 协议客户端（运行时 nopHttpClient 为条件 bean，
             部署需引入 raw client 实现模块如 nop-http-client-jdk） -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-http-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-autotest-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- OAuthFlowService 经类型注入 IHttpClient；触发容器初始化的测试需要 test classpath
             上存在 IHttpClient bean（先例 nop-ai-gateway/nop-auth-sso test 依赖声明） -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-http-client-jdk</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
