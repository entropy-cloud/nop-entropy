<?xml version="1.0" encoding="UTF-8" ?>
<orm ext:registerShortName="true" ext:appName="nop-credential" ext:icon="key"
     ext:entityPackageName="io.nop.credential.dao.entity" ext:basePackageName="io.nop.credential"
     ext:mavenGroupId="io.github.entropy-cloud" ext:mavenArtifactId="nop-credential" ext:mavenVersion="2.0.0-SNAPSHOT"
     ext:platformVersion="2.0.0-SNAPSHOT" ext:dialect="mysql,oracle,postgresql" x:schema="/nop/schema/orm/orm.xdef"
     xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en" xmlns:ref-i18n-en="ref-i18n-en" xmlns:ext="ext"
     xmlns:orm-gen="orm-gen" xmlns:xpl="xpl" xmlns:ui="ui">

    <x:post-extends x:override="replace">
        <orm-gen:DefaultPostExtends xpl:lib="/nop/orm/xlib/orm-gen.xlib"/>
    </x:post-extends>

    <x:gen-extends x:override="replace">
        <orm-gen:DefaultGenExtends xpl:lib="/nop/orm/xlib/orm-gen.xlib"/>
    </x:gen-extends>

    <domains>
        <domain name="version" stdSqlType="INTEGER"/>
        <domain name="createTime" stdSqlType="TIMESTAMP"/>
        <domain name="createdBy" precision="50" stdSqlType="VARCHAR"/>
        <domain name="updateTime" stdSqlType="TIMESTAMP"/>
        <domain name="updatedBy" precision="50" stdSqlType="VARCHAR"/>
        <domain name="remark" precision="1" stdSqlType="VARCHAR"/>
        <domain name="delFlag" stdDomain="boolFlag" stdSqlType="TINYINT"/>
    </domains>

    <entities>
        <entity className="io.nop.credential.dao.entity.NopCredential" createTimeProp="createTime"
                createrProp="createdBy" deleteFlagProp="delFlag" displayName="加密凭证"
                name="io.nop.credential.dao.entity.NopCredential" registerShortName="true" tableName="nop_credential"
                tagSet="audit" updaterProp="updatedBy" useLogicalDelete="true" versionProp="version" ext:icon="key"
                i18n-en:displayName="Credential">
            <columns>
                <column code="CREDENTIAL_ID" displayName="凭证ID" mandatory="true" name="credentialId" precision="50"
                        primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Credential ID"/>
                <column code="CREDENTIAL_NAME" displayName="凭证名" name="name" precision="100" propId="2"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Name"/>
                <column code="TYPE_NAME" displayName="凭证类型" name="typeName" precision="100" propId="3"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Type Name"/>
                <column code="DATA" comment="cv1:{keyId}:{v1密文} 格式的加密凭证字段JSON" displayName="加密数据" name="data"
                        precision="4000" propId="4" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Encrypted Data"/>
                <column code="STATUS" defaultValue="enabled" displayName="状态" name="status" precision="20" propId="5"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Status"/>
                <column code="DEL_FLAG" displayName="删除标识" domain="delFlag" mandatory="true" name="delFlag" propId="6"
                        stdDataType="byte" stdDomain="boolFlag" stdSqlType="TINYINT" ui:show="X"
                        i18n-en:displayName="Deleted"/>
                <column code="USAGE_SCOPE" comment="已废弃（W11 裁定）：归属语义由 scope/ownerId 承载，本列不再赋值；物理删除留后续 DDL 治理"
                        displayName="使用范围" name="usageScope" precision="50" propId="7" stdDataType="string"
                        stdSqlType="VARCHAR" i18n-en:displayName="Usage Scope (deprecated)"/>
                <column code="LAST_USED_AT" displayName="最后使用时间" name="lastUsedAt" propId="8" stdDataType="timestamp"
                        stdSqlType="TIMESTAMP" i18n-en:displayName="Last Used At"/>
                <column code="EXPIRE_AT" displayName="过期时间" name="expireAt" propId="9" stdDataType="timestamp"
                        stdSqlType="TIMESTAMP" i18n-en:displayName="Expire At"/>
                <column code="TEST_RESULT" displayName="连通性测试结果" name="testResult" precision="500" propId="10"
                        stdDataType="string" stdSqlType="VARCHAR" ui:show="L" i18n-en:displayName="Test Result"/>
                <column code="VERSION" displayName="版本" domain="version" mandatory="true" name="version" propId="11"
                        stdDataType="int" stdSqlType="INTEGER" ui:show="X" i18n-en:displayName="Version"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true" name="createTime"
                        propId="12" stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Create Time"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="13" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="UPDATE_TIME" displayName="更新时间" domain="updateTime" name="updateTime" propId="14"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" ui:show="L" i18n-en:displayName="Update Time"/>
                <column code="UPDATED_BY" displayName="更新人" domain="updatedBy" name="updatedBy" precision="50"
                        propId="15" stdDataType="string" stdSqlType="VARCHAR" ui:show="L"
                        i18n-en:displayName="Updated By"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="16"
                        stdDataType="string" stdSqlType="VARCHAR" ui:show="L" i18n-en:displayName="Remark"/>
                <column code="SCOPE"
                        comment="凭证归属：system|user；存量行 NULL 视同 system；创建后不可变更（DDL 不设默认值，语义等价裁定见 plan W11-impl）"
                        displayName="凭证归属" name="scope" precision="20" propId="17" stdDataType="string"
                        stdSqlType="VARCHAR" tagSet="var" i18n-en:displayName="Scope"/>
                <column code="OWNER_ID" comment="user 级凭证归属用户 userId（system 级恒空）；创建后不可变更，换人=删旧建新" displayName="归属用户"
                        name="ownerId" precision="50" propId="18" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Owner ID"/>
            </columns>
            <relations>
                <to-many cascadeDelete="true" displayName="凭证使用记录" name="usages"
                         refEntityName="io.nop.credential.dao.entity.NopCredentialUsage" refPropName="credential"
                         tagSet="cascade-delete" i18n-en:displayName="Usages">
                    <join>
                        <on leftProp="credentialId" rightProp="credentialId"/>
                    </join>
                </to-many>
            </relations>
        </entity>
        <entity className="io.nop.credential.dao.entity.NopCredentialUsage" createTimeProp="createTime"
                displayName="凭证使用记录" name="io.nop.credential.dao.entity.NopCredentialUsage" registerShortName="true"
                tableName="nop_credential_usage" ext:icon="link" i18n-en:displayName="Credential Usage">
            <columns>
                <column code="USAGE_ID" displayName="使用记录ID" mandatory="true" name="usageId" precision="50"
                        primary="true" propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Usage ID"/>
                <column code="CREDENTIAL_ID" displayName="凭证ID" mandatory="true" name="credentialId" precision="50"
                        propId="2" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Credential ID"/>
                <column code="CONSUMER_REF" displayName="消费者引用" mandatory="true" name="consumerRef" precision="200"
                        propId="3" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Consumer Ref"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" name="createTime" propId="4"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Create Time"/>
            </columns>
            <relations>
                <to-one displayName="凭证" name="credential" refEntityName="io.nop.credential.dao.entity.NopCredential"
                        refPropName="usages" tagSet="pub,ref-pub" i18n-en:displayName="Credential">
                    <join>
                        <on leftProp="credentialId" rightProp="credentialId"/>
                    </join>
                </to-one>
            </relations>
            <unique-keys>
                <unique-key columns="credentialId,consumerRef" constraint="UK_NOP_CREDENTIAL_USAGE_CRED_CONSUMER"
                            name="credentialConsumer"/>
            </unique-keys>
        </entity>
        <entity className="io.nop.credential.dao.entity.NopCredentialOauthState" createTimeProp="createTime"
                createrProp="createdBy" displayName="OAuth授权State绑定"
                name="io.nop.credential.dao.entity.NopCredentialOauthState" registerShortName="true"
                tableName="nop_credential_oauth_state" tagSet="no-tenant" i18n-en:displayName="OAuth State">
            <columns>
                <column code="STATE" comment="一次性 state 令牌（安全随机 128bit hex，发起时生成）" displayName="State令牌"
                        mandatory="true" name="state" precision="64" primary="true" propId="1" stdDataType="string"
                        stdSqlType="VARCHAR" tagSet="var,not-pub" ui:show="X" i18n-en:displayName="State Token"/>
                <column code="CREDENTIAL_ID" displayName="凭证ID" mandatory="true" name="credentialId" precision="50"
                        propId="2" stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        i18n-en:displayName="Credential ID"/>
                <column code="USER_ID" comment="发起人 userId（审计用，回调时以该身份执行引擎通道）" displayName="发起人" mandatory="true"
                        name="userId" precision="50" propId="3" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Initiator User ID"/>
                <column code="EXPIRE_AT" comment="过期时间戳（epoch 毫秒，TTL 缺省 10 分钟）" displayName="过期时间" name="expireAt"
                        propId="4" stdDataType="long" stdSqlType="BIGINT" ui:show="X" i18n-en:displayName="Expire At"/>
                <column code="CONSUMED" comment="一次性消费标记（条件 UPDATE 原子置 1）" defaultValue="0" displayName="已消费"
                        mandatory="true" name="consumed" propId="5" stdDataType="byte" stdDomain="boolFlag"
                        stdSqlType="TINYINT" ui:show="X" i18n-en:displayName="Consumed"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true" name="createTime"
                        propId="6" stdDataType="timestamp" stdSqlType="TIMESTAMP" ui:show="X"
                        i18n-en:displayName="Create Time"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="7" stdDataType="string" stdSqlType="VARCHAR" ui:show="X"
                        i18n-en:displayName="Created By"/>
            </columns>
            <comment>OAuth 授权码闭环的 state 绑定存储（一次性消费 + TTL 过期 + 惰性清理，W9）</comment>
            <indexes>
                <index name="IX_NOP_CREDENTIAL_OAUTH_STATE_CRED" unique="false">
                    <column name="credentialId"/>
                </index>
                <index name="IX_NOP_CREDENTIAL_OAUTH_STATE_EXPIRE" unique="false">
                    <column name="expireAt"/>
                </index>
            </indexes>
        </entity>
    </entities>
</orm>