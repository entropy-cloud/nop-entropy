<?xml version="1.0" encoding="UTF-8" ?>

<!--
    W10-impl 外部 KMS 集成装配（HashiCorp Vault KV v2 参照实现）。

    装载路径（Phase 1 Decision）：本文件放置于共享模块命名空间 /nop/credential/beans/
    且带 app- 前缀，经 AppBeanContainerLoader 按模块自动装载（isAppBeans 规则），
    不依赖 import 或 autoconfig 注册。VFS 跨 jar 合并 /nop/credential/ 目录，
    模块标记 _module 由 nop-credential-dao 提供。

    装配语义（同名 bean 覆盖 + 配置门控，设计 §4.3）：
    - 本 bean 复用缺省 bean id nopCredentialKeyProvider（不新增第二个
      ICredentialKeyProvider 独立 bean id），未设 ioc:default —— 是条件硬覆盖。
    - ioc:condition <if-property name="nop.credential.key-provider" value="vault"/>
      精确匹配门控：仅当配置指向 vault 时注册；未配置/local 时不注册。
    - 注册时：credential-defaults.beans.xml 中 $DEFAULT$nopCredentialKeyProvider 的
      missing-bean(nopCredentialKeyProvider) 条件不满足 → 缺省 bean 被排除，
      Vault 实现生效；未注册时：缺省 bean 兜底装配 DefaultCredentialKeyProvider
      （其 @PostConstruct 守卫保证 key-provider 非 local 时启动失败，
      堵死"配置了 KMS 实际跑 local"的假安全）。
    - 未引入本模块的部署零感知：local 缺省路径与一期完全一致。
-->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <bean id="nopCredentialKeyProvider" class="io.nop.credential.kms.vault.VaultCredentialKeyProvider">
        <ioc:condition>
            <if-property name="nop.credential.key-provider" value="vault"/>
        </ioc:condition>
    </bean>

</beans>
