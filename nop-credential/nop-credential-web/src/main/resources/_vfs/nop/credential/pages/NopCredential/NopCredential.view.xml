<?xml version="1.0" encoding="UTF-8" ?>
<!--
    NopCredential 管理页 delta。在 codegen 生成的基础上做以下定制（Plan W3 Phase 3 + W11）：

    1. 结构性明文边界：列表 grid 不包含 data 列（继承 _gen，已经满足），表单不包含 data 字段。
    2. 类型选择器：add/edit 表单的 typeName 单元改为 select，选项来自 NopCredential__typeList。
    3. 动态字段区：add/edit 表单新增 dynamicFields 单元（custom=true，不对应 xmeta 字段），
       仅当 typeName 已选时显示。运行时由 NopCredential.lib.xjs 的 typeFieldsToAmisForm
       把 typeList() 返回的字段 schema 映射为 AMIS 控件并注入该区域。
    4. 提交路径：add 页面的 api 改为 NopCredential__saveCredential（明文输入唯一入口），
       不使用被禁用的标准 save。提交时把 typeName、name 之外的所有字段收集为 fields map。
       edit 页面同样走 saveCredential（带 id 触发更新）；编辑态用 maskList 展示脱敏值。
    5. W11 归属最小面（只读展示 + 创建表单归属选择）：列表/详情的 scope/ownerId 展示列
       继承 _gen（已含）；add 表单新增 scope 下拉（字典 credential/scope：system/user）
       与 ownerId 输入（仅 scope=user 时显示）。输入契约与 saveCredential 分级校验一致：
       普通用户选 user 级时 ownerId 由后端强制为本人；edit 表单不含归属输入（归属不可变，
       update 缺省不传 = 保持不变）；usage 页面无改动面。
-->
<view x:extends="_gen/_NopCredential.view.xml" x:schema="/nop/schema/xui/xview.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">

    <grids>
        <grid id="list"/>
        <grid id="pick-list"/>
    </grids>

    <forms>
        <form id="view"/>
        <form id="edit">
            <cells>
                <!-- 类型选择器：选项来自 typeList() GraphQL action -->
                <cell id="typeName" control="select" mandatory="true"
                      sourceUrl="@query:NopCredential__typeList/value:name,label:displayName"
                      selectFirst="false"/>

                <!-- 动态字段占位区：custom=true 表示不对应 xmeta 字段。
                     运行时由 lib.xjs::typeFieldsToAmisForm(typeDef) 根据 typeName 动态填充。
                     仅当 typeName 已选择时显示。 -->
                <cell id="dynamicFields" custom="true" label="Credential Fields"
                      notSubmit="false">
                    <visibleOn>${typeName != null &amp;&amp; typeName != ''}</visibleOn>
                    <desc>类型驱动的动态字段区。实际 AMIS 控件由 typeFieldsToAmisForm 映射生成：
                        string→input-text, password→input-password, number→input-number,
                        select→select, boolean→switch, textarea→textarea。</desc>
                </cell>
            </cells>
        </form>
        <form id="add">
            <cells>
                <!-- 类型选择器：选项来自 typeList() GraphQL action -->
                <cell id="typeName" control="select" mandatory="true"
                      sourceUrl="@query:NopCredential__typeList/value:name,label:displayName"
                      selectFirst="false"/>

                <!-- W11 归属选择（可选，缺省 system=系统级，与一期行为一致）：
                     scope 下拉经字典 credential/scope 渲染；ownerId 仅 user 级显示——
                     普通用户无需填写（后端强制本人），管理员代建可指定他人。 -->
                <cell id="scope" control="select" mandatory="false" clearValueOnHidden="false">
                    <desc>凭证归属：system=系统级（管理员管理，全员可用）；user=用户级（个人私有，
                        仅本人消费）。归属创建后不可变更。</desc>
                </cell>
                <cell id="ownerId" mandatory="false" clearValueOnHidden="true">
                    <visibleOn>${scope == 'user'}</visibleOn>
                    <desc>user 级归属用户 userId（普通用户建 user 级时固定为本人，无需填写；
                        管理员代建时指定归属人）。</desc>
                </cell>

                <!-- 动态字段占位区：custom=true 表示不对应 xmeta 字段。
                     运行时由 lib.xjs::typeFieldsToAmisForm(typeDef) 根据 typeName 动态填充。
                     仅当 typeName 已选择时显示。 -->
                <cell id="dynamicFields" custom="true" label="Credential Fields"
                      notSubmit="false">
                    <visibleOn>${typeName != null &amp;&amp; typeName != ''}</visibleOn>
                    <desc>类型驱动的动态字段区。实际 AMIS 控件由 typeFieldsToAmisForm 映射生成：
                        string→input-text, password→input-password, number→input-number,
                        select→select, boolean→switch, textarea→textarea。</desc>
                </cell>
            </cells>
        </form>
    </forms>

    <pages>
        <crud name="main"/>
        <picker name="picker"/>

        <!-- 提交路径改为 saveCredential（明文输入唯一入口，内部加密后持久化）。
             标准 save 已在 BizModel 中被禁用（抛 UnsupportedOperationException）。
             data 模板把表单字段拆分为 typeName/name/fields 三参数；
             fields 包含除 typeName、name、credentialId、scope、ownerId 之外的所有动态字段。
             W11：scope/ownerId 为可选归属输入（空串由后端归一为未传）。 -->
        <simple name="add" form="add">
            <api url="@mutation:NopCredential__saveCredential">
                <data>
                    {"typeName":"${typeName}","name":"${name}","fields":"${fields|@format:json}","scope":"${scope}","ownerId":"${ownerId}"}
                </data>
            </api>
        </simple>

        <simple name="view" form="view">
            <initApi url="@query:NopCredential__get?id=${id}" gql:selection="{@formSelection}"/>
        </simple>

        <simple name="update" form="edit">
            <initApi url="@query:NopCredential__get?id=${id}" gql:selection="{@formSelection}"/>
            <api url="@mutation:NopCredential__saveCredential">
                <data>
                    {"typeName":"${typeName}","name":"${name}","id":"${credentialId}","fields":"${fields|@format:json}"}
                </data>
            </api>
        </simple>
    </pages>
</view>
