/**
 * 把 CredentialType 的字段 schema 映射为 AMIS form item 配置。
 *
 * 由 NopCredential__typeList GraphQL action 返回的 CredentialType 包含 fields 数组，
 * 每个字段包含 {name, label, type, sensitive, required, defaultValue}。
 * 本函数将字段类型映射为对应的 AMIS 控件：
 *   string   → input-text
 *   password → input-password（敏感凭证字段，编辑态显示 **** 占位）
 *   number   → input-number
 *   select   → select
 *   boolean  → switch
 *   textarea → textarea
 *
 * 返回的数组可直接作为 AMIS form 的 controls / body 字段使用。
 *
 * @param {Object} typeDef - CredentialType 定义（来自 typeList()）
 * @param {boolean} [maskSensitive=true] - 编辑态是否将 sensitive 字段渲染为占位 ****
 * @returns {Array<Object>} AMIS form item 配置数组
 */
export function typeFieldsToAmisForm(typeDef, maskSensitive) {
    if (!typeDef || !typeDef.fields) {
        return [];
    }
    var mask = maskSensitive !== false;
    var result = [];
    for (var i = 0; i < typeDef.fields.length; i++) {
        var f = typeDef.fields[i];
        var item = {
            type: fieldTypeToAmisWidget(f.type, f.sensitive && mask),
            name: f.name,
            label: f.label || f.name,
            required: !!f.required
        };
        if (f.defaultValue != null && f.defaultValue !== '') {
            item.value = f.defaultValue;
        }
        if (f.type === 'select') {
            // select 选项由具体类型定义补充；这里保留 options 占位
            item.options = [];
        }
        result.push(item);
    }
    return result;
}

/**
 * 把字段类型字符串映射为 AMIS 控件 type。
 * 敏感字段在 mask 模式下用 input-password（编辑态显示 **** 占位）。
 */
function fieldTypeToAmisWidget(fieldType, mask) {
    if (mask) {
        return 'input-password';
    }
    switch (fieldType) {
        case 'password':
            return 'input-password';
        case 'number':
            return 'input-number';
        case 'select':
            return 'select';
        case 'boolean':
            return 'switch';
        case 'textarea':
            return 'textarea';
        case 'string':
        default:
            return 'input-text';
    }
}
