<?xml version="1.0" encoding="UTF-8" ?>
<auth x:schema="/nop/schema/action-auth.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:i18n-en="i18n-en"
      xmlns:auth-gen="auth-gen" xmlns:xpl="xpl">

    <x:post-extends>
        <auth-gen:DefaultActionAuthPostExtends xpl:lib="/nop/auth/xlib/auth-gen.xlib"/>
    </x:post-extends>

    <site id="main">
        <resource id="test-orm-nop-credential" displayName="测试nop-credential" i18n-en:displayName="Test nop-credential"
                  icon="key" resourceType="TOPM" orderNo="10000" routePath="/test-orm-nop-credential"
                  component="layouts/default/index">
            <children>
                <resource id="NopCredential-main" displayName="加密凭证" orderNo="10001" i18n-en:displayName="Credential"
                          icon="key" component="AMIS" resourceType="SUBM"
                          url="/nop/credential/pages/NopCredential/main.page.yaml">
                    <children>
                        <resource id="FNPT:NopCredential:query" displayName="查询加密凭证"
                                  i18n-en:displayName="Query Credential" orderNo="10002" resourceType="FNPT">
                            <permissions>NopCredential:query</permissions>
                        </resource>
                        <resource id="FNPT:NopCredential:mutation" displayName="修改加密凭证"
                                  i18n-en:displayName="Modify Credential" orderNo="10003" resourceType="FNPT">
                            <permissions>NopCredential:mutation</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopCredentialOauthState-main" displayName="OAuth授权State绑定" orderNo="10004"
                          i18n-en:displayName="OAuth State" icon="blocks" component="AMIS" resourceType="SUBM"
                          url="/nop/credential/pages/NopCredentialOauthState/main.page.yaml">
                    <children>
                        <resource id="FNPT:NopCredentialOauthState:query" displayName="查询OAuth授权State绑定"
                                  i18n-en:displayName="Query OAuth State" orderNo="10005" resourceType="FNPT">
                            <permissions>NopCredentialOauthState:query</permissions>
                        </resource>
                        <resource id="FNPT:NopCredentialOauthState:mutation" displayName="修改OAuth授权State绑定"
                                  i18n-en:displayName="Modify OAuth State" orderNo="10006" resourceType="FNPT">
                            <permissions>NopCredentialOauthState:mutation</permissions>
                        </resource>
                    </children>
                </resource>
                <resource id="NopCredentialUsage-main" displayName="凭证使用记录" orderNo="10007"
                          i18n-en:displayName="Credential Usage" icon="link" component="AMIS" resourceType="SUBM"
                          url="/nop/credential/pages/NopCredentialUsage/main.page.yaml">
                    <children>
                        <resource id="FNPT:NopCredentialUsage:query" displayName="查询凭证使用记录"
                                  i18n-en:displayName="Query Credential Usage" orderNo="10008" resourceType="FNPT">
                            <permissions>NopCredentialUsage:query</permissions>
                        </resource>
                        <resource id="FNPT:NopCredentialUsage:mutation" displayName="修改凭证使用记录"
                                  i18n-en:displayName="Modify Credential Usage" orderNo="10009" resourceType="FNPT">
                            <permissions>NopCredentialUsage:mutation</permissions>
                        </resource>
                    </children>
                </resource>
            </children>
        </resource>
    </site>
</auth>