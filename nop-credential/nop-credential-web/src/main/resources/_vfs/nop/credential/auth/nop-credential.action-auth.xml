<?xml version="1.0" encoding="UTF-8" ?>
<!--
    NopCredential 管理页 action-auth delta（W11 归属统一后；A1-audit 2026-08-17 注释措辞修正 + OauthState 收口）。
    在 codegen 生成的 query/mutation 角色基础上做显式声明：
      - NopCredential:query / NopCredential:mutation（含 test）/ saveCredential：delta 层不设角色限制
        （区别于下方 delete/reencryptAll 的 roles="admin"）。平台 action-auth 为按角色授予语义
        （未授予角色的 permission 默认拒绝），部署方经角色管理按需授予后，角色分级由 BizModel 运行时
        判定执行（system=管理员 / user=owner+管理员）——不在 delta 层提前限 admin（否则普通用户的
        user 级凭证功能在 GraphQL 入口即 403，功能不可达）。标准 update/batchDelete/updateByQuery/
        deleteByQuery/copyForNew 已在 BizModel 禁用。
      - NopCredential:delete / reencryptAll：仅 admin 角色。
      - NopCredentialUsage:query / mutation：仅 admin 角色（usage 引用关系属管理信息，
        消费方登记走 SPI registerUsage/unregisterUsage 不受影响；BizModel 层另有运行时判定双层防御）。
      - NopCredentialAuth:query / mutation：仅 admin 角色（授权记录属管理信息，grant/revoke
        由 BizModel 运行时 admin 判定执行第二层防御）。
      - NopCredentialOauthState:query / mutation：仅 admin 角色（A1-audit D2-01/D4-01 收口：
        state 绑定为 OAuth 引擎内部存储，查询面 admin-only + 全部标准 mutation 在 BizModel 禁用，
        双层防御之 action-auth 层）。
-->
<auth x:extends="_nop-credential.action-auth.xml" x:schema="/nop/schema/action-auth.xdef"
      xmlns:x="/nop/schema/xdsl.xdef">

    <site id="main">
        <resource id="test-orm-nop-credential">
            <children>
                <!-- 与生成基件同构嵌套（NopCredential-main 下），确保按 resource id 精确覆盖合并 -->
                <resource id="NopCredential-main">
                    <children>
                        <!-- 查询权限：所有登录用户（行级可见性由 BizModel 结构性过滤执行） -->
                        <resource id="FNPT:NopCredential:query" displayName="查询加密凭证"
                                   i18n-en:displayName="Query Credential" orderNo="10002" resourceType="FNPT">
                            <permissions>NopCredential:query</permissions>
                        </resource>

                        <!-- 修改权限（含 test）：所有登录用户——角色分级由 BizModel 运行时判定执行（W11） -->
                        <resource id="FNPT:NopCredential:mutation" displayName="修改加密凭证"
                                   i18n-en:displayName="Modify Credential" orderNo="10003" resourceType="FNPT">
                            <permissions>NopCredential:mutation</permissions>
                        </resource>

                        <!-- saveCredential（明文输入入口）：所有登录用户（scope/ownerId 分级由 BizModel
                             运行时判定：system 限管理员；user 级普通用户 owner=本人；管理员可代建） -->
                        <resource id="FNPT:NopCredential:saveCredential" displayName="保存凭证（明文入口）"
                                   i18n-en:displayName="Save Credential (Plaintext Entry)" orderNo="10010"
                                   resourceType="FNPT">
                            <permissions>NopCredential:saveCredential</permissions>
                        </resource>

                        <!-- 删除凭证：仅 admin 角色（BizModel 引用计数拦截 + 写分级 + 软删除） -->
                        <resource id="FNPT:NopCredential:delete" displayName="删除凭证"
                                   i18n-en:displayName="Delete Credential" orderNo="10011"
                                   resourceType="FNPT" roles="admin">
                            <permissions>NopCredential:delete</permissions>
                        </resource>

                        <!-- 批量重加密（密钥轮换）：仅 admin 角色 -->
                        <resource id="FNPT:NopCredential:reencryptAll" displayName="批量重加密"
                                   i18n-en:displayName="Batch Re-encrypt" orderNo="10012"
                                   resourceType="FNPT" roles="admin">
                            <permissions>NopCredential:reencryptAll</permissions>
                        </resource>
                    </children>
                </resource>

                <!-- W11：usage 引用关系属管理信息，查询/修改面收紧 admin（双层防御之 action-auth 层）。
                     与生成基件同构嵌套（NopCredentialUsage-main 下），确保按 resource id 精确覆盖合并。
                     orderNo 对齐基件实际值（A1-audit 复核观察项修正）。 -->
                <resource id="NopCredentialUsage-main">
                    <children>
                        <resource id="FNPT:NopCredentialUsage:query" displayName="查询凭证使用记录"
                                   i18n-en:displayName="Query Credential Usage" orderNo="10011" resourceType="FNPT"
                                   roles="admin">
                            <permissions>NopCredentialUsage:query</permissions>
                        </resource>
                        <resource id="FNPT:NopCredentialUsage:mutation" displayName="修改凭证使用记录"
                                   i18n-en:displayName="Modify Credential Usage" orderNo="10012" resourceType="FNPT"
                                   roles="admin">
                            <permissions>NopCredentialUsage:mutation</permissions>
                        </resource>
                    </children>
                </resource>

                <!-- W11 Part B：凭证取用授权（RBAC 收紧）管理面收紧 admin——授权记录属管理信息，
                     grant/revoke/查询均限管理员（BizModel 运行时判定为第二层，无登录态同样拒绝）。
                     与生成基件同构嵌套（NopCredentialAuth-main 下），确保按 resource id 精确覆盖合并。 -->
                <resource id="NopCredentialAuth-main">
                    <children>
                        <resource id="FNPT:NopCredentialAuth:query" displayName="查询凭证取用授权"
                                   i18n-en:displayName="Query Credential Use Authorization" orderNo="10005"
                                   resourceType="FNPT" roles="admin">
                            <permissions>NopCredentialAuth:query</permissions>
                        </resource>
                        <resource id="FNPT:NopCredentialAuth:mutation" displayName="修改凭证取用授权"
                                   i18n-en:displayName="Modify Credential Use Authorization" orderNo="10006"
                                   resourceType="FNPT" roles="admin">
                            <permissions>NopCredentialAuth:mutation</permissions>
                        </resource>
                    </children>
                </resource>

                <!-- A1-audit D2-01/D4-01 收口：OAuth state 绑定为引擎内部存储，查询/修改面收紧 admin
                     （双层防御之 action-auth 层；BizModel 层运行时 admin 判定 + 全部标准 mutation 禁用）。
                     与生成基件同构嵌套（NopCredentialOauthState-main 下），确保按 resource id 精确覆盖合并。 -->
                <resource id="NopCredentialOauthState-main">
                    <children>
                        <resource id="FNPT:NopCredentialOauthState:query" displayName="查询OAuth授权State绑定"
                                   i18n-en:displayName="Query OAuth State" orderNo="10008" resourceType="FNPT"
                                   roles="admin">
                            <permissions>NopCredentialOauthState:query</permissions>
                        </resource>
                        <resource id="FNPT:NopCredentialOauthState:mutation" displayName="修改OAuth授权State绑定"
                                   i18n-en:displayName="Modify OAuth State" orderNo="10009" resourceType="FNPT"
                                   roles="admin">
                            <permissions>NopCredentialOauthState:mutation</permissions>
                        </resource>
                    </children>
                </resource>
            </children>
        </resource>
    </site>
</auth>
