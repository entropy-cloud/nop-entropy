<?xml version="1.0" encoding="UTF-8" ?>
<orm ext:registerShortName="true" ext:appName="nop-credential" ext:icon="key" ext:entityPackageName="io.nop.credential.dao.entity"
     ext:basePackageName="io.nop.credential" ext:mavenGroupId="io.github.entropy-cloud" ext:mavenArtifactId="nop-credential"
     ext:mavenVersion="2.0.0-SNAPSHOT" ext:platformVersion="2.0.0-SNAPSHOT" ext:dialect="mysql,oracle,postgresql"
     x:schema="/nop/schema/orm/orm.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <domains>
        <domain name="version" stdSqlType="INTEGER"/>
        <domain name="createTime" stdSqlType="TIMESTAMP"/>
        <domain name="createdBy" precision="50" stdSqlType="VARCHAR"/>
        <domain name="updateTime" stdSqlType="TIMESTAMP"/>
        <domain name="updatedBy" precision="50" stdSqlType="VARCHAR"/>
        <domain name="remark" precision="1" stdSqlType="VARCHAR"/>
        <domain name="delFlag" stdDomain="boolFlag" stdSqlType="TINYINT"/>
    </domains>

    <entities>
        <entity className="io.nop.credential.dao.entity.NopCredential" createTimeProp="createTime" createrProp="createdBy"
                deleteFlagProp="delFlag" displayName="加密凭证" name="io.nop.credential.dao.entity.NopCredential"
                registerShortName="true" tableName="nop_credential" tagSet="audit" useLogicalDelete="true"
                versionProp="version" updaterProp="updatedBy"
                ext:icon="key" i18n-en:displayName="Credential">
            <columns>
                <column code="CREDENTIAL_ID" displayName="凭证ID" mandatory="true" name="credentialId" precision="50" primary="true"
                        propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="var" i18n-en:displayName="Credential ID"/>
                <column code="CREDENTIAL_NAME" displayName="凭证名" name="name" precision="100" propId="2"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Name"/>
                <column code="TYPE_NAME" displayName="凭证类型" name="typeName" precision="100" propId="3"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Type Name"/>
                <column code="DATA" displayName="加密数据" name="data" precision="4000" propId="4"
                        stdDataType="string" stdSqlType="VARCHAR" tagSet="var"
                        comment="cv1:{keyId}:{v1密文} 格式的加密凭证字段JSON" i18n-en:displayName="Encrypted Data"/>
                <column code="STATUS" displayName="状态" name="status" precision="20" propId="5"
                        stdDataType="string" stdSqlType="VARCHAR" defaultValue="enabled"
                        i18n-en:displayName="Status"/>
                <column code="DEL_FLAG" displayName="删除标识" domain="delFlag" mandatory="true" name="delFlag" propId="6"
                        stdDataType="byte" stdDomain="boolFlag" stdSqlType="TINYINT" ui:show="X"
                        i18n-en:displayName="Deleted"/>
                <column code="USAGE_SCOPE" displayName="使用范围" name="usageScope" precision="50" propId="7"
                        stdDataType="string" stdSqlType="VARCHAR" i18n-en:displayName="Usage Scope"/>
                <column code="LAST_USED_AT" displayName="最后使用时间" name="lastUsedAt" propId="8"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Last Used At"/>
                <column code="EXPIRE_AT" displayName="过期时间" name="expireAt" propId="9"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Expire At"/>
                <column code="TEST_RESULT" displayName="连通性测试结果" name="testResult" precision="500" propId="10"
                        stdDataType="string" stdSqlType="VARCHAR" ui:show="L" i18n-en:displayName="Test Result"/>
                <column code="VERSION" displayName="版本" domain="version" mandatory="true" name="version" propId="11"
                        stdDataType="int" stdSqlType="INTEGER" ui:show="X" i18n-en:displayName="Version"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" mandatory="true" name="createTime"
                        propId="12" stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Create Time"/>
                <column code="CREATED_BY" displayName="创建人" domain="createdBy" mandatory="true" name="createdBy"
                        precision="50" propId="13" stdDataType="string" stdSqlType="VARCHAR"
                        i18n-en:displayName="Created By"/>
                <column code="UPDATE_TIME" displayName="更新时间" domain="updateTime" name="updateTime" propId="14"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" ui:show="L" i18n-en:displayName="Update Time"/>
                <column code="UPDATED_BY" displayName="更新人" domain="updatedBy" name="updatedBy" propId="15"
                        precision="50" stdDataType="string" stdSqlType="VARCHAR" ui:show="L"
                        i18n-en:displayName="Updated By"/>
                <column code="REMARK" displayName="备注" domain="remark" name="remark" precision="200" propId="16"
                        stdDataType="string" stdSqlType="VARCHAR" ui:show="L" i18n-en:displayName="Remark"/>
            </columns>
            <relations>
                <to-many cascadeDelete="true" displayName="凭证使用记录" name="usages"
                         refEntityName="io.nop.credential.dao.entity.NopCredentialUsage" refPropName="credential"
                         tagSet="pub,cascade-delete" i18n-en:displayName="Usages">
                    <join>
                        <on leftProp="credentialId" rightProp="credentialId"/>
                    </join>
                </to-many>
            </relations>
        </entity>

        <entity className="io.nop.credential.dao.entity.NopCredentialUsage" createTimeProp="createTime"
                displayName="凭证使用记录" name="io.nop.credential.dao.entity.NopCredentialUsage"
                registerShortName="true" tableName="nop_credential_usage"
                ext:icon="link" i18n-en:displayName="Credential Usage">
            <columns>
                <column code="USAGE_ID" displayName="使用记录ID" mandatory="true" name="usageId" precision="50" primary="true"
                        propId="1" stdDataType="string" stdSqlType="VARCHAR" tagSet="var" i18n-en:displayName="Usage ID"/>
                <column code="CREDENTIAL_ID" displayName="凭证ID" mandatory="true" name="credentialId" precision="50" propId="2"
                        stdDataType="string" stdSqlType="VARCHAR" tagSet="var" i18n-en:displayName="Credential ID"/>
                <column code="CONSUMER_REF" displayName="消费者引用" mandatory="true" name="consumerRef" precision="200" propId="3"
                        stdDataType="string" stdSqlType="VARCHAR" tagSet="var" i18n-en:displayName="Consumer Ref"/>
                <column code="CREATE_TIME" displayName="创建时间" domain="createTime" name="createTime" propId="4"
                        stdDataType="timestamp" stdSqlType="TIMESTAMP" i18n-en:displayName="Create Time"/>
            </columns>
            <relations>
                <to-one displayName="凭证" name="credential"
                         refEntityName="io.nop.credential.dao.entity.NopCredential" refPropName="usages"
                         tagSet="pub,ref-pub" i18n-en:displayName="Credential">
                    <join>
                        <on leftProp="credentialId" rightProp="credentialId"/>
                    </join>
                </to-one>
            </relations>
            <unique-keys>
                <unique-key columns="credentialId,consumerRef" constraint="UK_NOP_CREDENTIAL_USAGE_CRED_CONSUMER"
                            name="credentialConsumer"/>
            </unique-keys>
        </entity>
    </entities>
</orm>
