<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns:ioc="ioc">

    <bean id="nopFileToolBizModel" class="io.nop.ai.tools.file.FileToolBizModel">
    </bean>

    <bean id="nopSequentialThinkingBizModel"
          class="io.nop.ai.tools.sequential_thinking.service.SequentialThinkingBizModel">
        <property name="storageDirPath" value="@cfg:nop.ai.sequential-thinking-tool.storage-dir-path|./_tmp/ai/sequential-thinking/store"/>
    </bean>

    <!--
    P3-MA1-016: nopGraphQLToolSet 仅在存在 nopGraphQLEngine bean 时注册（bean 名匹配，
    非接口名 IGraphQLEngine）。GraphQLToolSetFactoryBean @Inject IGraphQLEngine（setter），
    在排除 nop-biz / 自定义 beans 集的装配上下文中无条件实例化会导致启动失败。
    与仓库既有条件注册实例（biz-defaults nopCrudBizInitializer 等）语法一致。
    -->
    <bean id="nopGraphQLToolSet" class="io.nop.ai.tools.graphql.GraphQLToolSetFactoryBean">
        <ioc:condition>
            <on-bean>nopGraphQLEngine</on-bean>
        </ioc:condition>
    </bean>

</beans>