<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.entropy-cloud</groupId>
        <artifactId>nop-ai</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nop-ai-core</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-ai-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-api-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-http-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-http-client-jdk</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-xlang</artifactId>
        </dependency>

        <!-- Rule-based selection strategy (W5b, plan 2026-08-15-1116-1): the
             RuleBasedSelectionStrategy consumes IRuleManager (nop-rule-core)
             to run platform rule.xdef decision trees. Acyclic: nop-rule-core
             depends only on nop-rule-api/nop-xlang/nop-ooxml-xlsx. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-rule-core</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-markdown</artifactId>
        </dependency>

        <!-- K1/N4.2 (plans knowledge-rag/01, nop-code/23): bridge the platform
             ITextEmbedding SPI to IEmbeddingModel. nop-search-api is a light
             api-only jar (depends on nop-api-core only); the SPI javadoc keeps
             nop-search itself independent of nop-ai — the bridge lives here. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-search-api</artifactId>
        </dependency>

        <!-- Test-scope only: wiring/e2e tests exercise the bridge inside the
             real LuceneSearchEngine. Acyclic: nop-search-lucene does not
             depend on nop-ai-core. -->
        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-search-lucene</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.github.entropy-cloud</groupId>
            <artifactId>nop-autotest-junit</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>