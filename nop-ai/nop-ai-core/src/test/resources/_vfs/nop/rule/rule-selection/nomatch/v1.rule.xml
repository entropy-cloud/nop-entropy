<rule ruleName="rule-selection/nomatch" ruleVersion="1"
      x:schema="/nop/schema/rule.xdef" xmlns:x="/nop/schema/xdsl.xdef">

    <!--
    W5b test rule (plan 2026-08-15-1116-1, Phase 3): NEVER matches (<alwaysFalse/>
    predicate — filter-op form, no index access needed). Semantic branch 1 of the
    strategy: isRuleMatch()==false → strategy returns null (caller fail-loud).
    -->

    <input name="model"/>
    <input name="provider"/>
    <input name="candidates"/>
    <input name="health"/>
    <input name="attempted"/>

    <output name="selectedIndex" type="int"/>

    <decisionTree>
        <children>
            <child id="never" label="never matches">
                <predicate>
                    <alwaysFalse/>
                </predicate>
                <output name="selectedIndex">
                    <valueExpr>0</valueExpr>
                </output>
            </child>
        </children>
    </decisionTree>
</rule>
