<llm x:schema="/nop/schema/ai/llm.xdef" xmlns:x="/nop/schema/xdsl.xdef"
     x:extends="default.llm.xml" apiStyle="openai" supportToolCalls="true"
     defaultModel="gw-model-1" concurrencyLimit="2">

    <!--
    W6 测试用 provider：主账号（config 变量 nop.ai.llm.gw-test.api-key，测试内 assign）+ 2 个
    有序备用账号（key-gw-a limit 1；key-gw-b 带 baseUrl 覆盖 limit 1）。
    -->

    <baseUrl>https://gw-test.example.com</baseUrl>
    <chatUrl>/v1/chat/completions</chatUrl>

    <accounts>
        <account id="gw-backup-a" apiKey="key-gw-a" concurrencyLimit="1"/>
        <account id="gw-backup-b" apiKey="key-gw-b"
                 baseUrl="https://gw-b.example.com" concurrencyLimit="1"/>
    </accounts>

</llm>
