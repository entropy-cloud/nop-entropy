<llm x:schema="/nop/schema/ai/llm.xdef" xmlns:x="/nop/schema/xdsl.xdef"
     x:extends="default.llm.xml" apiStyle="openai" supportToolCalls="true"
     defaultModel="gw-sat-model" concurrencyLimit="2">

    <!--
    W6 测试用 provider：饱和/探活场景——provider 级缺省并发上限 2（主账号回退此值）+
    两个备用账号各显式 limit 1。全候选饱和 = 主账号 ×2 + s1 ×1 + s2 ×1。
    -->

    <baseUrl>https://gw-sat.example.com</baseUrl>
    <chatUrl>/v1/chat/completions</chatUrl>

    <accounts>
        <account id="gw-sat-s1" apiKey="key-sat-s1" concurrencyLimit="1"/>
        <account id="gw-sat-s2" apiKey="key-sat-s2" concurrencyLimit="1"/>
    </accounts>

</llm>
