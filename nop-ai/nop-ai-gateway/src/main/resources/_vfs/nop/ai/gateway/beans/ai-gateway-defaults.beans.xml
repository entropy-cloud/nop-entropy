<?xml version="1.0" encoding="UTF-8" ?>

<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <bean id="nopBackendMessageConverter_AI_DIALECT"
          class="io.nop.ai.gateway.AiDialectBackendMessageConverter"
          ioc:type="io.nop.gateway.conversion.IBackendMessageConverter">
        <property name="frontendLlm" value="openai"/>
        <property name="backendLlm" value="openai"/>
    </bean>

    <!-- Channel transport layer (W1): unified registry + lifecycle for all
         IChannelConnector beans. Concrete connectors (FeishuConnector etc.)
         arrive in W5 and are auto-collected here by type. With no connectors
         registered yet the collected list is empty and startAll/stopAll are
         legitimate no-ops over an empty set (not a silent skip of work). -->
    <bean id="channelConnectorManager"
          class="io.nop.ai.gateway.channel.ChannelConnectorManager">
        <property name="connectors">
            <ioc:collect-beans by-type="io.nop.ai.gateway.channel.IChannelConnector"
                               ioc:ignore-depends="true" only-concrete-classes="true"/>
        </property>
    </bean>

</beans>
