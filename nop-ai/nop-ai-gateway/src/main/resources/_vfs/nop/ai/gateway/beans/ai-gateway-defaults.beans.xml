<?xml version="1.0" encoding="UTF-8" ?>

<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <!-- M7-P1 round-3 (this plan): feishu protocol beans are a REQUIRED part
         of the gateway's production bean set (nopFeishuConnector @Inject
         FeishuClient/FeishuCredentials). nop-integration-feishu is a compile
         dependency of nop-ai-gateway, so its beans.xml is always present on a
         gateway classpath — import it here so the auto-assembly (via
         /nop/autoconfig/nop-ai-gateway.beans) resolves the connector's
         injections. -->

    <import resource="/nop/integration/feishu/beans/feishu-defaults.beans.xml"/>

    <bean id="nopBackendMessageConverter_AI_DIALECT"
          class="io.nop.ai.gateway.AiDialectBackendMessageConverter"
          ioc:type="io.nop.gateway.conversion.IBackendMessageConverter">
        <property name="frontendLlm" value="openai"/>
        <property name="backendLlm" value="openai"/>
    </bean>

    <!-- Channel transport layer (W1): unified registry + lifecycle for all
         IChannelConnector beans. Concrete connectors (FeishuConnector etc.)
         arrive in W5 and are auto-collected here by type. With no connectors
         registered yet the collected list is empty and startAll/stopAll are
         legitimate no-ops over an empty set (not a silent skip of work). -->
    <bean id="nopChannelConnectorManager"
          class="io.nop.ai.gateway.channel.ChannelConnectorManager">
        <property name="connectors">
            <ioc:collect-beans by-type="io.nop.ai.gateway.channel.IChannelConnector"
                               ioc:ignore-depends="true" only-concrete-classes="true"/>
        </property>
    </bean>

    <!-- Channel session store (W1): default DB-backed IChannelSessionStore.
         Injected into connectors via @Inject (NopIoC). Depends on IDaoProvider
         + IOrmTemplate (from nop-dao, already on classpath via nop-ai-dao). -->
    <bean id="nopChannelSessionStore"
          class="io.nop.ai.gateway.channel.ChannelSessionStoreImpl"
          ioc:type="io.nop.ai.gateway.channel.IChannelSessionStore"/>

    <!-- Feishu channel connector (W5-3): bridges FeishuClient Stream messages
         to IAgentEngine.execute(). Auto-collected by channelConnectorManager
         above (by-type IChannelConnector). FeishuClient, FeishuCredentials
         (nopFeishuCredentials) and FeishuBindProvider beans come from
         nop-integration-feishu's feishu-defaults.beans.xml, imported at the
         top of this file (nop-integration-feishu is a compile dependency of
         nop-ai-gateway); IChannelSessionStore
         is the channelSessionStore bean above. All three are @Inject fields
         (protected — NopIoC constraint: no private injection).
         Credential precedence in FeishuConnector.resolveCredentials
         (P2-CHANNEL, plan 2026-09-14-1937-2):
           1. ChannelConfig options face: feishu.appId + feishu.appSecret pair,
              or the feishu.credentials object (literal semantics; the options
              face intentionally ignores feishu.credentialId);
           2. the injected nopFeishuCredentials bean (nop.integration.feishu.*
              config, incl. nop.integration.feishu.credentialId reference);
           3. empty credentials → FeishuClient.start fail-fast ("appId not
              configured").
         nop-integration-feishu is a compile dependency of nop-ai-gateway
         (the class is always present when this beans file loads). -->
    <bean id="nopFeishuConnector"
          class="io.nop.ai.gateway.channel.feishu.FeishuConnector"/>

    <!-- Business message layer (W2): the usage-layer facade that routes
         identity-anchored OutboundChannelMessage (nop-integration-api) to the
         transport-layer IChannelConnector via the resolver + manager. The
         UserChannelResolver impl lives in nop-auth-service and is injected
         optionally (ioc:optional) so a channel-less gateway deployment that
         does not include nop-auth-service still starts — sendToUser then
         returns NO_BINDING. ChannelConnectorManager is always present (same
         beans file above).

         Inbound backbone (W6-4, design §3.3 问题 B): the optional
         IMessageService activates "mode 2" (publish to the
         channel.inbound.{channelType} topic + internal bridge fan-out +
         external multi-consumers). The reference uses the REAL platform
         bean id nopLocalMessageService (from nop-message-core's
         message-core-defaults.beans.xml) — there is intentionally no bean
         with id "messageService" in the platform, so referencing a made-up id
         would silently resolve to null and mode 2 would never activate.
         ioc:optional makes this resolve to null (mode 1, direct fan-out) when
         no IMessageService implementation is on the deployment classpath, and
         to the real instance when nop-message-core (or an equivalent impl) is
         present. A Kafka/Pulsar deployment substitutes its own bean id. -->
    <bean id="nopChannelMessageService"
          class="io.nop.ai.gateway.channel.ChannelMessageServiceImpl"
          ioc:type="io.nop.integration.api.channel.IChannelMessageService"
          ioc:default="true">
        <property name="userChannelResolver">
            <ref bean="nopUserChannelResolver" ioc:optional="true"/>
        </property>
        <property name="channelConnectorManager">
            <ref bean="nopChannelConnectorManager"/>
        </property>
        <property name="messageService">
            <ref bean="nopLocalMessageService" ioc:optional="true"/>
        </property>
        <!-- AR-9: inbound dispatch deadline (I3 R-2-1) wired to the config
             item promised by ChannelMessageServiceImpl javadoc. Default 30000
             must stay in sync with DEFAULT_DISPATCH_TIMEOUT_MS. -->
        <property name="dispatchTimeoutMs"
                  value="@cfg:nop.ai.gateway.channel.dispatchTimeoutMs|30000"/>
    </bean>

    <!-- Scan-login orchestration (W4): the QR-scan-login callback endpoint
         (@BizModel "ChannelLoginApi", exposed as GraphQL ChannelLoginApi__loginByScan
         or REST /r/ChannelLoginApi__loginByScan). Registered with the FQCN id
         + ioc:type="@bean:id" pattern used by LoginApiBizModel. The @Inject
         fields (IAuthTokenProvider required; ISessionBootstrap and
         IChannelBindService optional/@Nullable) are auto-wired by type by the
         container — the two auth-service beans are optional so a channel-less
         gateway deployment that excludes nop-auth-service still starts, and
         loginByScan fails explicitly on first call instead. Concrete
         IChannelBindProvider beans arrive in W5-2 and are auto-collected here
         by type; with no provider deployed yet the collection is empty and
         loginByScan fails explicitly on first call (no silent null). -->
    <bean id="io.nop.ai.gateway.login.ChannelLoginApiBizModel" ioc:type="@bean:id">
        <property name="channelBindProviders">
            <ioc:collect-beans by-type="io.nop.integration.api.bind.IChannelBindProvider"
                               ioc:ignore-depends="true" only-concrete-classes="true"/>
        </property>
    </bean>

    <!-- Rule-based selection strategy (W5b, plan 2026-08-15-1116-1): an
         ISelectionStrategy implementation that runs a platform rule.xdef
         decision tree (nop-rule) to pick a ModelClassCandidate. Deployment
         opt-in: the bean exists but is NOT the default (DefaultSelectionStrategy
         remains the default in ModelClassRouter); W6/W7 orchestration chooses
         which strategy bean to inject. The ruleManager ref is ioc:optional —
         a gateway deployment without nop-rule-core still starts; calling
         select() without the wired manager fails fast with
         ERR_AI_AGENT_INVALID_ARG (no silent fallback). ruleName/ruleVersion
         are deployment-level config (rule files live under /nop/rule). -->
    <bean id="nopAiRuleBasedSelectionStrategy"
          class="io.nop.ai.core.routing.RuleBasedSelectionStrategy"
          ioc:type="io.nop.ai.core.routing.ISelectionStrategy">
        <property name="ruleManager">
            <ref bean="nopRuleManager" ioc:optional="true"/>
        </property>
        <!-- Deployment-level rule identity (rule files live under /nop/rule);
             the empty default means "not configured yet" → select() fails fast
             on first use until a deployment assigns the config value. -->
        <property name="ruleName" value="@cfg:nop.ai.gateway.rule-selection.rule-name|"/>
        <!-- ruleVersion omitted: null = latest version of the rule -->
    </bean>

    <!-- W8 failover observability metrics (plan 2026-08-15-1615-1, OBS-01): default
         IFailoverMetrics implementation over micrometer (GlobalMeterRegistry, nop-job
         IJobWorkerMetrics precedent). Contract table lives in
         02-account-failover-requirement.md §3.6. ioc:default=true — a deployment that
         registers its own IFailoverMetrics wins. The refs below are NON-optional
         (Phase 1 adjudication: deployment side fails fast at container start if the
         bean is missing; code-side null setter = observation no-op only in
         tests/manual construction). -->
    <bean id="nopAiFailoverMetrics"
          class="io.nop.ai.gateway.failover.FailoverMetricsImpl"
          ioc:type="io.nop.ai.gateway.failover.IFailoverMetrics"
          ioc:default="true"/>

    <!-- W6 local failover adapter (plan 2026-08-15-1116-2): process-shared
         circuit breaker + concurrency registry singletons (Phase 1 D8/M-5 —
         the adapter MUST inject shared singletons, never let ModelClassRouter
         construct per-call defaults, or breaker state and concurrency counts
         silently degrade to per-call locality) and the IChatService adapter
         itself. The adapter is a NON-default bean (ioc:default stays on
         nopChatService in nop-ai-core) so existing by-type IChatService
         consumers (e.g. nop-wf-ai WfAiHelper) keep their zero-regression
         behavior; deployments switch by wiring their injection target to
         nopChatServiceFailoverAdapter (W8 documents the usage). -->
    <bean id="nopFailoverCircuitBreaker"
          class="io.nop.ai.core.reliability.ThresholdBreaker"/>

    <bean id="nopFailoverConcurrencyRegistry"
          class="io.nop.ai.core.routing.ConcurrencyRegistry"/>

    <bean id="nopChatServiceFailoverAdapter"
          class="io.nop.ai.gateway.failover.ChatServiceFailoverAdapter"
          ioc:type="io.nop.ai.api.chat.IChatService">
        <property name="delegate">
            <ref bean="nopChatService"/>
        </property>
        <property name="breaker">
            <ref bean="nopFailoverCircuitBreaker"/>
        </property>
        <property name="registry">
            <ref bean="nopFailoverConcurrencyRegistry"/>
        </property>
        <property name="metrics">
            <ref bean="nopAiFailoverMetrics"/>
        </property>
        <!-- strategy omitted: null = DefaultSelectionStrategy (deployments that
             want rule-based selection wire nopAiRuleBasedSelectionStrategy here;
             a deployment-level choice, not the gateway default) -->
        <property name="bufferSize" value="@cfg:nop.ai.gateway.failover.buffer-size|10"/>
        <property name="bufferTimeMs" value="@cfg:nop.ai.gateway.failover.buffer-time-ms|1000"/>
        <property name="retryBudget" value="@cfg:nop.ai.gateway.failover.retry-budget|2"/>
    </bean>

    <!-- W7 gateway-form failover interceptor (plan 2026-08-15-1116-3 Phase 4, GW-01):
         IGatewayInterceptor implementation for the standalone nop-gateway form. MOUNT
         CONTRACT (M-7): beans.xml registration alone does NOT mount it on routes — the
         deployment must reference the bean from gateway.xml
         <interceptors><interceptor id=... bean="nopAiGatewayFailoverInterceptor"/></interceptors>
         (GatewayInterceptorModel.getOrCreateInterceptor resolves the bean by name). Shares
         the process-shared breaker/registry singletons with the W6 adapter (D8/M-5 — state
         accumulates across both forms). converter = the same AI_DIALECT converter bean that
         route-level backendMessageConverter="AI_DIALECT" resolves (non-streaming path uses
         executeRouteLogic's own converter call; streaming path uses this injected one — same
         bean, B-8 no double conversion). -->
    <bean id="nopAiGatewayFailoverInterceptor"
          class="io.nop.ai.gateway.failover.AiGatewayFailoverInterceptor"
          ioc:type="io.nop.gateway.core.interceptor.IGatewayInterceptor">
        <property name="breaker">
            <ref bean="nopFailoverCircuitBreaker"/>
        </property>
        <property name="registry">
            <ref bean="nopFailoverConcurrencyRegistry"/>
        </property>
        <property name="converter">
            <ref bean="nopBackendMessageConverter_AI_DIALECT"/>
        </property>
        <property name="metrics">
            <ref bean="nopAiFailoverMetrics"/>
        </property>
        <!-- strategy omitted: null = DefaultSelectionStrategy (deployments that
             want rule-based selection wire nopAiRuleBasedSelectionStrategy here) -->
        <property name="retryBudget" value="@cfg:nop.ai.gateway.failover.retry-budget|2"/>
        <!-- primary provider for provider-chain extension; default = nop.ai.service.default-llm -->
        <property name="primaryProvider" value="@cfg:nop.ai.gateway.failover.primary-provider|"/>
    </bean>

</beans>
