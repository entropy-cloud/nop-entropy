<?xml version="1.0" encoding="UTF-8" ?>
<workflow x:extends="/nop/wf/base/oa.xwf"
          x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef"
          xmlns:c="c"
          wfName="tagLabelConfirmApproval" wfVersion="1" displayName="语义标注审批流程">
    <description>语义标注审批流程：提交审批 → 数据管家审核 → 结束</description>


    <listeners>
        <listener id="onEndNotify" eventPattern="*end">
            <source>
                <c:script><![CDATA[
                    // 幂等：仅在 approveStatus=SUBMITTED 时调用 approve（避免 before-end/after-end 重复触发，
                    // 参照平台 approval-form 测试流模式）。wf 正常结束（agree 正路径）即视为审批通过；
                    // 但经基模板 oa.xwf 的 disagree 动作结束（wf.record.appState='disagree'，驳回/退回路径）
                    // 不视为通过——不得调用 approve（MA7.6-01：驳回即通过 / 发起人可自批）。
                    const wfAppState = wfRt.wf.record.appState;
                    if (wfAppState !== 'disagree') {
                        const bizObjManager = inject('nopBizObjectManager');
                        const entityBizObj = bizObjManager.getBizObject('NopMetaTagLabel');
                        const entityId = wfRt.wf.bizEntityId;
                        if (entityId != null) {
                            const entity = entityBizObj.invoke('requireEntity', {id: entityId}, null, wfRt.svcCtx);
                            if (entity.approveStatus === 'SUBMITTED') {
                                entityBizObj.invoke('approve', {id: entityId}, null, wfRt.svcCtx);
                            }
                        }
                    }
                ]]></c:script>
            </source>
        </listener>
    </listeners>

    <auths>
        <auth id="auth1" actorType="all" actorId="all" allowStart="true"/>
    </auths>

    <start startStepName="submit"/>
    <end/>

    <steps>
        <step name="submit" displayName="提交申请">
            <assignment>
                <actors>
                    <actor actorModelId="starter" actorType="wf-actor:Starter" selectUser="true"/>
                </actors>
            </assignment>
            <transition onAppStates="agree" splitType="and">
                <to-step stepName="reviewer-check"/>
            </transition>
        </step>

        <step name="reviewer-check" displayName="数据管家审核" allowReject="true">
            <assignment>
                <actors>
                    <actor actorModelId="reviewer" actorType="role" actorId="metadata-admin"
                           selectUser="true"/>
                </actors>
            </assignment>
            <transition onAppStates="agree" splitType="and">
                <to-end/>
            </transition>
        </step>
    </steps>
</workflow>
