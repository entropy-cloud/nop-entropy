<?xml version="1.0" encoding="UTF-8" ?>
<workflow x:extends="/nop/wf/base/oa.xwf"
          x:schema="/nop/schema/wf/wf.xdef" xmlns:x="/nop/schema/xdsl.xdef"
          xmlns:c="c"
          wfName="qualityBreachApproval" wfVersion="1" displayName="质量告警审批流程">
    <description>质量告警审批流程：规则 FAIL+ERROR → Owner 调查处理（已修复/误报）→ 自动验证或关闭</description>


    <auths>
        <auth id="auth1" actorType="all" actorId="all" allowStart="true"/>
    </auths>

    <start startStepName="owner-investigate">
        <!-- 启动参数由 QualityAlertWorkflowProcessor.createAlertWorkflow 传入（MA7.6-02 启动路径修复后
             参数必须显式声明，否则 _start_ 动作校验抛 unknown-action-arg）。不声明 persist：persist 参数
             在空 args 启动时会向 NopWfVar 写入 null 值行，触发 mandatory fieldType 违约（引擎 persist 循环
             无 null 守卫）；参数值经 saveWfParams 存于 record.params（仅存实际传入的 key），
             verify 步骤脚本从 wfRt.wf.record.params 读取。 -->
        <arg name="ruleId" type="String" displayName="规则ID"/>
        <arg name="tableId" type="String" displayName="目标表ID"/>
        <arg name="severity" type="String" displayName="严重级别"/>
        <arg name="message" type="String" displayName="告警消息"/>
    </start>
    <end/>

    <steps>
        <step name="owner-investigate" displayName="Owner 调查处理" allowReject="true">
            <assignment>
                <actors>
                    <actor actorModelId="owner" actorType="role" actorId="metadata-admin" selectUser="true"/>
                </actors>
            </assignment>
            <transition onAppStates="agree" splitType="and">
                <to-step stepName="verify"/>
            </transition>
        </step>

        <step name="verify" displayName="自动验证">
            <assignment>
                <actors>
                    <actor actorModelId="system" actorType="wf-actor:CurrentCaller" selectUser="false"/>
                </actors>
            </assignment>
            <source>
                <c:script><![CDATA[
                    const svc = inject('io.nop.metadata.service.quality.QualityAlertWorkflowProcessor');
                    const resultId = wfRt.wf.bizEntityId;
                    // ruleId 从 record.params 读取（saveWfParams 仅持久化实际传入的启动参数；未传入则
                    // params 无该 key → null → fail-closed reject。不能用 wfVars：arg 未声明 persist 时
                    // 引擎不写入 globalVars，且 persist 参数在空 args 启动时写 null 值行触发 mandatory
                    // fieldType 违约）
                    const ruleId = wfRt.wf.record.params != null ? wfRt.wf.record.params.ruleId : null;
                    if (resultId == null || ruleId == null) {
                        // 规则/结果缺失：fail-closed 置 reject 回退 owner 处理，不静默通过（MA7.6-03）
                        wfRt.currentStep.record.appState = 'reject';
                    } else {
                        // reJudgeFailClosed：reJudge 异常（规则/表/结果缺失或连库失败）在 Java 侧捕获转
                        // reject（fail-closed，流程不卡死在 verify）——XLang 不支持 try/catch 语句（MA7.6-03）
                        const passed = svc.reJudgeFailClosed(ruleId, resultId);
                        wfRt.currentStep.record.appState = passed ? 'agree' : 'reject';
                    }
                ]]></c:script>
            </source>
            <transition onAppStates="agree,reject" splitType="and">
                <to-end>
                    <when>wfRt.currentStep.record.appState == 'agree'</when>
                </to-end>
                <to-step stepName="owner-investigate" backLink="true">
                    <when>wfRt.currentStep.record.appState == 'reject'</when>
                </to-step>
            </transition>
        </step>
    </steps>

    <listeners>
        <listener id="onDisagree" eventPattern="*end">
            <source>
                <c:script><![CDATA[
                    // 工作流以 disagree 结束（驳回/误报路径）→ 标记误报（幂等：仅当未标记时执行，避免 before-end/after-end 重复触发）
                    const wfAppState = wfRt.wf.record.appState;
                    if (wfAppState === 'disagree') {
                        const bizObjManager = inject('nopBizObjectManager');
                        const entityBizObj = bizObjManager.getBizObject('NopMetaQualityResult');
                        const entityId = wfRt.wf.bizEntityId;
                        if (entityId != null) {
                            const entity = entityBizObj.invoke('requireEntity', {id: entityId}, null, wfRt.svcCtx);
                            if (entity.isFalsePositive == null || entity.isFalsePositive == 0) {
                                entity.isFalsePositive = 1;
                                entityBizObj.invoke('updateEntity', {entity: entity}, null, wfRt.svcCtx);
                            }
                        }
                    }
                ]]></c:script>
            </source>
        </listener>
    </listeners>
</workflow>
