<?xml version="1.0" encoding="UTF-8" ?>
<biz x:schema="/nop/schema/biz/xbiz.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:c="c"
     x:extends="_NopMetaDataContract.xbiz, /nop/wf/base/approval-support.xbiz">

    <actions>
        <mutation name="approve" displayName="通过">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source>
                <c:script><![CDATA[
                    const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                    const approveStatus = entity.approveStatus;
                    if (approveStatus !== 'SUBMITTED') {
                        throw new NopScriptError("nop.err.metadata.contract-invalid-transition")
                            .param("contractId", id)
                            .param("currentStatus", approveStatus)
                            .param("expectedStatus", "SUBMITTED");
                    }
                    entity.approveStatus = 'APPROVED';
                    entity.approvedBy = svcCtx.getUserId();
                    entity.approvedAt = now();
                    // 状态生命周期：DRAFT→ACTIVE→DEPRECATED→RETIRED（保留层 XPL 为单一事实源，参照原 Java 实现语义）
                    const status = entity.status;
                    if (status === 'DRAFT') {
                        entity.status = 'ACTIVE';
                    } else if (status === 'ACTIVE') {
                        entity.status = 'DEPRECATED';
                    } else if (status === 'DEPRECATED') {
                        entity.status = 'RETIRED';
                    }
                    return entity;
                ]]></c:script>
            </source>
        </mutation>

        <mutation name="reject" displayName="驳回">
            <arg name="id" type="String" mandatory="true"/>
            <arg name="svcCtx" kind="ServiceContext"/>
            <return>
                <schema bizObjName="THIS_OBJ"/>
            </return>
            <source>
                <c:script><![CDATA[
                    const entity = thisObj.invoke("requireEntity", {id}, null, svcCtx);
                    const approveStatus = entity.approveStatus;
                    if (approveStatus !== 'SUBMITTED') {
                        throw new NopScriptError("nop.err.metadata.contract-invalid-transition")
                            .param("contractId", id)
                            .param("currentStatus", approveStatus)
                            .param("expectedStatus", "SUBMITTED");
                    }
                    entity.approveStatus = 'REJECTED';
                    entity.approvedBy = svcCtx.getUserId();
                    entity.approvedAt = now();
                    entity.status = 'DRAFT';
                    const remark = entity.remark;
                    entity.remark = 'Rejected: ' + (remark != null ? remark : 'No reason provided');
                    return entity;
                ]]></c:script>
            </source>
        </mutation>
    </actions>
</biz>
