     x:schema="/nop/schema/orm/orm.xdef" xmlns:x="/nop/schema/xdsl.xdef" xmlns:ext="ext"
     x:extends="delta-base-one-entity.orm.xml">
    <!-- P2-07 fixture：delta 对 base 实体做部分覆盖——缺少 mandatory 属性 tableName。
