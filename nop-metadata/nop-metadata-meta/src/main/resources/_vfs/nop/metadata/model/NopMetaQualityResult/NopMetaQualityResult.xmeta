<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_NopMetaQualityResult.xmeta">

    <!-- P2-33（plan 2026-08-16-0920-2）：状态机字段收紧 GraphQL __update 输入面。
         status 只经执行/re-judge 引擎变更：QualityResultWriter.append（insert，落盘前
         ALLOWED_STATUSES fail-fast 校验 :50-55）与 QualityAlertWorkflowProcessor.reJudge
         （:130-135，qualityBreachApproval 工作流 verify 步触达）。updatable=false 后 __update
         静默丢弃该 prop（ObjMetaBasedValidator.validateForUpdate:508），内部 writer 直改实体
         不经 InputBean 校验、不受影响。insertable 保持 true：ORM mandatory（模型 :2066）且无 default，
         创建面须供值（dict meta/quality-result-status 校验仍在）。 -->
    <props>
        <prop name="status" updatable="false"/>
    </props>
</meta>
