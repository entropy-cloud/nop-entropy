<?xml version="1.0" encoding="UTF-8" ?>
<meta x:schema="/nop/schema/xmeta.xdef" xmlns:x="/nop/schema/xdsl.xdef" x:extends="_NopMetaTable.xmeta">

    <!--
        NopMetaTable 为 BI 语义层核心实体。
        sourceSql/buildSql 包含 SQL 文本（可能含列名、表名等业务敏感信息），
        标记 tagSet="sensitive" 以便在变更事件中红action。
    -->
    <props>
        <prop name="sourceSql" tagSet="sensitive"/>
        <prop name="buildSql" tagSet="sensitive"/>
    </props>
</meta>