<task x:schema="/nop/schema/task/task.xdef" xmlns:x="/nop/schema/xdsl.xdef">
    <input name="a" type="Integer"/>
    <input name="b" type="Integer"/>

    <steps>
        <xpl name="calc1" useParentScope="true">
            <source>
const x = a * 2;
return x;
            </source>
        </xpl>
        <xpl name="calc2" useParentScope="true">
            <source>
const y = RESULT + b;
return y;
            </source>
        </xpl>
    </steps>

    <output name="sum" type="Integer">
        <source>RESULT</source>
    </output>
</task>
