<?xml version="1.0" encoding="UTF-8" ?>

<dialect x:extends="default.dialect.xml,geo-support.dialect.xml,window-expr-support.dialect.xml" x:schema="/nop/schema/orm/dialect.xdef"
         xmlns:x="/nop/schema/xdsl.xdef"
         keywordQuote="&quot;" defaultNullsFirst="false"
         columnNameCase="lower"
>

    <driverClassName>org.postgresql.Driver</driverClassName>
    <dbProductNames>PostgreSQL</dbProductNames>
    <jdbcUrlPattern>jdbc:postgresql://localhost/bookstore</jdbcUrlPattern>

    <jsonTypeHandler>io.nop.dao.dialect.json.PostgreSqlJsonTypeHandler</jsonTypeHandler>
    <geometryTypeHandler>io.nop.orm.geo.dialect.postgis.PostgisGeometryTypeHandler</geometryTypeHandler>

    <reservedKeywords>
        ALL, ANALYSE, ANALYZE, AND, ANY,
        ARRAY, AS, ASC, ASYMMETRIC,AUTHORIZATION,

        BINARY, BOTH,

        CASE, CAST, CHECK,COLLATE, COLLATION,
        COLUMN,CONCURRENTLY,CONSTRAINT,CREATE,CROSS,
        CURRENT_CATALOG,CURRENT_DATE,CURRENT_ROLE,CURRENT_SCHEMA,CURRENT_TIME,
        CURRENT_TIMESTAMP,CURRENT_USER,

        DEFAULT,DEFERRABLE,DESC,DISTINCT,DO,

        ELSE,END,EXCEPT,

        FALSE,FETCH,FOR,FOREIGN,FROM,
        FULL, FREEZE,

        GRANT, GROUP,

        HAVING,

        ILIKE,IN,INITIALLY,INTERSECT,
        INNER,
        INTO, IS, ISNULL,

        JOIN,

        LATERAL, LEADING, LEFT,LIKE, LIMIT,

        LOCALTIME, LOCALTIMESTAMP,

        NATURAL,NOT,NOTNULL,NULL,

        OFFSET, ON,ONLY,OR,ORDER,
        OVERLAPS, OUTER,

        PLACING,PRIMARY,

        REFERENCES,RETURNING,RIGHT,

        SELECT, SESSION_USER,SIMILAR,SOME,SYMMETRIC,

        TABLE,TABLESAMPLE,THEN,TO,TRAILING,
        TRUE,

        UNION,UNIQUE,USER,USING,

        VARIADIC,VERBOSE,

        WHEN,WHERE,WINDOW,WITH

    </reservedKeywords>

    <errorCodes>
        <errorCode name="nop.err.dao.sql.bad-sql-grammar">
            03000,42000,42601,42602,42622,42804,42P01
        </errorCode>

        <errorCode name="nop.err.dao.sql.duplicate-key">
            23505
        </errorCode>

        <errorCode name="nop.err.dao.sql.data-integrity-violation">
            23000,23502,23503,23514
        </errorCode>
        <errorCode name="nop.err.dao.sql.data-access">
            53000,53100,53200,53300
        </errorCode>

        <errorCode name="nop.err.dao.sql.cannot-serialize-transaction">
            40001
        </errorCode>
        <errorCode name="nop.err.dao.sql.dead-lock">
            55P03,40P01
        </errorCode>
    </errorCodes>

    <features supportSequence="true" supportNullsFirst="true" supportReturningForUpdate="true"
              supportWindowFrameRows="true" supportWindowFrameRange="true"
              supportWindowFrameGroups="true"
              supportLateral="true"
    />

    <sqls escapeSlash="false" trueString="true" falseString="false">
        <createSequence>
            create sequence {sequenceName} start with {initialValue} increment by {incrementSize}
        </createSequence>

        <sequenceNextVal>select nextval('{sequenceName}')</sequenceNextVal>

        <dropSequence>drop sequence {sequenceName}</dropSequence>

                <indexExists>
                        select 1 from pg_indexes
                        where tablename = {tableName}
                            and indexname = {indexName}
                            and ({schemaName} is null or schemaname = {schemaName})
                </indexExists>

                <foreignKeyExists>
                        select 1 from information_schema.table_constraints
                        where constraint_type = 'FOREIGN KEY'
                            and constraint_name = {constraintName}
                            and ({tableName} is null or table_name = {tableName})
                            and ({schemaName} is null or table_schema = {schemaName})
                </foreignKeyExists>
    </sqls>

    <sqlDataTypes>
        <sqlDataType name="CHAR" stdSqlType="CHAR"/>
        <sqlDataType name="INTEGER" code="INT4" stdSqlType="INTEGER" alias="INT"/>
        <sqlDataType name="TINYINT" code="INT4" stdSqlType="TINYINT"/>
        <sqlDataType name="SMALLINT" code="INT4" stdSqlType="SMALLINT"/>
        <sqlDataType name="INT4"  stdSqlType="INTEGER"/>
        <sqlDataType name="INT8" stdSqlType="BIGINT"/>
        <sqlDataType name="VARCHAR" precision="4000" stdSqlType="VARCHAR"/>
        <sqlDataType name="NVARCHAR" precision="4000" stdSqlType="VARCHAR"/>
        <sqlDataType name="TEXT" stdSqlType="CLOB" />
        <sqlDataType name="DATE" stdSqlType="DATE"/>
        <sqlDataType name="DATETIME" code="TIMESTAMP" stdSqlType="DATETIME"/>
        <sqlDataType name="TIMESTAMP" stdSqlType="TIMESTAMP"/>
        <sqlDataType name="TIME" stdSqlType="TIME" />
        <sqlDataType name="FLOAT4" stdSqlType="REAL"/>
        <sqlDataType name="FLOAT8" stdSqlType="DOUBLE" alias="DOUBLE PRECISION"/>
        <sqlDataType name="NUMERIC" stdSqlType="DECIMAL"/>
        <sqlDataType name="BYTEA" stdSqlType="BLOB"/>
        <sqlDataType name="BOOLEAN" stdSqlType="BOOLEAN"/>
        <sqlDataType name="JSON" stdSqlType="JSON"/>
        <sqlDataType name="GEOMETRY" stdSqlType="GEOMETRY"/>
        <!-- WI9a: UUID 原生类型（postgresql.org/docs, 8.17 UUID Type）；postgis 继承本表 -->
        <sqlDataType name="UUID" stdSqlType="UUID"/>
    </sqlDataTypes>

    <functions>
        <native name="cosh" x:override="remove"/>
        <native name="sinh" x:override="remove"/>

        <!--
        安装扩展pgcrypto之后可以有函数gen_random_uuid()。
        或者安装扩展 uuid-ossp
        -->
        <native name="uuid" x:override="remove"/>
        <native name="rand" realName="random" x:override="merge"/>
        <native name="instr" realName="strpos" x:override="merge"/>

        <native name="current_date" hasParenthesis="false" x:override="merge"/>
        <native name="current_timestamp" hasParenthesis="false" x:override="merge"/>

        <template name="year" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(YEAR from {0})</source>
        </template>

        <!-- WI5 Phase 3: EXTRACT 逐字段目标函数的 PG 覆盖（PG 无 month(d) 函数形态，
             统一走原生 EXTRACT；duckdb/postgis 经继承获得——DuckDB/PG 原生支持 EXTRACT）。 -->
        <template name="month" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(month from {0})</source>
        </template>

        <template name="day" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(day from {0})</source>
        </template>

        <template name="hour" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(hour from {0})</source>
        </template>

        <template name="minute" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(minute from {0})</source>
        </template>

        <template name="second" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(second from {0})</source>
        </template>

        <template name="quarter" returnType="INTEGER" argTypes="TIMESTAMP" x:override="merge">
            <source>extract(quarter from {0})</source>
        </template>

        <!-- WI3 第 9 项：注册 ilike 函数（PG 原生 ILIKE 算子——"The key word ILIKE can be
             used instead of LIKE to make the match case-insensitive"。default 继承的
             supportILike="false" 标志不动：缺的是函数表注册，不是标志翻转，翻标志会引入
             假阴性。duckdb 经 extends postgresql 传递获得）。 -->
        <template name="ilike" argTypes="VARCHAR,VARCHAR" returnType="BOOLEAN">
            <source>{0} ilike {1}</source>
        </template>
        <!-- WI5 Phase 4: TRIM 带 chars 形态模板（{0}=str, {1}=chars；无模板方言编译期
             ERR_EQL_UNKNOWN_FUNCTION 响亮报错，禁止静默丢 chars/降级单参）。PG 15 TRIM([LEADING|TRAILING|BOTH] [characters] FROM string)。postgis 继承。 -->
        <template name="trimChars" argTypes="VARCHAR,VARCHAR" returnType="VARCHAR">
            <source>TRIM(BOTH {1} FROM {0})</source>
        </template>

        <template name="ltrimChars" argTypes="VARCHAR,VARCHAR" returnType="VARCHAR">
            <source>TRIM(LEADING {1} FROM {0})</source>
        </template>

        <template name="rtrimChars" argTypes="VARCHAR,VARCHAR" returnType="VARCHAR">
            <source>TRIM(TRAILING {1} FROM {0})</source>
        </template>

        <!-- WI6 Phase 1: lastDay(d) 归一化（返回 d 所在月份最后一天的日期值）。PG 无原生
             LAST_DAY，用 date_trunc 精确算术（Phase 0 裁定 §6；duckdb/postgis 经 extends
             postgresql 继承——pg 模板形态在 DuckDB scratch 实测通过）。
             ⚠️ 输入类型域钉死 DATE/TIMESTAMP（无时区）：date_trunc 对 timestamptz 按会话
             TimeZone 截断（时变），原生 LAST_DAY 族无此时变——owner doc 差异行。 -->
        <template name="lastday" returnType="DATE" argTypes="TIMESTAMP">
            <source>CAST(date_trunc('month', {0}) + INTERVAL '1 month' - INTERVAL '1 day' AS DATE)</source>
        </template>

        <!-- WI6 Phase 2: weekofyear(d) → ISO-8601 周号。PG EXTRACT(WEEK) = "The number of
             the ISO 8601 week-numbering week of the year"（15 文档）；duckdb/postgis 继承
             （DuckDB extract(week) 同为 ISO）。 -->
        <template name="weekofyear" returnType="INTEGER" argTypes="TIMESTAMP">
            <source>extract(week from {0})</source>
        </template>

        <!-- WI6 Phase 3: dayofweek(d) → ISO-8601 计法。PG EXTRACT(ISODOW) = "The day of the
             week as Monday (1) to Sunday (7)... matches the ISO 8601 day of the week
             numbering"（15 文档）；duckdb/postgis 继承（DuckDB isodow 同值域）。 -->
        <template name="dayofweek" returnType="INTEGER" argTypes="TIMESTAMP">
            <source>extract(isodow from {0})</source>
        </template>

        <!-- WI6 Phase 4: dateTrunc(unit, d)（unit=字符串字面量）。PG date_trunc(text,
             timestamp)，示例 date_trunc('hour', ...)——引号字符串单位、unit 在前与归一化序
             一致（15 文档）。duckdb/postgis 继承（DuckDB date_trunc(part, ...) 同序同形，
             scratch 实测通过）。规范单位词表 = pg/duckdb/h2 交集：
             year/quarter/month/week/day/hour/minute/second（pg 另有 decade/century/
             millennium/millisecond 等超集词，不在规范词表）。mysql/oracle/mssql 不落
             （Phase 0 裁定 §7）——编译期 ERR_EQL_UNKNOWN_FUNCTION 响亮。 -->
        <template name="datetrunc" returnType="TIMESTAMP" argTypes="VARCHAR,TIMESTAMP">
            <source>date_trunc({0},{1})</source>
        </template>
    </functions>

</dialect>
