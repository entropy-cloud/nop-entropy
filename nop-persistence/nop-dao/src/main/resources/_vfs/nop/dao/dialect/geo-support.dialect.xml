<!--

以下数据库具有GIS支持：
PostgresSQL， Oracle 10g/11g，MySQL，SQLServer，H2GIS，DB2，CockroachDB
-->
<dialect x:schema="/nop/schema/orm/dialect.xdef"
         xmlns:x="/nop/schema/xdsl.xdef"
>
    <geometryTypeHandler>io.nop.orm.geo.type.GeometryTypeHandler</geometryTypeHandler>

    <functions>
        <!-- geo 函数的 testSql 使用 ST_GeomFromText 构造合法几何字面量。
             默认 getSqlTestData(GEOMETRY) 返回 "3" 是无效几何数据。 -->
        <native name="st_dimension" returnType="INTEGER" argTypes="GEOMETRY">
            <testSql>ST_Dimension(ST_GeomFromText('LINESTRING(0 0,1 1)'))</testSql>
        </native>

        <native name="st_geometrytype" returnType="VARCHAR" argTypes="GEOMETRY">
            <testSql>ST_GeometryType(ST_GeomFromText('POINT(1 2)'))</testSql>
        </native>

        <native name="st_srid" returnType="INTEGER" argTypes="GEOMETRY">
            <testSql>ST_SRID(ST_GeomFromText('POINT(1 2)',4326))</testSql>
        </native>

        <native name="st_envelope" returnType="GEOMETRY" argTypes="GEOMETRY">
            <testSql>ST_Envelope(ST_GeomFromText('LINESTRING(0 0,1 1)'))</testSql>
        </native>

        <native name="st_astext" returnType="VARCHAR" argTypes="GEOMETRY">
            <testSql>ST_AsText(ST_GeomFromText('POINT(1 2)'))</testSql>
        </native>

        <native name="st_asbinary" returnType="VARBINARY" argTypes="GEOMETRY">
            <testSql>ST_AsBinary(ST_GeomFromText('POINT(1 2)'))</testSql>
        </native>

        <native name="st_isempty" returnType="BOOLEAN" argTypes="GEOMETRY">
            <testSql>ST_IsEmpty(ST_GeomFromText('POINT(1 2)'))</testSql>
        </native>

        <native name="st_issimple" returnType="BOOLEAN" argTypes="GEOMETRY">
            <testSql>ST_IsSimple(ST_GeomFromText('LINESTRING(0 0,1 1)'))</testSql>
        </native>

        <native name="st_boundary" returnType="GEOMETRY" argTypes="GEOMETRY">
            <testSql>ST_Boundary(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'))</testSql>
        </native>


        <native name="st_equals" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Equals(ST_GeomFromText('POINT(1 2)'),ST_GeomFromText('POINT(1 2)'))</testSql>
        </native>

        <native name="st_disjoint" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Disjoint(ST_GeomFromText('POINT(1 2)'),ST_GeomFromText('POINT(3 4)'))</testSql>
        </native>

        <native name="st_intersects" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Intersects(ST_GeomFromText('LINESTRING(0 0,1 1)'),ST_GeomFromText('LINESTRING(0 1,1 0)'))</testSql>
        </native>

        <native name="st_touches" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Touches(ST_GeomFromText('POLYGON((0 0,1 0,1 1,0 1,0 0))'),ST_GeomFromText('POINT(1 1)'))</testSql>
        </native>

        <native name="st_crosses" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Crosses(ST_GeomFromText('LINESTRING(0 0,2 2)'),ST_GeomFromText('LINESTRING(0 2,2 0)'))</testSql>
        </native>

        <native name="st_within" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Within(ST_GeomFromText('POINT(1 1)'),ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'))</testSql>
        </native>

        <native name="st_contains" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Contains(ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),ST_GeomFromText('POINT(1 1)'))</testSql>
        </native>

        <native name="st_overlaps" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Overlaps(ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),ST_GeomFromText('POLYGON((1 1,3 1,3 3,1 3,1 1))'))</testSql>
        </native>

        <native name="st_distance" returnType="DOUBLE" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Distance(ST_GeomFromText('POINT(0 0)'),ST_GeomFromText('POINT(1 1)'))</testSql>
        </native>

        <native name="st_buffer" returnType="GEOMETRY" argTypes="GEOMETRY,DOUBLE">
            <testSql>ST_Buffer(ST_GeomFromText('POINT(0 0)'),1.0)</testSql>
        </native>

        <native name="st_convexhull" returnType="GEOMETRY" argTypes="GEOMETRY">
            <testSql>ST_ConvexHull(ST_GeomFromText('MULTIPOINT(0 0,1 0,0 1)'))</testSql>
        </native>

        <native name="st_intersection" returnType="GEOMETRY" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Intersection(ST_GeomFromText('LINESTRING(0 0,2 2)'),ST_GeomFromText('LINESTRING(0 2,2 0)'))</testSql>
        </native>

        <native name="st_geomunion" returnType="GEOMETRY" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Union(ST_GeomFromText('POINT(0 0)'),ST_GeomFromText('POINT(1 1)'))</testSql>
        </native>

        <native name="st_difference" returnType="GEOMETRY" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_Difference(ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),ST_GeomFromText('POLYGON((1 1,3 1,3 3,1 3,1 1))'))</testSql>
        </native>

        <native name="st_symdifference" returnType="GEOMETRY" argTypes="GEOMETRY,GEOMETRY">
            <testSql>ST_SymDifference(ST_GeomFromText('POLYGON((0 0,2 0,2 2,0 2,0 0))'),ST_GeomFromText('POLYGON((1 1,3 1,3 3,1 3,1 1))'))</testSql>
        </native>


        <native name="st_dwithin" returnType="BOOLEAN" argTypes="GEOMETRY,GEOMETRY,DOUBLE">
            <description>Returns true if the geometries are within the specified distance of one another</description>
            <testSql>ST_DWithin(ST_GeomFromText('POINT(0 0)'),ST_GeomFromText('POINT(1 1)'),2.0)</testSql>
        </native>

        <native name="st_transform" returnType="GEOMETRY" argTypes="GEOMETRY,INTEGER">
            <description>Returns a new geometry with its coordinates transformed to
                the SRID referenced by the integer parameter
            </description>
            <testSql>ST_Transform(ST_GeomFromText('POINT(0 0)',4326),3857)</testSql>
        </native>

        <native name="st_extent" returnType="GEOMETRY" argTypes="GEOMETRY">
            <description>Returns a bounding box that bounds the set of returned geometries</description>
            <testSql>ST_Extent(ST_GeomFromText('POINT(1 2)'))</testSql>
        </native>

    </functions>
</dialect>