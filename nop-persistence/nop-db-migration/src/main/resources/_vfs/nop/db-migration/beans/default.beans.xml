<?xml version="1.0" encoding="UTF-8" ?>

<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd"
       xmlns:ioc="ioc">

    <!-- Migration Engine -->
    <bean id="nopMigrationEngine" class="io.nop.db.migration.core.MigrationEngine" ioc:auto-inject="true">
    </bean>

    <!-- Migration File Scanner -->
    <bean id="nopMigrationFileScanner" class="io.nop.db.migration.core.MigrationFileScanner">
    </bean>

    <!-- Migration Executor -->
    <bean id="nopMigrationExecutor" class="io.nop.db.migration.core.MigrationExecutor" ioc:auto-inject="true">
        <property name="executors">
            <ioc:map keyType="java.lang.String" valueType="io.nop.db.migration.executor.IChangeExecutor">
                <entry key="createTable" value-ref="nopCreateTableExecutor"/>
                <entry key="dropTable" value-ref="nopDropTableExecutor"/>
                <entry key="renameTable" value-ref="nopRenameTableExecutor"/>
                <entry key="addColumn" value-ref="nopAddColumnExecutor"/>
                <entry key="dropColumn" value-ref="nopDropColumnExecutor"/>
                <entry key="alterColumn" value-ref="nopAlterColumnExecutor"/>
                <entry key="createIndex" value-ref="nopCreateIndexExecutor"/>
                <entry key="dropIndex" value-ref="nopDropIndexExecutor"/>
                <entry key="createView" value-ref="nopCreateViewExecutor"/>
                <entry key="dropView" value-ref="nopDropViewExecutor"/>
                <entry key="sql" value-ref="nopSqlExecutor"/>
                <entry key="insertData" value-ref="nopInsertDataExecutor"/>
                <entry key="updateData" value-ref="nopUpdateDataExecutor"/>
                <entry key="deleteData" value-ref="nopDeleteDataExecutor"/>
                <entry key="customChange" value-ref="nopCustomChangeExecutor"/>
                <entry key="dbTypeFilter" value-ref="nopDbTypeFilterExecutor"/>
            </ioc:map>
        </property>
    </bean>

    <!-- dbTypeFilter dispatches nested changes through its own executor table,
         which must mirror nopMigrationExecutor's map -->
    <bean id="nopDbTypeFilterExecutor" class="io.nop.db.migration.executor.DbTypeFilterExecutor">
        <property name="executors">
            <ioc:map keyType="java.lang.String" valueType="io.nop.db.migration.executor.IChangeExecutor">
                <entry key="createTable" value-ref="nopCreateTableExecutor"/>
                <entry key="dropTable" value-ref="nopDropTableExecutor"/>
                <entry key="renameTable" value-ref="nopRenameTableExecutor"/>
                <entry key="addColumn" value-ref="nopAddColumnExecutor"/>
                <entry key="dropColumn" value-ref="nopDropColumnExecutor"/>
                <entry key="alterColumn" value-ref="nopAlterColumnExecutor"/>
                <entry key="createIndex" value-ref="nopCreateIndexExecutor"/>
                <entry key="dropIndex" value-ref="nopDropIndexExecutor"/>
                <entry key="createView" value-ref="nopCreateViewExecutor"/>
                <entry key="dropView" value-ref="nopDropViewExecutor"/>
                <entry key="sql" value-ref="nopSqlExecutor"/>
                <entry key="insertData" value-ref="nopInsertDataExecutor"/>
                <entry key="updateData" value-ref="nopUpdateDataExecutor"/>
                <entry key="deleteData" value-ref="nopDeleteDataExecutor"/>
                <entry key="customChange" value-ref="nopCustomChangeExecutor"/>
            </ioc:map>
        </property>
    </bean>

    <!-- Change Executors -->
    <bean id="nopSqlExecutor" class="io.nop.db.migration.executor.SqlExecutor"/>
    <bean id="nopCreateTableExecutor" class="io.nop.db.migration.executor.CreateTableExecutor" ioc:auto-inject="true"/>
    <bean id="nopDropTableExecutor" class="io.nop.db.migration.executor.DropTableExecutor" ioc:auto-inject="true"/>
    <bean id="nopRenameTableExecutor" class="io.nop.db.migration.executor.RenameTableExecutor" ioc:auto-inject="true"/>
    <bean id="nopAddColumnExecutor" class="io.nop.db.migration.executor.AddColumnExecutor" ioc:auto-inject="true"/>
    <bean id="nopDropColumnExecutor" class="io.nop.db.migration.executor.DropColumnExecutor" ioc:auto-inject="true"/>
    <bean id="nopAlterColumnExecutor" class="io.nop.db.migration.executor.AlterColumnExecutor" ioc:auto-inject="true"/>
    <bean id="nopCreateIndexExecutor" class="io.nop.db.migration.executor.CreateIndexExecutor" ioc:auto-inject="true"/>
    <bean id="nopDropIndexExecutor" class="io.nop.db.migration.executor.DropIndexExecutor" ioc:auto-inject="true"/>
    <bean id="nopCreateViewExecutor" class="io.nop.db.migration.executor.CreateViewExecutor" ioc:auto-inject="true"/>
    <bean id="nopDropViewExecutor" class="io.nop.db.migration.executor.DropViewExecutor" ioc:auto-inject="true"/>
    <bean id="nopInsertDataExecutor" class="io.nop.db.migration.executor.InsertDataExecutor" ioc:auto-inject="true"/>
    <bean id="nopUpdateDataExecutor" class="io.nop.db.migration.executor.UpdateDataExecutor" ioc:auto-inject="true"/>
    <bean id="nopDeleteDataExecutor" class="io.nop.db.migration.executor.DeleteDataExecutor" ioc:auto-inject="true"/>
    <bean id="nopCustomChangeExecutor" class="io.nop.db.migration.executor.CustomChangeExecutor" ioc:auto-inject="true"/>
</beans>
