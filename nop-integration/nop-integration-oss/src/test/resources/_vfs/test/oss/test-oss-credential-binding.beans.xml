<?xml version="1.0" encoding="UTF-8" ?>
<!-- W16-impl-ext 测试夹具：复刻生产 oss-defaults.beans.xml 的 ioc:config-prefix 绑定形态
     （nop.integration.oss.* → OssConfig），装配 fake provider 与工厂 bean（enabled 门控行为由
     真实 oss-defaults.beans.xml 的容器装载用例覆盖，本夹具专注于配置键绑定 + 构造期消费）。 -->
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd" xmlns:ioc="ioc">

    <bean id="nopOssConfig" class="io.nop.integration.oss.OssConfig" ioc:config-prefix="nop.integration.oss"/>

    <bean id="testCredentialProvider"
          class="io.nop.integration.oss.TestOssConfigCredentialBinding$FakeProvider"/>

    <bean id="nopOssFileServiceClientFactory"
          class="io.nop.integration.oss.OssFileServiceClientFactory">
        <property name="ossConfig" ref="nopOssConfig"/>
    </bean>
</beans>
