<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns:x="/nop/schema/xdsl.xdef" x:schema="/nop/schema/beans.xdef" xmlns:ioc="ioc">
    <!-- prototype + ioc:init xpl：prototype 的 beanScope 为 null。
         修复前：runXpl 对 null scope 直接解引用 getEvalScope() 抛 NPE；
         修复后回退独立 scope，xpl 正常执行。 -->
    <bean id="myPrototypeXplBean" class="test.io.entropy.beans.MyPrototypeXplBean" scope="prototype" lazy-init="true">
        <ioc:init>
            this.markInitialized();
        </ioc:init>
    </bean>
</beans>
