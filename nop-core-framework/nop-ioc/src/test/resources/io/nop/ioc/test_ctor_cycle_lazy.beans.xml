<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns:x="/nop/schema/xdsl.xdef" x:schema="/nop/schema/beans.xdef">
    <!-- 构造器循环依赖（懒加载变体）：运行期首次 getBean 触发环检测 -->
    <bean id="beanA" class="test.io.entropy.beans.TestCtorCycleA" lazy-init="true">
        <constructor-arg index="0">
            <ref bean="beanB"/>
        </constructor-arg>
    </bean>

    <bean id="beanB" class="test.io.entropy.beans.TestCtorCycleB" lazy-init="true">
        <property name="a">
            <ref bean="beanA"/>
        </property>
    </bean>
</beans>
