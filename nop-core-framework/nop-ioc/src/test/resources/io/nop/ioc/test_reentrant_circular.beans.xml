<?xml version="1.0" encoding="UTF-8" ?>
<beans x:schema="/nop/schema/beans.xdef" xmlns:x="/nop/schema/xdsl.xdef"
       xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

    <!-- TEMP-DIAG: 递归环复现。beanA(force-init) -> ref beanB；beanB -> ref beanA（环）+ depends-on beanA（显式 resolvedDepends） -->
    <bean id="beanA" class="test.io.entropy.beans.TestCircularA" ioc:force-init="true">
        <property name="b" ref="beanB"/>
    </bean>

    <bean id="beanB" class="test.io.entropy.beans.TestCircularB" depends-on="beanA">
        <property name="a" ref="beanA" ioc:lazy-property="true"/>
    </bean>
</beans>
