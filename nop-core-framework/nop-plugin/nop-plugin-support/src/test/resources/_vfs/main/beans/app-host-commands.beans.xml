<?xml version="1.0" encoding="UTF-8"?>
<!--
  宿主容器命令 bean fixture（/main/beans 由 AppBeanContainerLoader 装入全局容器）：
  仅注册 nopPluginCommand_host（宿主回退分支可观测）；故意不注册 nopPluginCommand_default——
  本 JVM 保留"回退链终点 miss → getBean 显式抛异常"分支的可观测性。
-->
<beans xmlns:x="/nop/schema/xdsl.xdef" x:schema="/nop/schema/beans.xdef">
    <bean id="nopPluginCommand_host" class="io.nop.plugin.support.TestHostCommand"/>
</beans>
